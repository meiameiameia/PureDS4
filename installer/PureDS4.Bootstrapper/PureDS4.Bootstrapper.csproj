<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>PureDS4.Bootstrapper</AssemblyName>
    <RootNamespace>PureDS4.Bootstrapper</RootNamespace>
    <ApplicationIcon>..\..\PureDS4\DS4W.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PureDS4ExperimentalDS3 Condition="'$(PureDS4ExperimentalDS3)' == ''">false</PureDS4ExperimentalDS3>
  </PropertyGroup>

  <!-- The installer UI must match the payload it installs. Without this the
       DS3 opt-in would be hidden in an experimental installer, or offered by a
       standard one. -->
  <PropertyGroup Condition="'$(PureDS4ExperimentalDS3)' == 'true'">
    <DefineConstants>$(DefineConstants);PUREDS4_EXPERIMENTAL_DS3</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplicationApi" Version="5.0.2" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\PureDS4\ThirdParty\DotNet-LICENSE.txt" LogicalName="PureDS4.Terms.DotNet-LICENSE.txt" />
    <EmbeddedResource Include="..\..\PureDS4\ThirdParty\WindowsSdk-LICENSE.rtf" LogicalName="PureDS4.Terms.WindowsSdk-LICENSE.rtf" />
    <EmbeddedResource Include="..\..\COPYING" LogicalName="PureDS4.Terms.COPYING" />
    <Resource Include="..\..\PureDS4\DS4W.ico" Link="DS4W.ico" />
    <!-- The .ico stores every frame as PNG, which the WPF ICO decoder
         renders poorly at display sizes. Ship the real PNG for on-screen
         use and keep the .ico for the window and shell icon. -->
    <Resource Include="..\..\PureDS4\Resources\AppIcon.png" Link="AppIcon.png" />
  </ItemGroup>
</Project>
