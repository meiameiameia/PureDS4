<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <Platform>x64</Platform>
    <BundleVersion Condition="'$(BundleVersion)' == ''">5.1.1</BundleVersion>
    <DisplayVersion Condition="'$(DisplayVersion)' == ''">$(BundleVersion)</DisplayVersion>
    <ExperimentalDS3 Condition="'$(ExperimentalDS3)' == ''">false</ExperimentalDS3>
    <!-- A DualShock 3 hardware-validation bundle is a distinct product with
         its own upgrade code, so Burn can never treat it as an upgrade of,
         or be upgraded by, a real PureDS4 bundle. -->
    <BundleProductName Condition="'$(ExperimentalDS3)' != 'true'">PureDS4</BundleProductName>
    <BundleProductName Condition="'$(ExperimentalDS3)' == 'true'">PureDS4 DS3 Experimental</BundleProductName>
    <BundleUpgradeCode Condition="'$(ExperimentalDS3)' != 'true'">E0DC119F-B6A6-4425-8FEB-FAA6232FE346</BundleUpgradeCode>
    <BundleUpgradeCode Condition="'$(ExperimentalDS3)' == 'true'">1172A8DC-DDFC-4AEA-A1FC-B2EB3B0E8F15</BundleUpgradeCode>
    <!-- DisplayVersion already carries -ds3experimental for an experimental
         build, so the file name is distinctive without a second suffix. -->
    <OutputName>PureDS4_$(DisplayVersion)_Setup_x64</OutputName>
    <MsiPath Condition="'$(MsiPath)' == ''">$(MSBuildThisFileDirectory)..\PureDS4.Package\bin\x64\Release\PureDS4_5.1.1_x64.msi</MsiPath>
    <BootstrapperRoot Condition="'$(BootstrapperRoot)' == ''">$(MSBuildThisFileDirectory)..\PureDS4.Bootstrapper\bin\x64\Release\net48\win-x64</BootstrapperRoot>
    <SetupActionsPath Condition="'$(SetupActionsPath)' == ''">$(MSBuildThisFileDirectory)..\PureDS4.SetupActions\bin\x64\Release\net48\PureDS4.SetupActions.exe</SetupActionsPath>
    <ExtrasRoot Condition="'$(ExtrasRoot)' == ''">$(MSBuildThisFileDirectory)..\..\extras</ExtrasRoot>
    <DefineConstants>BundleVersion=$(BundleVersion);DisplayVersion=$(DisplayVersion);MsiPath=$(MsiPath);BootstrapperRoot=$(BootstrapperRoot);SetupActionsPath=$(SetupActionsPath);SetupActionsHash=$(SetupActionsHash);ExtrasRoot=$(ExtrasRoot);BundleProductName=$(BundleProductName);BundleUpgradeCode=$(BundleUpgradeCode)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
  <Target Name="RequireContentAddressedSetupHelper" BeforeTargets="Build">
    <Error Condition="'$(SetupActionsHash)' == '' Or !$([System.Text.RegularExpressions.Regex]::IsMatch($(SetupActionsHash), '^[0-9A-Fa-f]{64}$'))"
           Text="A 64-character SetupActionsHash is required; build this bundle through installer/build-installer.ps1." />
  </Target>
</Project>
