<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <Platform>x64</Platform>
    <BundleVersion Condition="'$(BundleVersion)' == ''">5.1.0-beta.1</BundleVersion>
    <DisplayVersion Condition="'$(DisplayVersion)' == ''">$(BundleVersion)</DisplayVersion>
    <OutputName>PureDS4_$(DisplayVersion)_Setup_x64</OutputName>
    <MsiPath Condition="'$(MsiPath)' == ''">$(MSBuildThisFileDirectory)..\PureDS4.Package\bin\x64\Release\PureDS4_5.1.0_x64.msi</MsiPath>
    <BootstrapperRoot Condition="'$(BootstrapperRoot)' == ''">$(MSBuildThisFileDirectory)..\PureDS4.Bootstrapper\bin\x64\Release\net48\win-x64</BootstrapperRoot>
    <SetupActionsPath Condition="'$(SetupActionsPath)' == ''">$(MSBuildThisFileDirectory)..\PureDS4.SetupActions\bin\x64\Release\net48\PureDS4.SetupActions.exe</SetupActionsPath>
    <ExtrasRoot Condition="'$(ExtrasRoot)' == ''">$(MSBuildThisFileDirectory)..\..\extras</ExtrasRoot>
    <DefineConstants>BundleVersion=$(BundleVersion);DisplayVersion=$(DisplayVersion);MsiPath=$(MsiPath);BootstrapperRoot=$(BootstrapperRoot);SetupActionsPath=$(SetupActionsPath);SetupActionsHash=$(SetupActionsHash);ExtrasRoot=$(ExtrasRoot)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
  <Target Name="RequireContentAddressedSetupHelper" BeforeTargets="Build">
    <Error Condition="'$(SetupActionsHash)' == '' Or !$([System.Text.RegularExpressions.Regex]::IsMatch($(SetupActionsHash), '^[0-9A-Fa-f]{64}$'))"
           Text="A 64-character SetupActionsHash is required; build this bundle through installer/build-installer.ps1." />
  </Target>
</Project>
