<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle
      Name="PureDS4"
      Manufacturer="meiameiameia"
      Version="$(var.BundleVersion)"
      UpgradeCode="E0DC119F-B6A6-4425-8FEB-FAA6232FE346"
      Tag="PureDS4ManagedV1"
      IconSourceFile="$(var.ExtrasRoot)\..\PureDS4\DS4W.ico"
      Compressed="yes"
      AboutUrl="https://github.com/meiameiameia/pureds4"
      HelpUrl="https://github.com/meiameiameia/pureds4/issues">

    <BootstrapperApplication SourceFile="$(var.BootstrapperRoot)\PureDS4.Bootstrapper.exe" />

    <Variable Name="CreateDesktopShortcut" Type="numeric" Value="1" />
    <Variable Name="InstallHidHide" Type="numeric" Value="1" />
    <Variable Name="InstallFakerInput" Type="numeric" Value="0" />
    <Variable Name="SetupCorrelationId" Type="string" Value="" Persisted="yes" />
    <Variable Name="TargetUserSid" Type="string" Value="" Persisted="yes" />
    <Variable Name="TargetUserName" Type="string" Value="" Persisted="yes" />
    <Variable Name="TargetLocalAppData" Type="string" Value="" Persisted="yes" />
    <Variable Name="TargetRoamingAppData" Type="string" Value="" Persisted="yes" />

    <util:RegistrySearch
        Id="InfrastructureMarkerSearch"
        Variable="InfrastructureInstalled"
        Root="HKLM"
        Key="SOFTWARE\PureDS4"
        Value="InfrastructureVersion"
        Result="value"
        Bitness="always64" />
    <util:RegistrySearch
        Id="ManagedInstallRegistrationSearch"
        Variable="ManagedInstallRegistered"
        Root="HKLM"
        Key="SOFTWARE\PureDS4"
        Value="InstallPath"
        Result="exists"
        Bitness="always64" />
    <util:FileSearch
        Id="ManagedViiperExecutableSearch"
        Variable="ManagedViiperPresent"
        Path="[ProgramFiles64Folder]PureDS4\VIIPER\viiper.exe"
        Result="exists" />
    <util:RegistrySearch
        Id="HidHideSearch"
        Variable="HidHideInstalled"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{01E0AB21-D1CC-42B4-9DFF-84FFE4F26DAF}"
        Value="DisplayVersion"
        Result="value"
        Bitness="always64" />

    <!-- Burn's restore-point creation can block indefinitely when Windows
         System Protection/WMI is unhealthy. MSI rollback already protects the
         application transaction, and the driver helper owns its own guarded
         rollback/reboot contract, so never hold the elevated engine here. -->
    <Chain DisableSystemRestore="yes">
      <!-- This package is first so Burn executes it last while unwinding a
           direct uninstall, after MSI has removed every owned file. It only
           removes empty directories and therefore preserves any unrecognized
           user or third-party content left under the install root. -->
      <ExePackage
          Id="PostUninstallCleanup"
          CacheId="PureDS4SetupActionsPostUninstall-$(var.SetupActionsHash)"
          Name="PureDS4.SetupActions.PostUninstall.exe"
          SourceFile="$(var.SetupActionsPath)"
          PerMachine="yes"
          Permanent="yes"
          Vital="yes"
          DetectCondition="0"
          InstallArguments="postuninstall --correlation-id &quot;[SetupCorrelationId]&quot; --install-root &quot;[ProgramFiles64Folder]PureDS4&quot;">
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Behavior="error" />
      </ExePackage>

      <ExePackage
          Id="CloseRunningApplications"
          CacheId="PureDS4SetupActionsPreflight-$(var.SetupActionsHash)"
          Name="PureDS4.SetupActions.Preflight.exe"
          SourceFile="$(var.SetupActionsPath)"
          PerMachine="yes"
          Permanent="yes"
          Vital="yes"
          DetectCondition="0"
          InstallArguments="preflight --correlation-id &quot;[SetupCorrelationId]&quot;">
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Behavior="error" />
      </ExePackage>

      <MsiPackage
          Id="PureDS4Msi"
          SourceFile="$(var.MsiPath)"
          Visible="no"
          Vital="yes" />

      <ExePackage
          Id="ViiperUsbipSetup"
          CacheId="PureDS4SetupActionsInfrastructure-$(var.SetupActionsHash)"
          SourceFile="$(var.SetupActionsPath)"
          PerMachine="yes"
          Permanent="yes"
          Vital="yes"
          DetectCondition="InfrastructureInstalled = &quot;VIIPER-0.1.0+USBIP-0.9.7.7&quot; OR ManagedInstallRegistered OR ManagedViiperPresent"
          InstallArguments="install --correlation-id &quot;[SetupCorrelationId]&quot; --install-root &quot;[ProgramFiles64Folder]PureDS4&quot; --bundle-source &quot;[WixBundleOriginalSource]&quot; --desktop-shortcut &quot;[CreateDesktopShortcut]&quot; --target-user-sid &quot;[TargetUserSid]&quot; --target-user-name &quot;[TargetUserName]&quot; --target-local-appdata &quot;[TargetLocalAppData]&quot; --target-roaming-appdata &quot;[TargetRoamingAppData]&quot;"
          RepairArguments="repair --correlation-id &quot;[SetupCorrelationId]&quot; --install-root &quot;[ProgramFiles64Folder]PureDS4&quot; --bundle-source &quot;[WixBundleOriginalSource]&quot; --desktop-shortcut &quot;[CreateDesktopShortcut]&quot; --target-user-sid &quot;[TargetUserSid]&quot; --target-user-name &quot;[TargetUserName]&quot; --target-local-appdata &quot;[TargetLocalAppData]&quot; --target-roaming-appdata &quot;[TargetRoamingAppData]&quot;"
          UninstallArguments="uninstall --correlation-id &quot;[SetupCorrelationId]&quot; --install-root &quot;[ProgramFiles64Folder]PureDS4&quot;">
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
        <ExitCode Behavior="error" />
      </ExePackage>

      <ExePackage
          Id="HidHide"
          SourceFile="$(var.ExtrasRoot)\HidHide_1.5.230_x64.exe"
          PerMachine="yes"
          Permanent="yes"
          Vital="no"
          DetectCondition="HidHideInstalled"
          InstallCondition="InstallHidHide"
          InstallArguments="/quiet /norestart">
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
        <ExitCode Behavior="error" />
      </ExePackage>

      <MsiPackage
          Id="FakerInput"
          SourceFile="$(var.ExtrasRoot)\FakerInput_0.1.0_x64.msi"
          Permanent="yes"
          Vital="no"
          InstallCondition="InstallFakerInput"
          Visible="no" />

      <!-- VIIPER/USB-IP is shared machine infrastructure. Keep the normal
           setup package permanent so an outgoing related bundle cannot tear
           down the incoming version or retain its own Burn registration.
           A direct uninstall explicitly plans this one-shot action instead. -->
      <ExePackage
          Id="ViiperUsbipUninstall"
          CacheId="PureDS4SetupActionsInfrastructureUninstall-$(var.SetupActionsHash)"
          Name="PureDS4.SetupActions.InfrastructureUninstall.exe"
          SourceFile="$(var.SetupActionsPath)"
          PerMachine="yes"
          Permanent="yes"
          Vital="yes"
          DetectCondition="0"
          InstallArguments="uninstall --correlation-id &quot;[SetupCorrelationId]&quot; --install-root &quot;[ProgramFiles64Folder]PureDS4&quot;">
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
        <ExitCode Behavior="error" />
      </ExePackage>

      <!-- Burn removes packages in reverse chain order. Keep a second,
           install-only invocation of the verified preflight helper at the
           tail so uninstall quiesces PureDS4 and VIIPER before any owned
           package is removed. The BA plans exactly one of the two preflights. -->
      <ExePackage
          Id="CloseRunningApplicationsForUninstall"
          CacheId="PureDS4SetupActionsUninstallPreflight-$(var.SetupActionsHash)"
          Name="PureDS4.SetupActions.UninstallPreflight.exe"
          SourceFile="$(var.SetupActionsPath)"
          PerMachine="yes"
          Permanent="yes"
          Vital="yes"
          DetectCondition="0"
          InstallArguments="preflight --correlation-id &quot;[SetupCorrelationId]&quot;">
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Behavior="error" />
      </ExePackage>
    </Chain>
  </Bundle>
</Wix>
