<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="PureDS4"
      Manufacturer="meiameiameia"
      Version="$(var.ProductVersion)"
      UpgradeCode="FE00C21E-C0E6-4509-81EA-2D4B34D377A1"
      Scope="perMachine"
      InstallerVersion="500"
      Compressed="yes">
    <SummaryInformation Description="PureDS4 controller mapping and virtual game output" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of PureDS4 is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Point at the icon file, not the executable. WiX embeds the whole
         SourceFile as the Icon stream, so using the single-file
         PureDS4.exe here put a second 182 MB copy of the application
         inside the MSI purely to supply an Add/Remove Programs icon. -->
    <Icon Id="PureDS4Icon" SourceFile="$(var.RepoRoot)DS4Windows\DS4W.ico" />
    <Property Id="ARPPRODUCTICON" Value="PureDS4Icon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/meiameiameia/pureds4/issues" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/meiameiameia/pureds4" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="PureDS4" />
    </StandardDirectory>

    <Component Id="ManagedInstallRegistration" Directory="INSTALLFOLDER" Guid="EFF37CF6-5757-46CF-8180-6AC595300073">
      <RegistryValue Root="HKLM" Key="Software\PureDS4" Name="InstallPath" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\PureDS4" Name="Version" Value="[ProductVersion]" Type="string" />
    </Component>

    <Feature Id="MainFeature" Title="PureDS4" Level="1">
      <ComponentGroupRef Id="PublishedFiles" />
      <ComponentRef Id="ManagedInstallRegistration" />
    </Feature>
  </Package>
</Wix>
