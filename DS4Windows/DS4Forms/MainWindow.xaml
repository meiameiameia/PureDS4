<Window x:Name="mainDS4Window" x:Class="DS4WinWPF.DS4Forms.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:LocalizeDictionary.DesignCulture=""
        lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
        xmlns:localConverters="clr-namespace:DS4WinWPF.DS4Forms.Converters"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xml:lang="en-US"
        mc:Ignorable="d"
        Title="DS4Windows" Height="660" Width="1024" Closing="MainDS4Window_Closing" Closed="MainDS4Window_Closed" StateChanged="MainDS4Window_StateChanged" SizeChanged="MainDS4Window_SizeChanged" LocationChanged="MainDS4Window_LocationChanged" MinWidth="720" MinHeight="480"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Style="{DynamicResource WindowStyle}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:ImageLocationPaths x:Key="ImgLocPaths" />
    </Window.Resources>
    <DockPanel>
        <tb:TaskbarIcon x:Name="notifyIcon" IconSource="{Binding IconSource,Mode=OneWay}" ToolTipText="{Binding TooltipText,Mode=OneWay}" MenuActivation="RightClick" TrayRightMouseUp="NotifyIcon_TrayRightMouseUp" TrayMiddleMouseDown="NotifyIcon_TrayMiddleMouseDown" TrayMouseDoubleClick="NotifyIcon_TrayMouseDoubleClick">
            <!--<tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open" />
                    <Separator />
                    <MenuItem x:Name="exitMenuItem" Header="Exit" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>-->
        </tb:TaskbarIcon>

        <StackPanel DockPanel.Dock="Bottom" Height="30" VerticalAlignment="Bottom" Background="{DynamicResource SidebarBackgroundColor}">
            <DockPanel Height="30" Margin="8,0,8,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="StartStopBtn" Content="{lex:Loc StartText}" Margin="8,3,0,3" Click="StartStopBtn_Click" MinWidth="52" Height="24"
                            Style="{StaticResource BridgeSecondaryButtonStyle}" Padding="8,1" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Controller: " Foreground="{DynamicResource MutedForegroundColor}" />
                    <TextBlock Text="{Binding SelectedControllerConnection}" Foreground="{DynamicResource MutedForegroundColor}" />
                    <TextBlock Text="  ·  Profile: " Foreground="{DynamicResource MutedForegroundColor}" />
                    <TextBlock Text="{Binding CurrentProfileName}" Foreground="{DynamicResource MutedForegroundColor}"
                               TextTrimming="CharacterEllipsis" MaxWidth="160" />
                    <TextBlock Text=" · " Foreground="{DynamicResource MutedForegroundColor}" />
                    <TextBlock Text="{Binding SelectedControllerStartupTitle}" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentColor}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
        <Grid DockPanel.Dock="Top">
            <TabControl x:Name="mainTabCon" SelectedIndex="1" SelectionChanged="MainTabCon_SelectionChanged" Style="{StaticResource BridgeMainTabControlStyle}">
            <TabItem x:Name="overviewTab" Header="Quick controls" Tag="&#xE80F;" Visibility="Collapsed" Style="{StaticResource BridgeHiddenToolTabItemStyle}" IsEnabled="{Binding FullTabsEnabled,Mode=OneWay}">
                <local:ControllerOverviewControl x:Name="controllerOverviewControl"
                                                 EditProfileRequested="ControllerOverview_EditProfileRequested"
                                                 ControllerDetailsRequested="ControllerOverview_ControllerDetailsRequested"
                                                 LightbarRequested="ControllerOverview_LightbarRequested"
                                                 DisconnectRequested="ControllerOverview_DisconnectRequested" />
            </TabItem>

            <TabItem x:Name="controllersTab" Header="Home" Tag="&#xE7FC;" IsEnabled="{Binding FullTabsEnabled,Mode=OneWay}">
                <Grid Margin="12,10,12,8">
                    <Grid.Resources>
                        <Style x:Key="HomeInspectorStyle" TargetType="Border">
                            <Setter Property="Margin" Value="0,1,0,0" />
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="Background" Value="{DynamicResource RaisedBackgroundColor}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="8,0,8,4" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" MinWidth="60" />
                            <ColumnDefinition Width="1.25*" MinWidth="110" />
                            <ColumnDefinition Width="1.25*" MinWidth="115" />
                            <ColumnDefinition Width="Auto" MinWidth="78" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CONTROLLER" Style="{StaticResource BridgeColumnHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="BATTERY" Style="{StaticResource BridgeColumnHeaderStyle}" />
                        <TextBlock Grid.Column="2" Text="ACTIVE PROFILE" Style="{StaticResource BridgeColumnHeaderStyle}" />
                        <TextBlock Grid.Column="3" Text="PROTECTION" Style="{StaticResource BridgeColumnHeaderStyle}" />
                        <TextBlock Grid.Column="4" Text="ACTIONS" Style="{StaticResource BridgeColumnHeaderStyle}" />
                    </Grid>
                    <ListView x:Name="controllerLV" Grid.Row="1" ItemsSource="{Binding ControllerCol}" SelectionMode="Single"
                              SelectedIndex="{Binding CurrentIndex, Mode=OneWayToSource}" Margin="0"
                              SelectedItem="{Binding DataContext.SelectedController, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
                              ItemContainerStyle="{StaticResource BridgeControllerCardItemStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" MinHeight="56">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="180" />
                                            <ColumnDefinition Width="Auto" MinWidth="60" />
                                            <ColumnDefinition Width="1.25*" MinWidth="110" />
                                            <ColumnDefinition Width="1.25*" MinWidth="115" />
                                            <ColumnDefinition Width="Auto" MinWidth="78" />
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="52" Height="38" Margin="0,0,6,0"
                                                    Background="{DynamicResource RaisedBackgroundColor}"
                                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                                    Visibility="{Binding HasControllerArtwork, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Image Source="{Binding ControllerImageSource}" Stretch="Uniform"
                                                       Width="48" Height="34" Margin="2"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="idColumnTxtB" Text="{Binding IdText, Mode=OneWay}"
                                                           ToolTip="{Binding TooltipIDText, Mode=OneWay}"
                                                           ToolTipOpening="IdColumnTxtB_ToolTipOpening" Tag="{Binding DevIndex, Mode=OneTime}"
                                                           FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <Image x:Name="contStatusImg" Source="{Binding StatusSource}" Stretch="Uniform"
                                                           Width="14" Height="14" Margin="0,0,5,0"
                                                           ToolTip="Right click to disconnect wireless"
                                                           MouseRightButtonUp="ContStatusImg_MouseRightButtonUp" Tag="{Binding DevIndex}" />
                                                    <TextBlock Text="{Binding ConnectionText}" FontSize="11"
                                                               Foreground="{DynamicResource MutedForegroundColor}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding BatteryState, Mode=OneWay}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SuccessColor}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="2" x:Name="selectProfCombo" Style="{StaticResource BridgeProfileComboBoxStyle}"
                                                  Height="28" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                  ItemsSource="{Binding ProfileListCol}" SelectedIndex="{Binding SelectedIndex}"
                                                  Tag="{Binding DevIndex, Mode=OneTime}"
                                                  Visibility="{Binding PrimaryDevice, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  SelectionChanged="SelectProfCombo_SelectionChanged" KeyDown="SelectProfCombo_KeyDown">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name,Mode=OneWay,FallbackValue=''}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding ExclusiveSource}" Width="14" Height="14" Margin="0,0,5,0"
                                                   ToolTip="{Binding IsExclusiveText}" />
                                            <TextBlock Text="{Binding IsExclusiveText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource MutedForegroundColor}" />
                                        </StackPanel>
                                        <xctk:SplitButton Grid.Column="4" x:Name="ProfEditSBtn" Content="{lex:Loc Edit}"
                                                          MinWidth="70" Height="28" Margin="8,0,0,0"
                                                          Visibility="{Binding PrimaryDevice, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                          Tag="{Binding DevIndex, Mode=OneTime}" Click="ProfEditSBtn_Click" VerticalAlignment="Center">
                                            <xctk:SplitButton.DropDownContent>
                                                <Button x:Name="newProfBtn" Content="{lex:Loc NewProfile}" MinWidth="140"
                                                        Tag="{Binding DevIndex, Mode=OneTime}" Click="NewProfBtn_Click" />
                                            </xctk:SplitButton.DropDownContent>
                                        </xctk:SplitButton>
                                    </Grid>
                                    <Border Grid.Row="1" Style="{StaticResource HomeInspectorStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.15*" />
                                                <ColumnDefinition Width="1.65*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="GAME OUTPUT" Style="{StaticResource BridgeColumnHeaderStyle}" />
                                                <TextBlock Text="{Binding DataContext.SelectedOutputControllerName, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="READINESS" Style="{StaticResource BridgeColumnHeaderStyle}" />
                                                <TextBlock Text="{Binding DataContext.SelectedControllerStartupTitle, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" />
                                                <TextBlock Text="{Binding DataContext.SelectedControllerStartupDetail, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                           FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedForegroundColor}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Disconnect" MinHeight="28" Margin="10,4,0,0"
                                                    VerticalAlignment="Center" Click="HomeDisconnectBtn_Click"
                                                    Visibility="{Binding IsWireless, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Label x:Name="noContLb" Grid.Row="1" Panel.ZIndex="1" Visibility="Hidden"
                           Background="{DynamicResource SurfaceBackgroundColor}"
                           HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                           FontWeight="SemiBold" />
                </Grid>
            </TabItem>

            <TabItem x:Name="audioHapticsTab" Header="Audio Haptics" Tag="&#xE767;" Visibility="Collapsed" Style="{StaticResource BridgeHiddenToolTabItemStyle}" IsEnabled="{Binding FullTabsEnabled,Mode=OneWay}">
                <local:AudioHapticsControl x:Name="audioHapticsControl" SettingsChanged="ProfileFeatureControl_SettingsChanged" />
            </TabItem>

            <TabItem x:Name="triggerLabTab" Header="Trigger Lab" Tag="TriggerPair" Visibility="Collapsed" Style="{StaticResource BridgeHiddenToolTabItemStyle}" IsEnabled="{Binding FullTabsEnabled,Mode=OneWay}">
                <local:TriggerLabControl x:Name="triggerLabControl" SettingsChanged="ProfileFeatureControl_SettingsChanged" />
            </TabItem>

            <TabItem x:Name="profilesTab" Header="{lex:Loc Profiles}" Tag="&#xE8A5;">
                <Grid x:Name="profDockPanel">
                    <Grid x:Name="profilesBrowserPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border x:Name="profOptsToolbar" Style="{StaticResource BridgeCardStyle}"
                                Padding="12,10" Margin="0,0,0,14">
                            <WrapPanel VerticalAlignment="Center">
                                <Button x:Name="newProfListBtn" Click="NewProfListBtn_Click"
                                        Style="{StaticResource BridgePrimaryButtonStyle}" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding NewProfile, Source={StaticResource ImgLocPaths}}"
                                               Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="New profile" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="editProfBtn" IsEnabled="False" Click="EditProfBtn_Click"
                                        Style="{StaticResource BridgeSecondaryButtonStyle}" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding EditProfile, Source={StaticResource ImgLocPaths}}"
                                               Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="{lex:Loc Edit}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="dupProfBtn" IsEnabled="False" Click="DupProfBtn_Click"
                                        Style="{StaticResource BridgeSecondaryButtonStyle}" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding DuplicateProfile, Source={StaticResource ImgLocPaths}}"
                                               Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="{lex:Loc Duplicate}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="renameProfBtn" IsEnabled="False" Click="RenameProfBtn_Click"
                                        Style="{StaticResource BridgeSecondaryButtonStyle}" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding EditProfile, Source={StaticResource ImgLocPaths}}"
                                               Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="{lex:Loc RenameProfile}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="deleteProfBtn" IsEnabled="False" Click="DeleteProfBtn_Click"
                                        Style="{StaticResource BridgeSecondaryButtonStyle}" Foreground="{DynamicResource DangerColor}"
                                        Margin="0,0,16,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding DeleteProfile, Source={StaticResource ImgLocPaths}}"
                                               Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="{lex:Loc Delete}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="importProfBtn" Click="ImportProfBtn_Click"
                                        Style="{StaticResource BridgeSecondaryButtonStyle}" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding ImportProfile, Source={StaticResource ImgLocPaths}}"
                                               Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="{lex:Loc Import}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="exportProfBtn" IsEnabled="False" Click="ExportProfBtn_Click"
                                        Style="{StaticResource BridgeSecondaryButtonStyle}" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding ExportProfile, Source={StaticResource ImgLocPaths}}"
                                               Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="{lex:Loc Export}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Border>

                        <Border x:Name="dupBoxBar" Grid.Row="1" Style="{StaticResource BridgeCardStyle}"
                                Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
                            <local:DupBox x:Name="dupBox" HorizontalAlignment="Center" />
                        </Border>

                        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundColor}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Padding="18,14" BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Your profiles" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="Select a profile for actions, or double-click a card to edit it."
                                                       Margin="0,3,0,0" FontSize="11"
                                                       Foreground="{DynamicResource MutedForegroundColor}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource RaisedBackgroundColor}"
                                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                                CornerRadius="4" Padding="10,5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ElementName=profilesListBox, Path=Items.Count, StringFormat={}{0} profiles}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MutedForegroundColor}" />
                                        </Border>
                                        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0"
                                                Width="340" MaxWidth="340" HorizontalAlignment="Left"
                                                Background="{DynamicResource RaisedBackgroundColor}"
                                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons"
                                                           Foreground="{DynamicResource MutedForegroundColor}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBox x:Name="profilesSearchTextBox" Grid.Column="1"
                                                         BorderThickness="0" Background="Transparent"
                                                         Padding="2,8" VerticalContentAlignment="Center"
                                                         TextChanged="ProfilesSearchTextBox_TextChanged"
                                                         ToolTip="Search profiles by name" />
                                                <Button x:Name="clearProfilesSearchBtn" Grid.Column="2" Content="&#xE711;"
                                                        FontFamily="Segoe Fluent Icons" FontSize="11"
                                                        Background="Transparent" BorderThickness="0"
                                                        Visibility="Collapsed" ToolTip="Clear search"
                                                        Click="ClearProfilesSearchBtn_Click" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1">
                                    <ListBox x:Name="profilesListBox" Background="Transparent" BorderThickness="0"
                                             Padding="10" SelectionChanged="ProfilesListBox_SelectionChanged"
                                             MouseDoubleClick="ProfilesListBox_MouseDoubleClick"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.Resources>
                                            <localConverters:EscapeAccessKeysConverter x:Key="escapeAccessConvert" />
                                        </ListBox.Resources>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel IsItemsHost="True" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Width" Value="270" />
                                                <Setter Property="Height" Value="88" />
                                                <Setter Property="Margin" Value="6" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="ProfileCard" Background="{DynamicResource RaisedBackgroundColor}"
                                                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                                                    CornerRadius="5" Padding="13">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ProfileCard" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="ProfileCard" Property="Background" Value="{DynamicResource NavigationSelectionColor}" />
                                                                    <Setter TargetName="ProfileCard" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                                                    <Setter TargetName="ProfileCard" Property="BorderThickness" Value="2" />
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Opacity" Value="0.48" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="46" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="38" Height="38" CornerRadius="5"
                                                            Background="{DynamicResource AccentColor}" VerticalAlignment="Center">
                                                        <TextBlock Text="P" Foreground="White" FontSize="16" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                                                        <TextBlock Text="{Binding Name, Mode=OneWay, Converter={StaticResource escapeAccessConvert}}"
                                                                   FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Name}" />
                                                        <TextBlock Text="Controller profile" Margin="0,4,0,0" FontSize="10"
                                                                   Foreground="{DynamicResource MutedForegroundColor}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="&#x203A;" FontSize="22"
                                                               Foreground="{DynamicResource MutedForegroundColor}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=profilesListBox, Path=HasItems}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Width="52" Height="52" CornerRadius="8"
                                                Background="{DynamicResource RaisedBackgroundColor}"
                                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                            <TextBlock Text="P" FontSize="20" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentColor}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Name="profilesEmptyTitle" Text="No profiles yet" Margin="0,12,0,3" FontSize="15"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="profilesEmptyDescription" Text="Create or import a profile to get started."
                                                   Foreground="{DynamicResource MutedForegroundColor}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border x:Name="profileEditorLoadingPanel" Visibility="Collapsed" Panel.ZIndex="2"
                            Background="{DynamicResource CardBackgroundColor}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            CornerRadius="6" Padding="32">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="280">
                            <TextBlock Text="Loading profile editor" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Applying the profile and preparing its controls..."
                                       Margin="0,7,0,16" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundColor}" />
                            <ProgressBar IsIndeterminate="True" Height="4" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem x:Name="autoProfilesTab" Header="{lex:Loc AutoProfiles}" Tag="&#xE823;" Visibility="Collapsed" Style="{StaticResource BridgeHiddenToolTabItemStyle}" IsEnabled="{Binding FullTabsEnabled,Mode=OneWay}">
                <local:AutoProfiles x:Name="autoProfControl">

                </local:AutoProfiles>
            </TabItem>
