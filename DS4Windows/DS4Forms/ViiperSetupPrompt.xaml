<Window x:Class="DS4WinWPF.DS4Forms.ViiperSetupPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game output setup"
        Width="620"
        SizeToContent="Height"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBackgroundColor}"
        Foreground="{DynamicResource ForegroundColor}">
    <Border Background="{DynamicResource SurfaceBackgroundColor}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            CornerRadius="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SidebarBackgroundColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="2,2,0,0"
                    Padding="18,12"
                    PreviewMouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Game output setup"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button x:Name="closeButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Content="×"
                            FontSize="18"
                            Style="{StaticResource BridgeSecondaryButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="Close" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="26,24,26,22">
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40"
                                Height="40"
                                CornerRadius="20"
                                Background="{DynamicResource NavigationSelectionColor}"
                                BorderBrush="{DynamicResource AccentColor}"
                                BorderThickness="1">
                            <TextBlock Text="i"
                                       Foreground="{DynamicResource AccentColor}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="headingText"
                                       Text="Set up game output"
                                       Style="{StaticResource BridgeSectionTitleStyle}"
                                       FontSize="20" />
                            <TextBlock x:Name="summaryText"
                                       Text="Set up the verified components DS4Windows Reworked uses to make your controller available to games."
                                       Foreground="{DynamicResource MutedForegroundColor}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource BridgeCardStyle}"
                            Padding="16"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="requirementsHeadingText"
                                       Text="What setup will do"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,7" />
                            <TextBlock x:Name="requirementsText"
                                       Text="• Verify the components required for game output&#x0a;• Request Windows permission only when setup needs it"
                                       TextWrapping="Wrap"
                                       LineHeight="22" />
                            <Expander Header="Technical details"
                                      Foreground="{DynamicResource MutedForegroundColor}"
                                      Margin="0,12,0,0">
                                <TextBlock x:Name="statusText"
                                           TextWrapping="Wrap"
                                           Margin="0,7,0,0" />
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border x:Name="existingViiperPanel"
                            Background="{DynamicResource RaisedBackgroundColor}"
                            BorderBrush="{DynamicResource AccentColor}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="14"
                            Margin="0,0,0,16"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="existingViiperHeadingText"
                                       Text="Another game-output service was detected"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="existingViiperDescriptionText"
                                       Text="This executable will not be elevated or selected. Setup uses the verified service and only removes recognized legacy files:"
                                       Foreground="{DynamicResource MutedForegroundColor}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,7" />
                            <TextBlock x:Name="existingViiperPathText"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="suppressPromptCheck"
                              Content="Don't show this setup prompt again"
                              ToolTip="You can turn setup prompts back on from Settings → Game output."
                              Style="{StaticResource BridgeDescribedCheckBoxStyle}"
                              Margin="0,0,0,20" />

                    <Border x:Name="portableWarningPanel"
                            Background="{DynamicResource RaisedBackgroundColor}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="12"
                            Margin="0,0,0,16">
                        <TextBlock Text="Keeping DS4Windows Reworked portable leaves this app exactly where it is. Game-output setup is still installed in protected Program Files. Standard setup moves only package-owned DS4Windows files. Profiles, settings, and unrecognized files are preserved."
                                   Foreground="{DynamicResource MutedForegroundColor}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="notNowButton"
                                Content="Continue without game output"
                                MinWidth="94"
                                Style="{StaticResource BridgeSecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="NotNowButton_Click" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="installPortableButton"
                                    Content="Keep this folder portable"
                                    MinWidth="132"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource BridgeSecondaryButtonStyle}"
                                    Click="InstallPortableButton_Click" />
                            <Button x:Name="installButton"
                                    Content="Set up game output"
                                    MinWidth="164"
                                    Style="{StaticResource BridgePrimaryButtonStyle}"
                                    Click="InstallButton_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
