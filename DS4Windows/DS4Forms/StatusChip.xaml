<UserControl x:Class="DS4WinWPF.DS4Forms.StatusChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
             x:Name="root"
             MinHeight="24"
             Focusable="False"
             AutomationProperties.Name="{Binding Label, ElementName=root}">
    <Border x:Name="ChipBorder"
            Background="{DynamicResource SurfaceInsetBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusSmall}"
            Padding="6,2"
            ToolTip="{Binding Detail, ElementName=root}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource StateNeutralBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding State, ElementName=root}" Value="{x:Static local:StatusVisualState.Success}">
                        <Setter Property="BorderBrush" Value="{DynamicResource StateSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State, ElementName=root}" Value="{x:Static local:StatusVisualState.Warning}">
                        <Setter Property="BorderBrush" Value="{DynamicResource StateWarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State, ElementName=root}" Value="{x:Static local:StatusVisualState.Error}">
                        <Setter Property="BorderBrush" Value="{DynamicResource StateErrorBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State, ElementName=root}" Value="{x:Static local:StatusVisualState.Recovery}">
                        <Setter Property="BorderBrush" Value="{DynamicResource StateRecoveryBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="StateGlyph"
                       Width="16"
                       Margin="0,0,4,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       FontFamily="{StaticResource TypeUiFontFamily}"
                       FontSize="{StaticResource TypeBodySize}"
                       FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <!-- Neutral is the absence of a notable state, so it carries
                             no glyph: the slot collapses and the chip reads as a
                             plain bordered value. A literal ellipsis here rendered
                             as if the label had been clipped. -->
                        <Setter Property="Text" Value="" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Foreground" Value="{DynamicResource StateNeutralBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State, ElementName=root}" Value="{x:Static local:StatusVisualState.Success}">
                                <Setter Property="Text" Value="✓" />
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource StateSuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State, ElementName=root}" Value="{x:Static local:StatusVisualState.Warning}">
                                <Setter Property="Text" Value="⚠" />
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource StateWarningBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State, ElementName=root}" Value="{x:Static local:StatusVisualState.Error}">
                                <Setter Property="Text" Value="✕" />
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource StateErrorBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State, ElementName=root}" Value="{x:Static local:StatusVisualState.Recovery}">
                                <Setter Property="Text" Value="↺" />
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource StateRecoveryBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Label, ElementName=root}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="460"
                       FontFamily="{StaticResource TypeUiFontFamily}"
                       FontSize="{StaticResource TypeBodySize}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        </StackPanel>
    </Border>
</UserControl>
