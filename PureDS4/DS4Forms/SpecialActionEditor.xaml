                          Style="{StaticResource FoundationTableListViewStyle}"
                          ItemContainerStyle="{StaticResource FoundationTableListItemStyle}">
                    <!-- A single-column GridView left a titleless filler header
                         beside the real one and drew each header as a bordered
                         cell. One plain header row over the items instead. -->
                    <ListView.Template>
                        <ControlTemplate TargetType="ListView">
                            <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                                            BorderThickness="0,0,0,1" Padding="12,0">
                                        <TextBlock Text="{lex:Loc Trigger}" VerticalAlignment="Center"
                                                   Style="{StaticResource FoundationColumnHeaderStyle}" />
                                    </Border>
                                    <ScrollViewer Grid.Row="1" Focusable="False" Padding="0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter SnapsToDevicePixels="True" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </ListView.Template>
                    <ListViewItem>
                        <CheckBox Style="{StaticResource FoundationCheckBoxStyle}" x:Name="crossTrigCk" Content="Cross" Tag="Cross" Click="ControlTriggerCheckBox_Click" />
                    </ListViewItem>
                    <ListViewItem>
                        <CheckBox Style="{StaticResource FoundationCheckBoxStyle}" x:Name="circleTrigCk" Content="Circle" Tag="Circle" Click="ControlTriggerCheckBox_Click" />
                    </ListViewItem>
                    <ListViewItem>
