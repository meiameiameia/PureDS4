                <ListView x:Name="unloadTriggersListView" Width="200" Visibility="Collapsed">
                    <ListView.View>
                        <GridView>
                            <GridView.Columns>
                                <GridViewColumn Header="{lex:Loc UnloadTrigger}" Width="170">
                                    <GridViewColumn.HeaderContainerStyle>
