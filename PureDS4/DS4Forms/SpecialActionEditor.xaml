                    </Grid>
                    <DockPanel Grid.Column="2" x:Name="actionPropertiesPane">
                        <TextBlock DockPanel.Dock="Top" Text="{lex:Loc Action}" Style="{StaticResource FoundationGroupTitleStyle}" Margin="0,0,0,8" />
                        <Border x:Name="actionChoiceHost" DockPanel.Dock="Top" Margin="0,0,0,12">
                            <ComboBox Style="{StaticResource FoundationComboBoxStyle}" x:Name="actionTypeCombo" SelectedIndex="{Binding ActionTypeIndex,FallbackValue=0}" Margin="0">
                                <ComboBoxItem Content="{lex:Loc SpecialActionEdit.SelectAction}" />
                                <ComboBoxItem Content="{lex:Loc SpecialActionEdit.RecordMacro}" />
                                <ComboBoxItem Content="{lex:Loc SpecialActionEdit.LaunchProgram}" />
                                <ComboBoxItem Content="{lex:Loc SpecialActionEdit.LoadProfile}" />
                                <ComboBoxItem Content="{lex:Loc SpecialActionEdit.PressKey}" />
                                <ComboBoxItem Content="{lex:Loc SpecialActionEdit.DisconnectBT}" />
                                <ComboBoxItem Content="{lex:Loc SpecialActionEdit.CheckBattery}" />
                                <ComboBoxItem Content="{lex:Loc SpecialActionEdit.MultiAction}" />
                                <ComboBoxItem Content="{lex:Loc SpecialActionEdit.SixAxisWheelCalib}" />
                                <ComboBoxItem Content="{lex:Loc SpecialActionEdit.CalibrateGyro}" />
                            </ComboBox>
                        </Border>
                        <ScrollViewer x:Name="actionPropertiesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Border x:Name="actionPropertiesHost" Width="{Binding ViewportWidth, ElementName=actionPropertiesScroll}">
                                <TabControl Style="{StaticResource FoundationContentTabsStyle}" x:Name="actionTypeTabControl" SelectedIndex="{Binding ActionTypeIndex}" BorderBrush="{x:Null}">
                                    <TabItem x:Name="blankActTab" Header=""></TabItem>
                                    <TabItem x:Name="macroActTab" Header="Macro">
                                        <StackPanel Margin="{StaticResource spaceMargin}">
                                            <Button Style="{StaticResource FoundationWrappedButtonStyle}" x:Name="recordMacroBtn" Content="{lex:Loc SpecialActionEdit.RecordMacro}" HorizontalAlignment="Left" MinWidth="140" Tag="{Binding MacroElements,Mode=OneWay,ValidatesOnNotifyDataErrors=True}" Margin="{StaticResource spaceMargin}" Click="RecordMacroBtn_Click" />
                                            <Border Style="{StaticResource FoundationPropertyRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Margin="0,0,12,0" Content="{lex:Loc ScanCode}" Target="{Binding ElementName=actionOptionSwitch1}" />
                                                    <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" Content="{lex:Loc ScanCode}" Margin="0" IsChecked="{Binding UseScanCode}" x:Name="actionOptionSwitch1" Grid.Column="1" AutomationProperties.Name="{lex:Loc ScanCode}" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource FoundationPropertyRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Margin="0,0,12,0" Content="{lex:Loc SpecialActionEdit.RunTriggerRelease}" Target="{Binding ElementName=actionOptionSwitch2}" />
                                                    <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" Content="{lex:Loc SpecialActionEdit.RunTriggerRelease}" Margin="0" IsChecked="{Binding RunTriggerRelease}" x:Name="actionOptionSwitch2" Grid.Column="1" AutomationProperties.Name="{lex:Loc SpecialActionEdit.RunTriggerRelease}" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource FoundationPropertyRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Margin="0,0,12,0" Content="{lex:Loc SpecialActionEdit.SyncRun}" Target="{Binding ElementName=actionOptionSwitch3}" />
                                                    <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" Content="{lex:Loc SpecialActionEdit.SyncRun}" Margin="0" IsChecked="{Binding SyncRun}" x:Name="actionOptionSwitch3" Grid.Column="1" AutomationProperties.Name="{lex:Loc SpecialActionEdit.SyncRun}" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource FoundationPropertyRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Margin="0,0,12,0" Content="{lex:Loc SpecialActionEdit.KeepKeyState}" Target="{Binding ElementName=actionOptionSwitch4}" />
                                                    <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" Content="{lex:Loc SpecialActionEdit.KeepKeyState}" Margin="0" IsChecked="{Binding KeepKeyState}" x:Name="actionOptionSwitch4" Grid.Column="1" AutomationProperties.Name="{lex:Loc SpecialActionEdit.KeepKeyState}" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource FoundationPropertyRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Margin="0,0,12,0" Content="{lex:Loc SpecialActionEdit.RepeatWhileHeld}" Target="{Binding ElementName=actionOptionSwitch5}" />
                                                    <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" Content="{lex:Loc SpecialActionEdit.RepeatWhileHeld}" Margin="0" IsChecked="{Binding RepeatHeld}" x:Name="actionOptionSwitch5" Grid.Column="1" AutomationProperties.Name="{lex:Loc SpecialActionEdit.RepeatWhileHeld}" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Macrostring,FallbackValue={lex:Loc SpecialActionEdit.MacroRecorded}}" Margin="{StaticResource spaceMargin}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem x:Name="launchProgActTab" Header="Launch Program">
                                        <StackPanel Margin="{StaticResource spaceMargin}">
                                            <StackPanel Orientation="Horizontal" Margin="{StaticResource spaceMargin}">
                                                <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Content="{lex:Loc SpecialActionEdit.HoldFor}" ContentStringFormat="{}{0} "></Label>
                                                <xctk:DecimalUpDown Style="{StaticResource FoundationNumericInputStyle}" Value="{Binding Delay}" Width="60" Minimum="0" Maximum="60" FormatString="F2" Increment="0.5" />
                                                <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Content="secs" />
                                            </StackPanel>
                                            <Grid Margin="{StaticResource spaceMargin}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Style="{StaticResource FoundationTextBoxStyle}" Text="{Binding Filepath, Mode=OneWay}" ToolTip="{Binding Filepath}" IsReadOnly="True" VerticalContentAlignment="Center" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" Margin="0,0,8,0" />
                                                <Button Style="{StaticResource FoundationWrappedButtonStyle}" x:Name="launchProgBrowseBtn" Grid.Column="1" Content="{lex:Loc Browse}" Click="LaunchProgBrowseBtn_Click" />
                                            </Grid>
                                            <StackPanel Margin="{StaticResource spaceMargin}">
                                                <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Content="Arguments" />
                                                <TextBox Style="{StaticResource FoundationTextBoxStyle}" Text="{Binding Arguments}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem x:Name="loadProfileTab" Header="Load Profile">
                                        <StackPanel Margin="{StaticResource spaceMargin}">
                                            <ComboBox Style="{StaticResource FoundationComboBoxStyle}" SelectedIndex="{Binding ProfileIndex,FallbackValue=0}" Margin="{StaticResource spaceMargin}">
                                                <ComboBox.Resources>
                                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                    <CollectionViewSource x:Key="profileListViewSource" Source="{Binding ProfileList.ProfileListCol,Mode=OneWay}" />
                                                </ComboBox.Resources>
                                                <ComboBox.ItemsSource>
                                                    <CompositeCollection>
                                                        <ComboBoxItem Content="(none)" />
                                                        <CollectionContainer x:Name="profileCollection" Collection="{Binding Source={StaticResource profileListViewSource}}" />
                                                    </CompositeCollection>
                                                </ComboBox.ItemsSource>
                                            </ComboBox>
                                            <Button Style="{StaticResource FoundationWrappedButtonStyle}" x:Name="loadProfUnloadBtn" Content="{lex:Loc SpecialActionEdit.SetUnloadTrigger}" Margin="{StaticResource spaceMargin}" IsEnabled="{Binding UnloadEnabled}" Click="LoadProfUnloadBtn_Click" />
                                            <Border Style="{StaticResource FoundationPropertyRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Margin="0,0,12,0" Content="{lex:Loc SpecialActionEdit.UnloadTriggerRelease}" Target="{Binding ElementName=actionOptionSwitch6}" />
                                                    <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" Content="{lex:Loc SpecialActionEdit.UnloadTriggerRelease}" Margin="0" IsChecked="{Binding AutoUntrigger}" x:Name="actionOptionSwitch6" Grid.Column="1" AutomationProperties.Name="{lex:Loc SpecialActionEdit.UnloadTriggerRelease}" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem x:Name="pressKetActTab" Header="Press Key">
                                        <StackPanel Margin="{StaticResource spaceMargin}">
                                            <Button Style="{StaticResource FoundationWrappedButtonStyle}" x:Name="pressKeySelectBtn" Content="{Binding DescribeText,FallbackValue={lex:Loc SpecialActionEdit.SelectKey}}" Margin="{StaticResource spaceMargin}" Click="PressKeySelectBtn_Click" />
                                            <Button Style="{StaticResource FoundationWrappedButtonStyle}" x:Name="pressKeyToggleTriggerBtn" Content="{lex:Loc SpecialActionEdit.SetUnloadTrigger}" Tag="{Binding UnloadError,ValidatesOnNotifyDataErrors=True}" Visibility="{Binding ShowToggleControls}" Margin="{StaticResource spaceMargin}" Click="PressKeyToggleTriggerBtn_Click" />
                                            <StackPanel Margin="{StaticResource spaceMargin}" Visibility="{Binding ShowToggleControls}">
                                                <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Content="{lex:Loc SpecialActionEdit.UntoggleKeyBy}" />
                                                <ComboBox Style="{StaticResource FoundationComboBoxStyle}" x:Name="pressReleaseKeyCombo" SelectedIndex="{Binding PressReleaseIndex}">
                                                    <ComboBoxItem Content="{lex:Loc SpecialActionEdit.PressingUnloadTrigger}" />
                                                    <ComboBoxItem Content="{lex:Loc SpecialActionEdit.ReleasingUnloadTrigger}" />
                                                </ComboBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem x:Name="disconnectBTTab" Header="DisBT">
                                        <StackPanel Orientation="Horizontal" Margin="{StaticResource spaceMargin}">
                                            <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Content="{lex:Loc SpecialActionEdit.HoldFor}" ContentStringFormat="{}{0} "></Label>
                                            <xctk:DecimalUpDown Style="{StaticResource FoundationNumericInputStyle}" Value="{Binding HoldInterval}" Width="60" Minimum="0" Maximum="60" FormatString="F2" Increment="0.5" />
                                            <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Content="secs" />
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem x:Name="checkBatteryTab" Header="Check Battery">
                                        <StackPanel Margin="{StaticResource spaceMargin}">
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                                                <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Content="{lex:Loc SpecialActionEdit.HoldFor}" ContentStringFormat="{}{0} "></Label>
                                                <xctk:DecimalUpDown Style="{StaticResource FoundationNumericInputStyle}" Value="{Binding HoldInterval}" Width="60" Minimum="0" Maximum="60" FormatString="F2" Increment="0.5" />
                                                <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Content="secs" />
                                            </StackPanel>
                                            <Border Style="{StaticResource FoundationPropertyRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Margin="0,0,12,0" Content="{lex:Loc SpecialActionEdit.ViaNotification}" Target="{Binding ElementName=actionOptionSwitch7}" />
                                                    <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" Content="{lex:Loc SpecialActionEdit.ViaNotification}" IsChecked="{Binding Notification}" Margin="0" x:Name="actionOptionSwitch7" Grid.Column="1" AutomationProperties.Name="{lex:Loc SpecialActionEdit.ViaNotification}" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource FoundationPropertyRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Margin="0,0,12,0" Content="{lex:Loc SpecialActionEdit.ViaLightbar}" Target="{Binding ElementName=actionOptionSwitch8}" />
                                                    <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" Content="{lex:Loc SpecialActionEdit.ViaLightbar}" IsChecked="{Binding Lightbar}" Margin="0" x:Name="actionOptionSwitch8" Grid.Column="1" AutomationProperties.Name="{lex:Loc SpecialActionEdit.ViaLightbar}" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,8">
                                                <StackPanel HorizontalAlignment="Left">
                                                    <Button x:Name="batteryLowColorBtn" Width="24" Height="24" VerticalAlignment="Center" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" AutomationProperties.Name="Empty battery colour" Click="BatteryEmptyColorBtn_Click">
                                                        <Button.Background>
                                                            <SolidColorBrush Color="{Binding EmptyColor,FallbackValue=#FFFF0000}" />
                                                        </Button.Background>
                                                    </Button>
                                                    <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Content="0%" />
                                                </StackPanel>
                                                <Button Width="130" Height="20" VerticalAlignment="Top" Focusable="False" Margin="10,0,0,0">
                                                    <Button.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="{Binding EmptyColor,FallbackValue=#FFFF0000}" />
                                                            <GradientStop Color="{Binding FullColor,FallbackValue=#FF00FF00}" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Button.Background>
                                                </Button>
                                                <StackPanel Width="50">
                                                    <Button x:Name="batteryFullColorBtn" Width="24" Height="24" VerticalAlignment="Center" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" AutomationProperties.Name="Full battery colour" HorizontalAlignment="Center" Click="BatteryFullColorBtn_Click">
                                                        <Button.Background>
                                                            <SolidColorBrush Color="{Binding FullColor,FallbackValue=#FF00FF00}" />
                                                        </Button.Background>
                                                    </Button>
                                                    <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Content="100%" Padding="0,5" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem x:Name="multiActTab" Header="MultiAct">
                                        <StackPanel Margin="{StaticResource spaceMargin}">
                                            <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Content="{lex:Loc SpecialActionEdit.TapTrigger}" Margin="{StaticResource spaceMargin}" />
                                            <Button Style="{StaticResource FoundationWrappedButtonStyle}" x:Name="multiTapTrigBtn" Content="{Binding TapMacroText,FallbackValue={lex:Loc SpecialActionEdit.SelectMacro}}" Margin="{StaticResource spaceMargin}" Click="MultiTapTrigBtn_Click" />
                                            <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Content="{lex:Loc SpecialActionEdit.HoldTrigger}" Margin="{StaticResource spaceMargin}" />
                                            <Button Style="{StaticResource FoundationWrappedButtonStyle}" x:Name="multiHoldTapTrigBtn" Content="{Binding HoldMacroText,FallbackValue={lex:Loc SpecialActionEdit.SelectMacro}}" Margin="{StaticResource spaceMargin}" Click="MultiHoldTapTrigBtn_Click" />
                                            <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Content="{lex:Loc SpecialActionEdit.DoubleTapTrigger}" Margin="{StaticResource spaceMargin}" />
                                            <Button Style="{StaticResource FoundationWrappedButtonStyle}" x:Name="multiDoubleTapTrigBtn" Content="{Binding DoubleTapMacroText,FallbackValue={lex:Loc SpecialActionEdit.SelectMacro}}" Margin="{StaticResource spaceMargin}" Click="MultiDoubleTapTrigBtn_Click" />
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem x:Name="sixaxisWheelCalibrateTab" Header="Sixaxis Wheel">
                                        <StackPanel Orientation="Horizontal" Margin="{StaticResource spaceMargin}">
                                            <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Content="{lex:Loc HoldFor}" ContentStringFormat="{}{0} "></Label>
                                            <xctk:DecimalUpDown Style="{StaticResource FoundationNumericInputStyle}" Value="{Binding HoldInterval}" Width="60" Minimum="0" Maximum="60" FormatString="F2" Increment="0.5" />
                                            <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Content="secs" />
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem x:Name="gyroCalibrateTab" Header="{lex:Loc SpecialActionEdit.CalibrateGyro}">
                                        <StackPanel Orientation="Horizontal" Margin="{StaticResource spaceMargin}">
                                            <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Content="{lex:Loc HoldFor}" ContentStringFormat="{}{0} "></Label>
                                            <xctk:DecimalUpDown Style="{StaticResource FoundationNumericInputStyle}" Value="{Binding HoldInterval}" Width="60" Minimum="0" Maximum="60" FormatString="F2" Increment="0.5" />
                                            <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Content="secs" />
                                        </StackPanel>
                                    </TabItem>
                                </TabControl>
                            </Border>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
                    </DockPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
