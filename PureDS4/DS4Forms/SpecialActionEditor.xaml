                        <TabItem x:Name="macroActTab" Header="Macro">
                            <StackPanel Margin="{StaticResource spaceMargin}">
                                <Button Style="{StaticResource FoundationButtonStyle}" x:Name="recordMacroBtn" Content="{lex:Loc SpecialActionEdit.RecordMacro}"
                                        HorizontalAlignment="Left" MinWidth="140"
                                        Tag="{Binding MacroElements,Mode=OneWay,ValidatesOnNotifyDataErrors=True}" Margin="{StaticResource spaceMargin}"
                                        Click="RecordMacroBtn_Click" />
                                <CheckBox Style="{StaticResource FoundationCheckBoxStyle}" Content="{lex:Loc ScanCode}" Margin="{StaticResource spaceMargin}" IsChecked="{Binding UseScanCode}" />
                                <CheckBox Style="{StaticResource FoundationCheckBoxStyle}" Content="{lex:Loc SpecialActionEdit.RunTriggerRelease}" Margin="{StaticResource spaceMargin}" IsChecked="{Binding RunTriggerRelease}" />
                                <CheckBox Style="{StaticResource FoundationCheckBoxStyle}" Content="{lex:Loc SpecialActionEdit.SyncRun}" Margin="{StaticResource spaceMargin}" IsChecked="{Binding SyncRun}" />
                                <CheckBox Style="{StaticResource FoundationCheckBoxStyle}" Content="{lex:Loc SpecialActionEdit.KeepKeyState}" Margin="{StaticResource spaceMargin}" IsChecked="{Binding KeepKeyState}" />
                                <CheckBox Style="{StaticResource FoundationCheckBoxStyle}" Content="{lex:Loc SpecialActionEdit.RepeatWhileHeld}" Margin="{StaticResource spaceMargin}" IsChecked="{Binding RepeatHeld}" />
                                <TextBlock Text="{Binding Macrostring,FallbackValue={lex:Loc SpecialActionEdit.MacroRecorded}}" Margin="{StaticResource spaceMargin}" />
                            </StackPanel>
                        </TabItem>
                        <TabItem x:Name="launchProgActTab" Header="Launch Program">
                            <StackPanel Margin="{StaticResource spaceMargin}">
                                <StackPanel Orientation="Horizontal" Margin="{StaticResource spaceMargin}">
                                    <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="{lex:Loc SpecialActionEdit.HoldFor}" ContentStringFormat="{}{0} "></Label>
                                    <xctk:DecimalUpDown Style="{StaticResource FoundationNumericInputStyle}" Value="{Binding Delay}" Width="60" Minimum="0" Maximum="60" FormatString= "F2" Increment="0.5" />
                                    <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="secs" />
                                </StackPanel>
                                <Grid Margin="{StaticResource spaceMargin}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource FoundationTextBoxStyle}" Text="{Binding Filepath, Mode=OneWay}" ToolTip="{Binding Filepath}"
                                             IsReadOnly="True" VerticalContentAlignment="Center"
                                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                                             Margin="0,0,8,0" />
                                    <Button Style="{StaticResource FoundationButtonStyle}" x:Name="launchProgBrowseBtn" Grid.Column="1" Content="{lex:Loc Browse}"
                                            Click="LaunchProgBrowseBtn_Click" />
                                </Grid>
                                <StackPanel Margin="{StaticResource spaceMargin}">
                                    <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="Arguments"/>
                                    <TextBox Style="{StaticResource FoundationTextBoxStyle}" Text="{Binding Arguments}" />
                                </StackPanel>
                            </StackPanel>
                        </TabItem>
                        <TabItem x:Name="loadProfileTab" Header="Load Profile">
                            <StackPanel Margin="{StaticResource spaceMargin}">
                                <ComboBox Style="{StaticResource FoundationComboBoxStyle}" SelectedIndex="{Binding ProfileIndex,FallbackValue=0}"
                                          Margin="{StaticResource spaceMargin}">
                                    <ComboBox.Resources>
                                        <DataTemplate DataType="{x:Type ComboBoxItem}">
                                            <TextBlock Text="{Binding Content}" />
                                        </DataTemplate>

                                        <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                        <CollectionViewSource x:Key="profileListViewSource" Source="{Binding ProfileList.ProfileListCol,Mode=OneWay}" />
                                    </ComboBox.Resources>
                                    <ComboBox.ItemsSource>
                                        <CompositeCollection>
                                            <ComboBoxItem Content="(none)"/>
                                            <CollectionContainer x:Name="profileCollection"
                                                                 Collection="{Binding Source={StaticResource profileListViewSource}}" />
                                        </CompositeCollection>
                                    </ComboBox.ItemsSource>
                                </ComboBox>
                                <Button Style="{StaticResource FoundationButtonStyle}" x:Name="loadProfUnloadBtn" Content="{lex:Loc SpecialActionEdit.SetUnloadTrigger}" Margin="{StaticResource spaceMargin}"
                                        IsEnabled="{Binding UnloadEnabled}" Click="LoadProfUnloadBtn_Click" />
                                <CheckBox Style="{StaticResource FoundationCheckBoxStyle}" Content="{lex:Loc SpecialActionEdit.UnloadTriggerRelease}" Margin="{StaticResource spaceMargin}" IsChecked="{Binding AutoUntrigger}" />
                            </StackPanel>
                        </TabItem>
                        <TabItem x:Name="pressKetActTab" Header="Press Key">
                            <StackPanel Margin="{StaticResource spaceMargin}">
                                <Button Style="{StaticResource FoundationButtonStyle}" x:Name="pressKeySelectBtn" Content="{Binding DescribeText,FallbackValue={lex:Loc SpecialActionEdit.SelectKey}}"
                                        Margin="{StaticResource spaceMargin}" Click="PressKeySelectBtn_Click" />
                                <Button Style="{StaticResource FoundationButtonStyle}" x:Name="pressKeyToggleTriggerBtn" Content="{lex:Loc SpecialActionEdit.SetUnloadTrigger}"
                                        Tag="{Binding UnloadError,ValidatesOnNotifyDataErrors=True}"
                                        Visibility="{Binding ShowToggleControls}"
                                        Margin="{StaticResource spaceMargin}" Click="PressKeyToggleTriggerBtn_Click" />

                                <StackPanel Margin="{StaticResource spaceMargin}" Visibility="{Binding ShowToggleControls}">
                                    <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="{lex:Loc SpecialActionEdit.UntoggleKeyBy}" />
                                    <ComboBox Style="{StaticResource FoundationComboBoxStyle}" x:Name="pressReleaseKeyCombo" SelectedIndex="{Binding PressReleaseIndex}">
                                        <ComboBoxItem Content="{lex:Loc SpecialActionEdit.PressingUnloadTrigger}" />
                                        <ComboBoxItem Content="{lex:Loc SpecialActionEdit.ReleasingUnloadTrigger}" />
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </TabItem>
                        <TabItem x:Name="disconnectBTTab" Header="DisBT">
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource spaceMargin}">
                                <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="{lex:Loc SpecialActionEdit.HoldFor}" ContentStringFormat="{}{0} "></Label>
                                <xctk:DecimalUpDown Style="{StaticResource FoundationNumericInputStyle}" Value="{Binding HoldInterval}" Width="60" Minimum="0" Maximum="60" FormatString= "F2" Increment="0.5" />
                                <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="secs" />
                            </StackPanel>
                        </TabItem>
                        <TabItem x:Name="checkBatteryTab" Header="Check Battery">
                            <StackPanel Margin="{StaticResource spaceMargin}">
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                                    <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="{lex:Loc SpecialActionEdit.HoldFor}" ContentStringFormat="{}{0} "></Label>
                                    <xctk:DecimalUpDown Style="{StaticResource FoundationNumericInputStyle}" Value="{Binding HoldInterval}" Width="60" Minimum="0" Maximum="60" FormatString= "F2" Increment="0.5"/>
                                    <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="secs" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource FoundationCheckBoxStyle}" Content="{lex:Loc SpecialActionEdit.ViaNotification}" IsChecked="{Binding Notification}" Margin="{StaticResource spaceMargin}" />
                                <CheckBox Style="{StaticResource FoundationCheckBoxStyle}" Content="{lex:Loc SpecialActionEdit.ViaLightbar}" IsChecked="{Binding Lightbar}" Margin="{StaticResource spaceMargin}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,8">
                                    <StackPanel HorizontalAlignment="Left">
                                        <Button x:Name="batteryLowColorBtn" Width="24" Height="24" VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                                AutomationProperties.Name="Empty battery colour"
                                                Click="BatteryEmptyColorBtn_Click">
                                            <Button.Background>
                                                <SolidColorBrush Color="{Binding EmptyColor,FallbackValue=#FFFF0000}"/>
                                            </Button.Background>
                                        </Button>
                                        <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="0%" />
                                    </StackPanel>
                                    <Button Width="130" Height="20" VerticalAlignment="Top" Focusable="False" Margin="10,0,0,0">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="{Binding EmptyColor,FallbackValue=#FFFF0000}"/>
                                                <GradientStop Color="{Binding FullColor,FallbackValue=#FF00FF00}" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                    </Button>
                                    <StackPanel Width="50">
                                        <Button x:Name="batteryFullColorBtn" Width="24" Height="24" VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                                AutomationProperties.Name="Full battery colour"
                                                HorizontalAlignment="Center" Click="BatteryFullColorBtn_Click">
                                            <Button.Background>
                                                <SolidColorBrush Color="{Binding FullColor,FallbackValue=#FF00FF00}"/>
                                            </Button.Background>
                                        </Button>
                                        <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="100%" Padding="0,5" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </TabItem>
                        <TabItem x:Name="multiActTab" Header="MultiAct">
                            <StackPanel Margin="{StaticResource spaceMargin}">
                                <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="{lex:Loc SpecialActionEdit.TapTrigger}" Margin="{StaticResource spaceMargin}" />
                                <Button Style="{StaticResource FoundationButtonStyle}" x:Name="multiTapTrigBtn" Content="{Binding TapMacroText,FallbackValue={lex:Loc SpecialActionEdit.SelectMacro}}"
                                        Margin="{StaticResource spaceMargin}" Click="MultiTapTrigBtn_Click" />
                                <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="{lex:Loc SpecialActionEdit.HoldTrigger}" Margin="{StaticResource spaceMargin}" />
                                <Button Style="{StaticResource FoundationButtonStyle}" x:Name="multiHoldTapTrigBtn" Content="{Binding HoldMacroText,FallbackValue={lex:Loc SpecialActionEdit.SelectMacro}}"
                                        Margin="{StaticResource spaceMargin}" Click="MultiHoldTapTrigBtn_Click" />
                                <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="{lex:Loc SpecialActionEdit.DoubleTapTrigger}" Margin="{StaticResource spaceMargin}" />
                                <Button Style="{StaticResource FoundationButtonStyle}" x:Name="multiDoubleTapTrigBtn" Content="{Binding DoubleTapMacroText,FallbackValue={lex:Loc SpecialActionEdit.SelectMacro}}"
                                        Margin="{StaticResource spaceMargin}" Click="MultiDoubleTapTrigBtn_Click" />
                            </StackPanel>
                        </TabItem>
                        <TabItem x:Name="sixaxisWheelCalibrateTab" Header="Sixaxis Wheel">
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource spaceMargin}">
                                <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="{lex:Loc HoldFor}" ContentStringFormat="{}{0} "></Label>
                                <xctk:DecimalUpDown Style="{StaticResource FoundationNumericInputStyle}" Value="{Binding HoldInterval}" Width="60" Minimum="0" Maximum="60" FormatString= "F2" Increment="0.5" />
                                <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="secs" />
                            </StackPanel>
                        </TabItem>
                        <TabItem x:Name="gyroCalibrateTab" Header="{lex:Loc SpecialActionEdit.CalibrateGyro}">
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource spaceMargin}">
                                <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="{lex:Loc HoldFor}" ContentStringFormat="{}{0} "></Label>
                                <xctk:DecimalUpDown Style="{StaticResource FoundationNumericInputStyle}" Value="{Binding HoldInterval}" Width="60" Minimum="0" Maximum="60" FormatString= "F2" Increment="0.5" />
                                <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="secs" />
                            </StackPanel>
                        </TabItem>
                    </TabControl>


                </StackPanel>
            </DockPanel>
        </DockPanel>
        </DockPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
