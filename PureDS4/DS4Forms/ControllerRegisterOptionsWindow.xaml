<Window x:Class="DS4WinWPF.DS4Forms.ControllerRegisterOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:LocalizeDictionary.DesignCulture=""
        lex:ResxLocalizationProvider.DefaultAssembly="PureDS4"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        mc:Ignorable="d"
        Title="{lex:Loc ControllerRegOptWin.WinTitle}" Height="480" Width="800"
        MinHeight="400" MinWidth="720" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Style="{DynamicResource WindowStyle}" Closed="Window_Closed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <DockPanel x:Name="devOptionsDockPanel" Margin="16,12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Controller detection" Style="{StaticResource FoundationPageTitleStyle}" />
            <TextBlock Text="Choose what PureDS4 detects and inspect device-specific options."
                       Style="{StaticResource FoundationSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="Changes are saved when you close this window."
                   Style="{StaticResource FoundationSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,12,0,0" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Detection" Style="{StaticResource FoundationSectionHeadingStyle}" Margin="0,0,0,6" />
                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                        <DockPanel>
                            <CheckBox x:Name="ds4DetectionToggle" DockPanel.Dock="Right" Margin="12,0,0,0"
                                      Style="{StaticResource FoundationToggleSwitchStyle}"
                                      AutomationProperties.Name="DualShock 4 detection" IsChecked="{Binding DS4DeviceOpts.Enabled}" />
                            <StackPanel>
                                <TextBlock Text="DualShock 4" Style="{StaticResource FoundationSettingTitleStyle}" />
                                <TextBlock Text="Detect supported DS4 controllers." Style="{StaticResource FoundationSettingDescriptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                        <DockPanel>
                            <CheckBox x:Name="moonlightDetectionToggle" DockPanel.Dock="Right" Margin="12,0,0,0"
                                      Style="{StaticResource FoundationToggleSwitchStyle}" IsChecked="{Binding UseMoonlight}"
                                      AutomationProperties.Name="Moonlight / Sunshine virtual controllers"
                                      ToolTip="PureDS4's own game outputs are always excluded." />
                            <StackPanel>
                                <TextBlock Text="Moonlight / Sunshine" Style="{StaticResource FoundationSettingTitleStyle}" />
                                <TextBlock Text="Accept supported streamed controllers." Style="{StaticResource FoundationSettingDescriptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                        <Hyperlink NavigateUri="https://github.com/meiameiameia/pureds4/blob/main/docs/moonlight_support.md"
                                   RequestNavigate="Hyperlink_RequestNavigate">About virtual controller support</Hyperlink>
                    </TextBlock>
                    <!-- Kept for explicit hardware-validation builds only. -->
                    <StackPanel x:Name="experimentalDs3Panel" Margin="0,16,0,0"
                                Visibility="{Binding ExperimentalDS3Build, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="DualShock 3 (experimental hardware validation)" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <CheckBox Content="Enable DualShock 3 detection" IsChecked="{Binding DS3DeviceOpts.Enabled}" Margin="0,4,0,0"
                                  ToolTip="Experimental. Requires DsHidMini or a Sixaxis driver already installed. Not supported in a public release." />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource FoundationSecondaryTextStyle}"
                                   Text="This build is for testing a genuine DualShock 3 only. It is not a public release and must not be promoted." />
                    </StackPanel>
                    <TextBlock Text="Diagnostics" Style="{StaticResource FoundationSectionHeadingStyle}" />
                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                        <DockPanel>
                            <CheckBox x:Name="verboseDetectionToggle" DockPanel.Dock="Right" Margin="12,0,0,0"
                                      Style="{StaticResource FoundationToggleSwitchStyle}" IsChecked="{Binding VerboseLogMessages}"
                                      AutomationProperties.Name="Verbose detection logging" ToolTip="{lex:Loc EnableVerboseLogTip}" />
                            <StackPanel>
                                <TextBlock Text="Verbose logging" Style="{StaticResource FoundationSettingTitleStyle}" />
                                <TextBlock Text="Include additional device diagnostics." Style="{StaticResource FoundationSettingDescriptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{lex:Loc DetectedControllers}" Style="{StaticResource FoundationSectionHeadingStyle}" Margin="0,0,0,6" />
                <ListBox x:Name="controllerListBox" Grid.Row="1" ItemsSource="{Binding CurrentInputDevices}"
                         SelectedIndex="{Binding ControllerSelectedIndex}" AutomationProperties.Name="Detected controllers"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding IdText}" TextWrapping="Wrap" Margin="4" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock Text="Select a controller to see its device options." TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FoundationSecondaryTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ControllerSelectedIndex}" Value="-1">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TabControl x:Name="deviceSettingsTabControl" SelectedIndex="{Binding CurrentTabSelectedIndex}"
                                Style="{StaticResource FoundationContentTabsStyle}">
                        <TabItem Header="Blank" Visibility="Collapsed" />
                        <TabItem x:Name="ds4OptsTabItem" Header="DS4" Visibility="Collapsed">
                            <StackPanel Visibility="{Binding Visible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Device options" Style="{StaticResource FoundationSectionHeadingStyle}" Margin="0,0,0,6" />
                                <CheckBox Content="{lex:Loc Copycat}" IsChecked="{Binding Options.IsCopyCat, FallbackValue='False'}"
                                          ToolTip="{lex:Loc CopycatTip}" />
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
