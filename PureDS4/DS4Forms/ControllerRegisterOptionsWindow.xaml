<Window x:Class="DS4WinWPF.DS4Forms.ControllerRegisterOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:LocalizeDictionary.DesignCulture=""
        lex:ResxLocalizationProvider.DefaultAssembly="PureDS4"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        mc:Ignorable="d"
        Title="{lex:Loc ControllerRegOptWin.WinTitle}" Height="450" Width="800"
        Style="{DynamicResource WindowStyle}" Closed="Window_Closed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <DockPanel x:Name="devOptionsDockPanel" Margin="4">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <CheckBox Content="{lex:Loc ControllerSupportDS4}" IsChecked="{Binding DS4DeviceOpts.Enabled}" />
                <CheckBox Content="Accept Moonlight / Sunshine virtual controllers"
                          IsChecked="{Binding UseMoonlight}"
                          ToolTip="Accept every supported virtual controller created while Sunshine is running. PureDS4's own game outputs are always excluded." />
                <TextBlock>
                    <Hyperlink NavigateUri="https://github.com/meiameiameia/pureds4/blob/main/docs/moonlight_support.md"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        About virtual controller support
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- Present only in a DualShock 3 hardware-validation build. A
                 standard build binds nothing here because the panel is
                 collapsed and ExperimentalDS3Build is a compile-time false. -->
            <StackPanel DockPanel.Dock="Top" Margin="0,16,0,0"
                        Visibility="{Binding ExperimentalDS3Build, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="DualShock 3 (experimental hardware validation)"
                           FontWeight="SemiBold" />
                <CheckBox Content="Enable DualShock 3 detection"
                          IsChecked="{Binding DS3DeviceOpts.Enabled}"
                          Margin="0,4,0,0"
                          ToolTip="Experimental. Requires DsHidMini or a Sixaxis driver already installed. Not supported in a public release." />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.8"
                           Text="This build is for testing a genuine DualShock 3 only. It is not a public release and must not be promoted." />
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Margin="0,16,0,0">
                <CheckBox Content="{lex:Loc EnableVerboseLog}" IsChecked="{Binding VerboseLogMessages}" ToolTip="{lex:Loc EnableVerboseLogTip}"/>
            </StackPanel>
            
            <DockPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                <Label Content="{lex:Loc DetectedControllers}" ContentStringFormat="{}{0}:" DockPanel.Dock="Top" FontWeight="Bold" />
                <ListBox x:Name="controllerListBox" ItemsSource="{Binding CurrentInputDevices}" SelectedIndex="{Binding ControllerSelectedIndex}"
                      Margin="0,8,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding IdText}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            
        </DockPanel>

        <TabControl x:Name="deviceSettingsTabControl" DockPanel.Dock="Right" SelectedIndex="{Binding CurrentTabSelectedIndex}" Margin="40,4,4,4">
            <TabItem Header="Blank" Visibility="Collapsed">
            </TabItem>

            <TabItem x:Name="ds4OptsTabItem" Header="DS4" Visibility="Collapsed">
                <StackPanel Visibility="{Binding Visible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="4">
                    <CheckBox Content="{lex:Loc Copycat}" IsChecked="{Binding Options.IsCopyCat, FallbackValue='False'}" ToolTip="{lex:Loc CopycatTip}" />
                </StackPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
