                                                               Foreground="{DynamicResource AccentColor}" />
                                                </Border>
                                                <TextBlock Text="&#x203A;" FontSize="21"
                                                           Foreground="{DynamicResource MutedForegroundColor}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
