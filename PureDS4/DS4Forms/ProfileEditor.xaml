                            <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" x:Name="useControllerReadoutCk" Content="for readout" IsChecked="{Binding UseControllerReadout}" Click="UseControllerReadoutCk_Click" AutomationProperties.Name="Use controller for readout" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="{lex:Loc MouseSensitivity}" Style="{StaticResource FoundationPropertyRowControlStyle}">
                            <xctk:IntegerUpDown Style="{StaticResource FoundationPropertyNumericStyle}" Value="{Binding ButtonMouseSensitivity,FallbackValue=25}" Minimum="0" Maximum="255" Increment="1" AutomationProperties.Name="{lex:Loc MouseSensitivity}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Mouse speed" Style="{StaticResource FoundationPropertySubRowControlStyle}">
                            <TextBlock Text="{Binding OutputMouseSpeed,Mode=OneWay,StringFormat='{}{0} pps'}" Style="{StaticResource FoundationSecondaryTextStyle}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="{lex:Loc MouseVerticalScale}" Style="{StaticResource FoundationPropertyRowControlStyle}" Tag="%">
                            <xctk:IntegerUpDown Style="{StaticResource FoundationPropertyNumericStyle}" Value="{Binding ButtonMouseVerticalScale,FallbackValue='100'}" Minimum="0" Maximum="500" Increment="10" AutomationProperties.Name="{lex:Loc MouseVerticalScale}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="{lex:Loc MouseOffset}" Style="{StaticResource FoundationPropertyRowControlStyle}" Tag="%">
                            <xctk:DoubleUpDown Style="{StaticResource FoundationPropertyNumericStyle}" FormatString="F3" Value="{Binding ButtonMouseOffset,FallbackValue=0,UpdateSourceTrigger=LostFocus}" Minimum="0" Maximum="100" DefaultValue="0" AutomationProperties.Name="{lex:Loc MouseOffset}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Offset speed" Style="{StaticResource FoundationPropertySubRowControlStyle}">
                            <TextBlock Text="{Binding MouseOffsetSpeed,Mode=OneWay,StringFormat='{}{0:0.00} pps'}" Style="{StaticResource FoundationSecondaryTextStyle}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="{Binding Content, ElementName=advancedToggle8}" Style="{StaticResource FoundationPropertyRowControlStyle}">
                            <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" x:Name="advancedToggle8" Content="{lex:Loc MouseAcceleration}" IsChecked="{Binding MouseAcceleration}" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="{Binding Content, ElementName=advancedToggle9}" Style="{StaticResource FoundationPropertyRowControlStyle}" ToolTip="{lex:Loc Resources:EnableTouchToggle}">
                            <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" x:Name="advancedToggle9" Content="{lex:Loc EnableTouchpadToggle}" IsChecked="{Binding EnableTouchpadToggle}" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="{Binding Content, ElementName=advancedToggle10}" Style="{StaticResource FoundationPropertyRowControlStyle}" ToolTip="{lex:Loc SendGameFeedbackToPhysicalControllerTip}">
                            <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" x:Name="advancedToggle10" Content="{lex:Loc SendGameFeedbackToPhysicalController}" IsChecked="{Binding EnableOutputDataToDS4}" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" />
                        </HeaderedContentControl>
                        <TextBlock Text="{lex:Loc SendGameFeedbackToPhysicalControllerTip}" Style="{StaticResource FoundationPropertyNoteStyle}" />
                        <TextBlock Text="Game Bar" Style="{StaticResource FoundationSectionHeadingStyle}" Margin="0,16,0,6" />
                        <HeaderedContentControl Header="{Binding Content, ElementName=advancedToggle11}" Style="{StaticResource FoundationPropertyRowControlStyle}" ToolTip="While Xbox Game Bar is visible, temporarily route this profile&apos;s mapped input through an Xbox-compatible controller. The selected profile and game output stay configured.">
                            <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" x:Name="advancedToggle11" Content="Enable Game Bar controller compatibility" IsChecked="{Binding GameBarControllerCompatibility}" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" />
                        </HeaderedContentControl>
                        <TextBlock Text="Keeps this profile and its native output active. Only mapped input is temporarily sent through an Xbox-compatible companion while Game Bar is open; audio, haptics, lighting, and microphone routing stay untouched." Style="{StaticResource FoundationPropertyNoteStyle}" />
                        <TextBlock Text="Launch and connection" Style="{StaticResource FoundationSectionHeadingStyle}" Margin="0,16,0,6" />
                        <HeaderedContentControl Header="{Binding Content, ElementName=launchProgCk}" Style="{StaticResource FoundationPropertyRowControlStyle}" ToolTip="{Binding ToolTip, ElementName=launchProgCk}">
                            <Grid Width="196">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="2" Style="{StaticResource FoundationToggleSwitchStyle}" x:Name="launchProgCk" Content="{lex:Loc LaunchProgramWithProfile}" IsChecked="{Binding LaunchProgramExists}" IsEnabled="{Binding LaunchProgramExists}" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" />
                                <Button Grid.Column="0" Style="{StaticResource FoundationButtonStyle}" x:Name="launchProgBrowseBtn" Click="LaunchProgBrowseBtn_Click" Margin="0,0,8,0" ToolTip="{Binding LaunchProgramName}">
                                    <Button.Content>
                                        <PriorityBinding>
                                            <Binding Path="LaunchProgramName" />
                                            <lex:BLoc Key="Browse" />
                                        </PriorityBinding>
                                    </Button.Content>
                                </Button>
                                <Border Grid.Column="1" x:Name="launchProgIconBtn" Width="20" Height="20" Margin="0,0,8,0">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding LaunchProgramIcon}" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="{Binding Content, ElementName=advancedToggle1}" Style="{StaticResource FoundationPropertyRowControlStyle}">
                            <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" x:Name="advancedToggle1" Content="{lex:Loc IdleDisconnect}" IsChecked="{Binding IdleDisconnectExists}" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Disconnect after" Style="{StaticResource FoundationPropertySubRowControlStyle}" Visibility="{Binding IdleDisconnectExists, Converter={StaticResource BooleanToVisibilityConverter}}" Tag="mins">
                            <xctk:IntegerUpDown Style="{StaticResource FoundationPropertyNumericStyle}" x:Name="idleDisconnectUD" Value="{Binding IdleDisconnect,FallbackValue=5}" IsEnabled="{Binding IdleDisconnectExists}" Minimum="0" Maximum="60" AutomationProperties.Name="Idle disconnect minutes" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="{lex:Loc DS4BTPollRate}" Style="{StaticResource FoundationPropertyRowControlStyle}" ToolTip="{lex:Loc Resources:BtPollRate}">
                            <ComboBox Style="{StaticResource FoundationPropertyComboStyle}" SelectedIndex="{Binding TempBTPollRateIndex,FallbackValue=4}" AutomationProperties.Name="{lex:Loc DS4BTPollRate}" x:Name="btPollRateCombo">
                                <ComboBoxItem Content="Max (1 ms)" />
                                <ComboBoxItem Content="1000 Hz (1 ms)" />
                                <ComboBoxItem Content="500 Hz (2 ms)" />
                                <ComboBoxItem Content="333 Hz (3 ms)" />
                                <ComboBoxItem Content="250 Hz (4 ms)" />
                                <ComboBoxItem Content="200 Hz (5 ms)" />
                                <ComboBoxItem Content="166 Hz (6 ms)" />
                                <ComboBoxItem Content="142 Hz (7 ms)" />
                                <ComboBoxItem Content="125 Hz (8 ms)" />
                                <ComboBoxItem Content="111 Hz (9 ms)" />
                                <ComboBoxItem Content="100 Hz (10 ms)" />
                                <ComboBoxItem Content="90 Hz (11 ms)" />
                                <ComboBoxItem Content="83 Hz (12 ms)" />
                                <ComboBoxItem Content="76 Hz (13 ms)" />
                                <ComboBoxItem Content="71 Hz (14 ms)" />
                                <ComboBoxItem Content="66 Hz (15 ms)" />
                                <ComboBoxItem Content="62 Hz (16 ms)" />
                            </ComboBox>
                        </HeaderedContentControl>
                        <TextBlock Text="Absolute mouse options" Style="{StaticResource FoundationSectionHeadingStyle}" Margin="0,16,0,6" />
                        <Expander IsExpanded="False" Header="Settings">
                            <StackPanel>
                                <HeaderedContentControl Header="{lex:Loc Width}" Style="{StaticResource FoundationPropertyRowControlStyle}">
                                    <xctk:DoubleUpDown Style="{StaticResource FoundationPropertyNumericStyle}" FormatString="F2" Value="{Binding AbsWidth}" Minimum="0.0" Maximum="1.0" Increment="0.05" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="{lex:Loc Height}" Style="{StaticResource FoundationPropertyRowControlStyle}">
                                    <xctk:DoubleUpDown Style="{StaticResource FoundationPropertyNumericStyle}" FormatString="F2" Value="{Binding AbsHeight}" Minimum="0.0" Maximum="1.0" Increment="0.05" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="{lex:Loc XCenter}" Style="{StaticResource FoundationPropertyRowControlStyle}">
                                    <xctk:DoubleUpDown Style="{StaticResource FoundationPropertyNumericStyle}" FormatString="F2" Value="{Binding AbsXCenter}" Minimum="0.0" Maximum="1.0" Increment="0.05" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="{lex:Loc YCenter}" Style="{StaticResource FoundationPropertyRowControlStyle}">
                                    <xctk:DoubleUpDown Style="{StaticResource FoundationPropertyNumericStyle}" FormatString="F2" Value="{Binding AbsYCenter}" Minimum="0.0" Maximum="1.0" Increment="0.05" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="{lex:Loc AntiRadius}" Style="{StaticResource FoundationPropertyRowControlStyle}" Tag="%">
                                    <xctk:DoubleUpDown Style="{StaticResource FoundationPropertyNumericStyle}" FormatString="F2" Value="{Binding AbsAntiRadius}" Minimum="0.0" Maximum="1.0" Increment="0.05" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="{lex:Loc SnapToCenter}" Style="{StaticResource FoundationPropertyRowControlStyle}">
                                    <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" IsChecked="{Binding AbsSnapCenter}" AutomationProperties.Name="Snap to center" />
                                </HeaderedContentControl>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
