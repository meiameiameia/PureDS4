                                                   Margin="{StaticResource spaceMargin}" />

                                                        <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="{lex:Loc AntiDeadZone}" ContentStringFormat="{}{0}:" Grid.Row="2" Grid.Column="0" />
