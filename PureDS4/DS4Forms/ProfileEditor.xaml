                                        <StackPanel Orientation="Horizontal">
                                            <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" x:Name="swipeUpLb" Content="{Binding MappingName,FallbackValue=Unassigned}" MaxWidth="96" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource FoundationPropertyButtonStyle}" x:Name="swipeUpBtn" Content="Assign" Tag="{Binding SwipeUp, Source={StaticResource controlIndexCheck}}" Click="SwipeControlsButton_Click" AutomationProperties.Name="Assign swipe up" />
                                        </StackPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Swipe down" Style="{StaticResource FoundationPropertyRowControlStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" x:Name="swipeDownLb" Content="{Binding MappingName,FallbackValue=Unassigned}" MaxWidth="96" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource FoundationPropertyButtonStyle}" x:Name="swipeDownBtn" Content="Assign" Tag="{Binding SwipeDown, Source={StaticResource controlIndexCheck}}" Click="SwipeControlsButton_Click" AutomationProperties.Name="Assign swipe down" />
                                        </StackPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Swipe left" Style="{StaticResource FoundationPropertyRowControlStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" x:Name="swipeLeftLb" Content="{Binding MappingName,FallbackValue=Unassigned}" MaxWidth="96" Margin="0,0,8,0" VerticalAlignment="Center" />
