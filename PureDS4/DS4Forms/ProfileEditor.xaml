                                        </StackPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Swipe right" Style="{StaticResource FoundationPropertyRowControlStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" x:Name="swipeRightLb" Content="{Binding MappingName,FallbackValue=Unassigned}" MaxWidth="96" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource FoundationPropertyButtonStyle}" x:Name="swipeRightBtn" Content="Assign" Tag="{Binding SwipeRight, Source={StaticResource controlIndexCheck}}" Click="SwipeControlsButton_Click" AutomationProperties.Name="Assign swipe right" />
                                        </StackPanel>
                                    </HeaderedContentControl>
                                    <TextBlock Text="Touchpad buttons" Style="{StaticResource FoundationSectionHeadingStyle}" Margin="0,16,0,6" />
                                    <HeaderedContentControl Header="Passthru Click Action (DS4 mode)" Style="{StaticResource FoundationPropertyRowControlStyle}">
                                        <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" Content="Passthru Click Action (DS4 mode)" IsChecked="{Binding TouchpadClickPassthru}" AutomationProperties.Name="Passthru Click Action (DS4 mode)" />
                                    </HeaderedContentControl>
                                    <ContentControl x:Name="touchContentControl2" HorizontalAlignment="Stretch" />
