                                                            <CheckBox Style="{StaticResource FoundationFormCheckBoxStyle}" Content="Force" VerticalAlignment="Center" IsChecked="{Binding LSMaxOutputForce}" ToolTip="{lex:Loc StickMaxOutputForceTooltip}" DockPanel.Dock="Right" Margin="8,0,0,0" />
                                                            <xctk:DoubleUpDown Style="{StaticResource FoundationNumericInputStyle}" d:IsHidden="True" Value="{Binding LSMaxOutput}" FormatString="F2" MinWidth="72" Maximum="1.0" Minimum="0.0" Increment="0.1"
