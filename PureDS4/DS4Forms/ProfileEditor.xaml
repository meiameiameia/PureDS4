                                                   Foreground="{DynamicResource MutedForegroundColor}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="editMappingButton" Content="{lex:Loc Edit}"
                                            Style="{StaticResource FoundationButtonStyle}" Margin="8,0,0,0"
                                            VerticalAlignment="Center" AutomationProperties.Name="Edit selected mapping"
                                            IsEnabled="{Binding SelectedItem.IsAvailableOnPhysicalController, ElementName=mappingListBox, FallbackValue=False}"
