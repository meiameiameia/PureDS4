                                            <ComboBoxItem Content="Or" />
                                        </ComboBox>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="X Axis" Style="{StaticResource FoundationPropertyRowControlStyle}">
                                        <ComboBox Style="{StaticResource FoundationPropertyComboStyle}" SelectedIndex="{Binding GyroSwipeXAxis,FallbackValue=0}" AutomationProperties.Name="X Axis">
