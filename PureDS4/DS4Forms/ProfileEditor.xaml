                                            <Label Grid.Row="1" Style="{StaticResource FoundationPropertyLabelStyle}" Content="G" Target="{Binding ElementName=lowGreenSlider}" />
                                            <Slider Grid.Row="1" Grid.Column="1" x:Name="lowGreenSlider" Style="{StaticResource FoundationHorizontalSliderStyle}"
