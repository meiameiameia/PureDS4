                    <StackPanel Width="{Binding ViewportWidth, ElementName=touchpadPropertiesScroll}" MaxWidth="760">
                        <HeaderedContentControl Header="{lex:Loc OutputMode}" Style="{StaticResource FoundationPropertyRowControlStyle}">
                            <ComboBox Style="{StaticResource FoundationPropertyComboStyle}" SelectedIndex="{Binding TouchpadOutputIndex, FallbackValue='0'}" AutomationProperties.Name="{lex:Loc OutputMode}" x:Name="touchpadOutModeCombo">
                                <ComboBoxItem Content="{lex:Loc Mouse}" />
                                <ComboBoxItem Content="{lex:Loc Controls}" />
                                <ComboBoxItem Content="{lex:Loc MouseJoystick}" />
                                <ComboBoxItem Content="{lex:Loc AbsoluteMouse}" />
                                <ComboBoxItem Content="{lex:Loc Passthru}" />
                            </ComboBox>
                        </HeaderedContentControl>
                        <TabControl Style="{StaticResource FoundationContentTabsStyle}" x:Name="touchOutputTabControl" SelectedIndex="{Binding TouchpadOutputIndex, FallbackValue='0'}" BorderBrush="{x:Null}" Padding="0" Margin="0,0,0,8">
                            <TabItem Header="{lex:Loc Mouse}" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Gestures" Style="{StaticResource FoundationSectionHeadingStyle}" Margin="0,16,0,6" />
                                    <HeaderedContentControl Header="{Binding Content, ElementName=touchSlideToggle}" Style="{StaticResource FoundationPropertyRowControlStyle}">
                                        <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" x:Name="touchSlideToggle" Content="{lex:Loc TouchSlide}" IsChecked="{Binding TouchSenExists}" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Sensitivity" Style="{StaticResource FoundationPropertySubRowControlStyle}" Visibility="{Binding TouchSenExists, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <xctk:IntegerUpDown Style="{StaticResource FoundationPropertyNumericStyle}" Value="{Binding TouchSens}" Maximum="500" IsEnabled="{Binding TouchSenExists}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="{Binding Content, ElementName=touchJitterToggle}" Style="{StaticResource FoundationPropertyRowControlStyle}" ToolTip="{lex:Loc TouchpadJitterCompTooltip}">
                                        <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" x:Name="touchJitterToggle" Content="Jitter Compensation" IsChecked="{Binding TouchJitter}" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="{Binding Content, ElementName=touchTapToggle}" Style="{StaticResource FoundationPropertyRowControlStyle}" ToolTip="{lex:Loc TouchpadTapTooltip}">
                                        <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" x:Name="touchTapToggle" Content="{lex:Loc TouchTap}" IsChecked="{Binding TouchTapExists}" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Maximum interval" Style="{StaticResource FoundationPropertySubRowControlStyle}" Visibility="{Binding TouchTapExists, Converter={StaticResource BooleanToVisibilityConverter}}" Tag="x2 ms" ToolTip="{lex:Loc TouchpadTapTooltip}">
                                        <xctk:IntegerUpDown Style="{StaticResource FoundationPropertyNumericStyle}" Value="{Binding TouchTap}" IsEnabled="{Binding TouchTapExists}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="{Binding Content, ElementName=touchDoubleTapToggle}" Style="{StaticResource FoundationPropertyRowControlStyle}" ToolTip="{lex:Loc Resources:TapAndHold}">
                                        <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" x:Name="touchDoubleTapToggle" Content="Double Tap" IsChecked="{Binding TouchDoubleTap}" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="{Binding Content, ElementName=touchScrollToggle}" Style="{StaticResource FoundationPropertyRowControlStyle}" ToolTip="{lex:Loc TouchpadSlideTooltip}">
                                        <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" x:Name="touchScrollToggle" Content="{lex:Loc TouchScroll}" IsChecked="{Binding TouchScrollExists}" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Sensitivity" Style="{StaticResource FoundationPropertySubRowControlStyle}" Visibility="{Binding TouchScrollExists, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{lex:Loc TouchpadSlideTooltip}">
                                        <xctk:IntegerUpDown Style="{StaticResource FoundationPropertyNumericStyle}" Value="{Binding TouchScroll}" IsEnabled="{Binding TouchScrollExists}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="{Binding Content, ElementName=touchRightClickToggle}" Style="{StaticResource FoundationPropertyRowControlStyle}" ToolTip="{lex:Loc Resources:BestUsedRightSide}">
                                        <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" x:Name="touchRightClickToggle" Content="Lower Right as RMB" IsChecked="{Binding LowerRightTouchRMB}" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="{Binding Content, ElementName=touchClickPassthroughToggle}" Style="{StaticResource FoundationPropertyRowControlStyle}">
                                        <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" x:Name="touchClickPassthroughToggle" Content="Passthru Click Action (DS4 mode)" IsChecked="{Binding TouchpadClickPassthru}" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Start with Slide/Scroll Off" Style="{StaticResource FoundationPropertyRowControlStyle}" ToolTip="{lex:Loc Resources:TouchpadOffTip}">
                                        <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" Content="Start with Slide/Scroll Off" IsChecked="{Binding StartTouchpadOff}" AutomationProperties.Name="Start with Slide/Scroll Off" />
                                    </HeaderedContentControl>
                                    <TextBlock Text="Movement" Style="{StaticResource FoundationSectionHeadingStyle}" Margin="0,16,0,6" />
