                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource FoundationNavigationListItemStyle}">
                                        <Setter Property="Padding" Value="8,4" />
                                        <Setter Property="MinHeight" Value="40" />
                                        <Setter Property="IsEnabled" Value="{Binding IsAvailableOnPhysicalController}" />
                                        <Setter Property="ToolTip" Value="{Binding PhysicalControllerAvailabilityHint}" />
                                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ControlName}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding MappingName}" Margin="0,3,0,0" FontSize="11"
                                                           Foreground="{DynamicResource AccentColor}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding MappingName}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        Margin="12,0,2,0" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource RaisedBackgroundColor}"
                                                        BorderBrush="{DynamicResource AccentColor}"
                                                        BorderThickness="1" CornerRadius="3"
                                                        Padding="6,2" Margin="0,0,7,0"
                                                        Visibility="{Binding IsControllerMapListOnly, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="LIST ONLY" FontSize="8" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentColor}" />
                                                </Border>
                                                <TextBlock Text="&#x203A;" FontSize="21"
                                                           Foreground="{DynamicResource MutedForegroundColor}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem x:Name="specialActionsTab" Header="Special Actions">
                <DockPanel x:Name="specialActionDockPanel">
                    <DockPanel x:Name="baseSpeActPanel" DockPanel.Dock="Top">
                        <WrapPanel DockPanel.Dock="Top">
                            <Button Style="{StaticResource FoundationButtonStyle}" x:Name="newActionBtn" Content="{lex:Loc NewAction}" Margin="0,0,5,0" Click="NewActionBtn_Click" />
                            <Button Style="{StaticResource FoundationButtonStyle}" x:Name="editActionBtn" Content="{lex:Loc EditAction}" IsEnabled="{Binding ItemSelected}" Margin="5,0" Click="EditActionBtn_Click" />
                            <Button Style="{StaticResource FoundationButtonStyle}" x:Name="removeActionBtn" Content="{lex:Loc RemoveAction}" IsEnabled="{Binding ItemSelected}" Margin="5,0,0,0" Click="RemoveActionBtn_Click" />
                            <Button Style="{StaticResource FoundationButtonStyle}" Content="{lex:Loc ExportSpecialActions}" Margin="5 0 0 0" Click="ExportSpecialActions_OnClick"/>
                        </WrapPanel>

                        <!-- The inherited GridView drew centred headers over left-aligned
                             cells and stopped two thirds of the way across the table. This
                             is the same header/row pattern the profile list uses. -->
                        <ListView x:Name="specialActionsLV" ItemsSource="{Binding ActionCol}"
                                  SelectedIndex="{Binding SpecialActionIndex}"
                                  SelectedItem="{Binding CurrentSpecialActionItem,Mode=OneWayToSource}"
                                  AutomationProperties.Name="Special actions"
                                  Style="{StaticResource FoundationTableListViewStyle}"
                                  ItemContainerStyle="{StaticResource FoundationTableListItemStyle}"
                                  DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <ListView.Template>
                                <ControlTemplate TargetType="ListView">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="28" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="12,0,12,0" HorizontalAlignment="Left"
                                                    Width="{Binding ViewportWidth, ElementName=SpecialActionRowsScroll}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="200" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{lex:Loc Name}" Style="{StaticResource FoundationColumnHeaderStyle}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{lex:Loc Trigger}" Style="{StaticResource FoundationColumnHeaderStyle}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{lex:Loc Action}" Style="{StaticResource FoundationColumnHeaderStyle}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <ScrollViewer x:Name="SpecialActionRowsScroll" Grid.Row="1" Focusable="False" Padding="0"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsPresenter SnapsToDevicePixels="True" />
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ListView.Template>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="200" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Style="{StaticResource FoundationFormCheckBoxStyle}" IsChecked="{Binding Active}"
                                                      AutomationProperties.Name="Action enabled"
                                                      VerticalAlignment="Center" Click="SpecialActionCheckBox_Click" />
                                            <TextBlock Text="{Binding ActionName}" Margin="6,0,8,0" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ActionName}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Controls}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Controls}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding TypeName}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding TypeName}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="contReadingsTab" Header="Controller Readings" IsEnabled="False">
                <local:ControllerReadingsControl x:Name="conReadingsUserCon" />
