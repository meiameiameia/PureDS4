                                        <ComboBoxItem Content="{lex:Loc Controls}" />
                                        <ComboBoxItem Content="{lex:Loc FlickStick}" />
                                    </ComboBox>
                                </WrapPanel>

                                <TabControl Style="{StaticResource FoundationContentTabsStyle}" SelectedIndex="{Binding LSOutputIndex,Mode=OneWay,FallbackValue='0'}" BorderBrush="{x:Null}" Padding="0" Margin="0,10,0,0">
