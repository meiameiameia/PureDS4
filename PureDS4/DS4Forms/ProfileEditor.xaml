                                </Grid>
                            </Border>

                            <ListBox Grid.Row="1" x:Name="mappingListBox" ItemsSource="{Binding Mappings}"
                                     SelectedIndex="{Binding SelectedIndex}" Background="Transparent"
                                     BorderThickness="0" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
