                                                                </TextBlock>
                                                            </xctk:DoubleUpDown.ToolTip>
                                                        </xctk:DoubleUpDown>

                                                        <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="{lex:Loc MaxOutput}" ContentStringFormat="{}{0}:" Grid.Row="3" Grid.Column="0" />
