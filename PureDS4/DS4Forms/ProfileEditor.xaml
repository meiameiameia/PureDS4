                                                   Margin="{StaticResource spaceMargin}" />

                                                        <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="{lex:Loc Sensitivity}" ContentStringFormat="{}{0}:" Grid.Row="5" Grid.Column="0" />
                                                        <xctk:DoubleUpDown Style="{StaticResource FoundationNumericInputStyle}" d:IsHidden="True" FormatString="F2" Value="{Binding LSSens}" MinWidth="72" Grid.Row="5" Grid.Column="1" Maximum="5.0" Minimum="0.1" Increment="0.1"
                                                   Margin="{StaticResource spaceMargin}" />

                                                    </Grid>
                                                </TabItem>

                                                <TabItem Header="{lex:Loc Axial}" Visibility="Collapsed">
