                                                       Style="{StaticResource FoundationSecondaryTextStyle}" />
                                        </Grid>
                                        <Button x:Name="lowColorBtn" Width="28" Height="28" Background="{Binding LowColor}" HorizontalAlignment="Left"
                                                Margin="0,8,0,0" Click="LowColorBtn_Click" AutomationProperties.Name="Empty battery colour"
                                                ToolTip="Choose the colour used when the battery is empty" />
                                    </StackPanel>
                                </GroupBox>
                                <TextBlock Text="Battery and charging" Style="{StaticResource FoundationSectionHeadingStyle}" Margin="0,0,0,6" />
                                <Border Style="{StaticResource FoundationSettingRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Battery alert" Style="{StaticResource FoundationSettingTitleStyle}" />
                                            <TextBlock Text="Mode, threshold, and colour." Style="{StaticResource FoundationSettingDescriptionStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ComboBox Style="{StaticResource FoundationComboBoxStyle}" x:Name="flashTypeCombo" Width="100"
                                                      SelectedIndex="{Binding FlashTypeIndex,FallbackValue=0}" AutomationProperties.Name="Battery alert mode">
                                                <ComboBoxItem Content="Flash at" />
                                                <ComboBoxItem Content="Pulse at" />
                                            </ComboBox>
                                            <xctk:IntegerUpDown x:Name="flashAtInput" Style="{StaticResource FoundationNumericInputStyle}"
                                                               Value="{Binding FlashAt,FallbackValue=0}" Width="72" Margin="8,0,0,0"
                                                               VerticalAlignment="Center" AutomationProperties.Name="Flash at battery percentage"
                                                               Minimum="-10" Maximum="100" Increment="10" />
                                            <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="%" Margin="4,0,0,0" />
                                            <Button x:Name="flashColorBtn" Width="28" Height="28" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Background="{Binding FlashColor,FallbackValue=Blue}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                    BorderThickness="1" AutomationProperties.Name="Flash colour"
                                                    ToolTip="{lex:Loc Resources:FlashAtTip}" Click="FlashColorBtn_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource FoundationSettingRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="While charging" Style="{StaticResource FoundationSettingTitleStyle}"
                                                   VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ComboBox x:Name="chargingTypeCombo" Style="{StaticResource FoundationComboBoxStyle}" Width="140"
                                                      SelectedIndex="{Binding ChargingType,FallbackValue=0}" AutomationProperties.Name="Lightbar while charging">
                                                <ComboBoxItem Content="Normal" />
                                                <ComboBoxItem Content="Pulse" />
                                                <ComboBoxItem Content="Rainbow" />
                                                <ComboBoxItem Content="Color" />
                                            </ComboBox>
                                            <Button x:Name="chargingColorBtn" Width="28" Height="28" VerticalAlignment="Center"
                                                    Background="{Binding ChargingColor,FallbackValue=Blue}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                    BorderThickness="1" AutomationProperties.Name="Charging colour" ToolTip="Choose the colour used while charging"
                                                    Visibility="{Binding ChargingColorVisible}" Click="ChargingColorBtn_Click" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Effects" Style="{StaticResource FoundationSectionHeadingStyle}" />
                                <Border Style="{StaticResource FoundationSettingRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Rainbow" Style="{StaticResource FoundationSettingTitleStyle}" />
                                            <TextBlock Text="Cycle through colours." Style="{StaticResource FoundationSettingDescriptionStyle}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="rainbowBtn" MinWidth="80" VerticalAlignment="Center"
                                                AutomationProperties.Name="Toggle rainbow lightbar" ToolTip="{lex:Loc Resources:AlwaysRainbow}" Click="RainbowBtn_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource FoundationButtonStyle}">
                                                    <Setter Property="Content" Value="Turn on" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RainbowExists}" Value="True">
                                                            <Setter Property="Content" Value="Turn off" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource FoundationSettingSubRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Cycle duration" Style="{StaticResource FoundationSettingTitleStyle}"
                                                   VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <xctk:IntegerUpDown x:Name="rainbowCycleInput" Style="{StaticResource FoundationNumericInputStyle}" Width="72"
                                                               Minimum="0" Maximum="60" Increment="1" VerticalAlignment="Center"
                                                               AutomationProperties.Name="Rainbow seconds per cycle"
                                                               Value="{Binding Rainbow,FallbackValue=5}" IsEnabled="{Binding RainbowExists}" />
                                            <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="secs/cycle" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource FoundationSettingSubRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Maximum light" Style="{StaticResource FoundationSettingTitleStyle}"
                                                   VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider x:Name="rainbowLightSlider" Style="{StaticResource FoundationHorizontalSliderStyle}"
                                                    Value="{Binding MaxSatRainbow,FallbackValue=100}" Minimum="0" Maximum="100" Width="140"
                                                    AutomationProperties.Name="Rainbow maximum light percentage" IsEnabled="{Binding RainbowExists}" />
                                            <TextBlock Text="{Binding MaxSatRainbow,FallbackValue=100,StringFormat={}{0:N2}%}" Width="64" TextAlignment="Right"
                                                       VerticalAlignment="Center" Style="{StaticResource FoundationSecondaryTextStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="{lex:Loc Passthru}" Visibility="Collapsed">
                            <TextBlock Text="Profile lightbar effects are not applied in passthrough mode."
                                       Style="{StaticResource FoundationSecondaryTextStyle}" TextWrapping="Wrap" Margin="12,0" />
                        </TabItem>
                    </TabControl>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{lex:Loc Touchpad}" Tag="Mouse, controls, gestures, and absolute positioning">
                <TabItem.Resources>
                    <Thickness x:Key="spaceMargin" Bottom="8" />
                </TabItem.Resources>
                <ScrollViewer x:Name="touchpadPropertiesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
