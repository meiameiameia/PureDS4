                                </StackPanel>

                                <Button Style="{StaticResource FoundationButtonStyle}" x:Name="heavyRumbleTestBtn" Content="{lex:Loc TestHeavy}" Margin="0,0,8,8" Click="RumbleTestBtn_Click" />
                                <Button Style="{StaticResource FoundationButtonStyle}" x:Name="lightRumbleTestBtn" Content="{lex:Loc TestLight}" Margin="0,0,8,8" Click="RumbleTestBtn_Click" />
                            </WrapPanel>
                                <CheckBox Style="{StaticResource FoundationCheckBoxStyle}" Content="{lex:Loc InverseMotors}" IsChecked="{Binding InverseRumbleMotors}" />


                            </StackPanel>
                        </GroupBox>
                        <GroupBox Style="{StaticResource FoundationGroupBoxStyle}" Header="PlayStation controller features" MinHeight="50" Margin="4,4,4,0" Padding="0,4,0,4"
                                  Visibility="{Binding ShowPlayStationControllerSettings, Converter={StaticResource BooleanToVisibilityConverter}}">

                            <StackPanel>
                                <GroupBox Style="{StaticResource FoundationGroupBoxStyle}" Header="{Binding ControllerAudioHeader}" Margin="0,10,0,0" Padding="8,5"
                                  Visibility="{Binding ShowControllerAudioSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding ControllerAudioDescription}" Margin="2,0,2,7"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedForegroundColor}" />
                                <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" MinHeight="40" />
                                    <RowDefinition Height="Auto" MinHeight="40" />
                                    <RowDefinition Height="Auto" MinHeight="40" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" MinHeight="40" />
                                    <RowDefinition Height="Auto" MinHeight="40" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="{StaticResource FormLabelColumnWidth}" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
                                    <CheckBox Style="{StaticResource FoundationCheckBoxStyle}" Content="Stream audio to controller" IsChecked="{Binding DualSenseEnableSpeakerOutput}"
                                              Margin="{StaticResource spaceMargin}"
                                              ToolTip="Streams the selected audio to the controller. Uses its built-in speaker unless Headset only routes it exclusively to the AUX port." />
                                    <CheckBox Style="{StaticResource FoundationCheckBoxStyle}" Content="Headset only (mute controller speaker)"
                                              IsChecked="{Binding DualSenseHeadsetOnlyAudio}"
                                              IsEnabled="{Binding DualSenseEnableSpeakerOutput}"
                                              Margin="20,2,3,7"
                                              ToolTip="Mutes the built-in speaker while continuing the same stream through a headset connected to the controller's AUX port." />
                                </StackPanel>
                                <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="Audio source:" Grid.Row="1" Grid.Column="0"
                                       ToolTip="For game audio, select the virtual Wireless Controller endpoint created by a PlayStation game output. The first stereo pair is mirrored to the physical controller speaker." />
                                <ComboBox Style="{StaticResource FoundationComboBoxStyle}" ItemsSource="{Binding AudioCaptureEndpointChoices}" DisplayMemberPath="Name" SelectedValuePath="EndpointId"
                                          SelectedValue="{Binding DualSenseAudioCaptureEndpointId}" Grid.Row="1" Grid.Column="1"
                                          Margin="{StaticResource spaceMargin}" />
                                <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="Speaker volume:" Grid.Row="4" Grid.Column="0" />
                                <xctk:IntegerUpDown Style="{StaticResource FoundationNumericInputStyle}" Value="{Binding DualSenseSpeakerVolume}" Minimum="0" Maximum="255" Grid.Row="4" Grid.Column="1"
                                                    Margin="{StaticResource spaceMargin}" />
                                <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="Dynamic range:" Grid.Row="5" Grid.Column="0"
                                       ToolTip="Bluetooth speaker processing. Balanced raises quieter details and restrains loud effects. Strong narrows the range further. Processing is applied before native SBC encoding without look-ahead latency." />
                                <ComboBox Style="{StaticResource FoundationComboBoxStyle}" SelectedIndex="{Binding DualSenseSpeakerCompressionIndex}" Grid.Row="5" Grid.Column="1"
                                          Margin="{StaticResource spaceMargin}">
                                    <ComboBoxItem Content="Off" />
                                    <ComboBoxItem Content="Balanced" />
                                    <ComboBoxItem Content="Strong" />
                                    <ComboBoxItem Content="NVIDIA AI"
                                                  IsEnabled="{Binding NvidiaNoiseSuppressionAvailable}"
                                                  ToolTip="{Binding NvidiaNoiseSuppressionAvailability}" />
                                </ComboBox>
                                <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="Bass/body boost:" Grid.Row="6" Grid.Column="0"
                                       ToolTip="Adds up to 6 dB around 200 Hz while filtering unusable sub-bass. Applies only to the Bluetooth controller speaker stream." />
                                <xctk:IntegerUpDown Style="{StaticResource FoundationNumericInputStyle}" Value="{Binding DualSenseSpeakerBassBoost}" Minimum="0" Maximum="6" Grid.Row="6" Grid.Column="1"
                                                    Margin="{StaticResource spaceMargin}" />
                                <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Margin="{StaticResource spaceMargin}">
                                    <CheckBox Style="{StaticResource FoundationCheckBoxStyle}" Content="{Binding ControllerMicrophoneToggleLabel}"
                                              IsChecked="{Binding DualSenseEnableMicrophonePassthrough}"
                                              IsEnabled="{Binding CanChangeControllerMicrophoneInput}"
                                              ToolTip="{Binding ControllerMicrophoneDescription}" />
                                    <TextBlock Text="{Binding ControllerMicrophoneAvailabilityText}"
                                               Visibility="{Binding ShowControllerMicrophoneAvailabilityMessage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Margin="20,4,0,3" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedForegroundColor}" />
                                </StackPanel>
                                <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="Microphone level:" Grid.Row="8" Grid.Column="0"
                                       IsEnabled="{Binding ControllerMicrophoneLevelControlsEnabled}"
                                       ToolTip="Adjusts the physical microphone level and the safely trimmed signal exposed to Windows." />
                                <xctk:IntegerUpDown Style="{StaticResource FoundationNumericInputStyle}" Value="{Binding DualSenseMicrophoneVolume}" Minimum="0" Maximum="255" Grid.Row="8" Grid.Column="1"
                                                    IsEnabled="{Binding ControllerMicrophoneLevelControlsEnabled}"
                                                    Margin="{StaticResource spaceMargin}" />
                                <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="Noise suppression:" Grid.Row="9" Grid.Column="0"
                                       IsEnabled="{Binding ControllerMicrophoneLevelControlsEnabled}"
                                       ToolTip="Balanced applies RNNoise speech cleanup. Strong also reduces low-level residual noise. Off retains only gain, high-pass, and clipping protection." />
                                <ComboBox Style="{StaticResource FoundationComboBoxStyle}" SelectedIndex="{Binding DualSenseMicrophoneNoiseSuppressionIndex}" Grid.Row="9" Grid.Column="1"
                                          IsEnabled="{Binding ControllerMicrophoneLevelControlsEnabled}"
                                          Margin="{StaticResource spaceMargin}">
                                    <ComboBoxItem Content="Off" />
                                    <ComboBoxItem Content="Balanced" />
                                    <ComboBoxItem Content="Strong" />
                                </ComboBox>
                                </Grid>

                                <Expander Header="Advanced audio" Margin="2,8,2,0">
                                    <StackPanel Margin="8,6,2,2">
                                        <Grid MinHeight="30">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="{StaticResource FormLabelColumnWidth}" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="Headset / AUX volume:" Grid.Column="0"
                                                   ToolTip="Controls the headset jack independently from the controller speaker. DualShock 4 maps the full slider range to Sony's documented 0-80 headset gain." />
                                            <xctk:IntegerUpDown Style="{StaticResource FoundationNumericInputStyle}" Value="{Binding DualSenseHeadphoneVolume}" Minimum="0" Maximum="255"
                                                                Grid.Column="1" Margin="{StaticResource spaceMargin}" />
                                        </Grid>

                                        <Grid Margin="0,6,0,0"
                                              Visibility="{Binding ShowLegacyMicrophoneRouting, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" MinHeight="40" />
                                                <RowDefinition Height="Auto" MinHeight="40" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="{StaticResource FormLabelColumnWidth}" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.ColumnSpan="2" Margin="3,0,3,5"
                                                       Text="USB/legacy microphone routing captures the physical Windows controller-mic endpoint and sends it to a virtual audio render device such as VB-CABLE Input. Bluetooth virtual-microphone routing does not need these endpoints."
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedForegroundColor}" />
                                            <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="Controller mic:" Grid.Row="1" Grid.Column="0" />
                                            <ComboBox Style="{StaticResource FoundationComboBoxStyle}" ItemsSource="{Binding MicrophoneCaptureEndpointChoices}" DisplayMemberPath="Name" SelectedValuePath="EndpointId"
                                                      SelectedValue="{Binding DualSenseMicrophoneCaptureEndpointId}" Grid.Row="1" Grid.Column="1"
                                                      Margin="{StaticResource spaceMargin}" />
                                            <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="Virtual output:" Grid.Row="2" Grid.Column="0" />
                                            <ComboBox Style="{StaticResource FoundationComboBoxStyle}" ItemsSource="{Binding MicrophoneOutputEndpointChoices}" DisplayMemberPath="Name" SelectedValuePath="EndpointId"
                                                      SelectedValue="{Binding DualSenseMicrophoneOutputEndpointId}" Grid.Row="2" Grid.Column="1"
                                                      Margin="{StaticResource spaceMargin}" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                                </GroupBox>
                            </StackPanel>

                        </GroupBox>
                        <WrapPanel Margin="0,8,0,0">
                            <Label Style="{StaticResource FoundationFormLabelStyle}" Content="{lex:Loc UseController}" ToolTip="{lex:Loc Resources:UseControllerForMapping}" />
                            <xctk:IntegerUpDown Style="{StaticResource FoundationNumericInputStyle}" x:Name="useControllerUD" d:IsHidden="True" Width="40" Margin="8,0,0,0"
                                            Value="0" Minimum="0" Maximum="4" IsEnabled="False"
                                            ToolTip="{lex:Loc Resources:UseControllerForMapping}" />
                            <CheckBox Style="{StaticResource FoundationCheckBoxStyle}" x:Name="useControllerReadoutCk" FlowDirection="RightToLeft" Content="for readout" VerticalAlignment="Center"
                                  Margin="8,0,0,0" IsChecked="{Binding UseControllerReadout}"
                                  ToolTip="{lex:Loc Resources:UseControllerForMapping}" Click="UseControllerReadoutCk_Click">
                                <CheckBox.Resources>
                                    <Style TargetType="{x:Type Path}">
                                        <Setter Property="FlowDirection" Value="LeftToRight"/>
                                    </Style>
                                </CheckBox.Resources>
                            </CheckBox>
                        </WrapPanel>
                        <WrapPanel Margin="0,4,0,0">
                            <Label Style="{StaticResource FoundationFormLabelStyle}" Content="{lex:Loc MouseSensitivity}" VerticalAlignment="Center" />
                            <xctk:IntegerUpDown Style="{StaticResource FoundationNumericInputStyle}" d:IsHidden="True" MinWidth="72"
                                            Value="{Binding ButtonMouseSensitivity,FallbackValue=25}"
                                            Minimum="0" Maximum="255" Increment="1" Margin="10,0,0,0" />
                            <TextBlock Text="{Binding OutputMouseSpeed,Mode=OneWay,StringFormat='\{0} pps'}"
                                   MinWidth="50" VerticalAlignment="Center"  Margin="10,0,0,0" />
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <Label Style="{StaticResource FoundationFormLabelStyle}" Content="{lex:Loc MouseVerticalScale}" ContentStringFormat="{}{0}:" VerticalAlignment="Center" />
                            <xctk:IntegerUpDown Style="{StaticResource FoundationNumericInputStyle}" d:IsHidden="True" MinWidth="72"
                            Value="{Binding ButtonMouseVerticalScale,FallbackValue='100'}"
                            Minimum="0" Maximum="500" Increment="10" Margin="10,0,0,0" />
                            <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="%" VerticalContentAlignment="Center" Margin="4,0,0,0" />
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <Label Style="{StaticResource FoundationFormLabelStyle}" Content="{lex:Loc MouseOffset}" VerticalAlignment="Center" />
                            <xctk:DoubleUpDown Style="{StaticResource FoundationNumericInputStyle}" d:IsHidden="True" MinWidth="72" FormatString="F3" DefaultValue="0" Minimum="0" Maximum="100"
                                           Value="{Binding ButtonMouseOffset,FallbackValue=0,UpdateSourceTrigger=LostFocus}" />
                            <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="%" Margin="4,0,0,0" />
                            <TextBlock Text="{Binding MouseOffsetSpeed,Mode=OneWay,StringFormat='\{0:0.00} pps'}"
                                   MinWidth="50" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </WrapPanel>
                        <CheckBox Style="{StaticResource FoundationCheckBoxStyle}" Content="{lex:Loc MouseAcceleration}" IsChecked="{Binding MouseAcceleration}" Margin="0,6,0,0" />
                        <CheckBox Style="{StaticResource FoundationCheckBoxStyle}" Content="{lex:Loc EnableTouchpadToggle}" IsChecked="{Binding EnableTouchpadToggle}" Margin="0,6,0,0"
                              ToolTip="{lex:Loc Resources:EnableTouchToggle}" />
                        <StackPanel Margin="0,8,0,2">
                            <CheckBox Style="{StaticResource FoundationCheckBoxStyle}" Content="{lex:Loc SendGameFeedbackToPhysicalController}"
                                      IsChecked="{Binding EnableOutputDataToDS4}"
                                      FontWeight="SemiBold"
                                      ToolTip="{lex:Loc SendGameFeedbackToPhysicalControllerTip}" />
                            <TextBlock Text="{lex:Loc SendGameFeedbackToPhysicalControllerTip}"
                                       Margin="20,4,8,0"
                                       MaxWidth="560"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundColor}" />
                        </StackPanel>
                        <GroupBox Style="{StaticResource FoundationGroupBoxStyle}" Header="Game Bar" Margin="0,8,0,0" Padding="2,4">
                            <StackPanel>
                                <CheckBox Style="{StaticResource FoundationCheckBoxStyle}" Content="Enable Game Bar controller compatibility" IsChecked="{Binding GameBarControllerCompatibility}"
                                          Margin="{StaticResource spaceMargin}"
                                          ToolTip="While Xbox Game Bar is visible, temporarily route this profile's mapped input through an Xbox-compatible controller. The selected profile and native DualSense output stay configured." />
                                <TextBlock Margin="8,0,8,6" TextWrapping="Wrap"
                                           Text="Keeps this profile and its native output active. Only mapped input is temporarily sent through an Xbox-compatible companion while Game Bar is open; audio, haptics, lighting, and microphone routing stay untouched." />
                            </StackPanel>
                        </GroupBox>
                        <WrapPanel Margin="0,6,0,0">
                            <CheckBox Style="{StaticResource FoundationFormCheckBoxStyle}" x:Name="launchProgCk" Content="{lex:Loc LaunchProgramWithProfile}" IsChecked="{Binding LaunchProgramExists}" IsEnabled="{Binding LaunchProgramExists}" />
                            <Button Style="{StaticResource FoundationButtonStyle}" x:Name="launchProgBrowseBtn" Click="LaunchProgBrowseBtn_Click" Width="80" Height="30" Margin="20,0,0,0">
                                <Button.Content>
                                    <PriorityBinding>
                                        <Binding Path="LaunchProgramName" />
                                        <lex:BLoc Key="Browse" />
                                    </PriorityBinding>
                                </Button.Content>
                            </Button>
                            <Border x:Name="launchProgIconBtn" Width="20" Height="20" Margin="20,0,0,0">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding LaunchProgramIcon}" />
                                </Border.Background>
                            </Border>
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <CheckBox Style="{StaticResource FoundationFormCheckBoxStyle}" Content="{lex:Loc IdleDisconnect}" VerticalAlignment="Center" IsChecked="{Binding IdleDisconnectExists}" />
                            <xctk:IntegerUpDown Style="{StaticResource FoundationNumericInputStyle}" x:Name="idleDisconnectUD" d:IsHidden="True" Value="{Binding IdleDisconnect,FallbackValue=5}"
                                            IsEnabled="{Binding IdleDisconnectExists}" MinWidth="72" Minimum="0" Maximum="60" Margin="10,0,0,0" />
                            <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="mins" />
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <Label Style="{StaticResource FoundationFormLabelStyle}" Content="{lex:Loc DS4BTPollRate}" ContentStringFormat="{}{0}:" ToolTip="{lex:Loc Resources:BtPollRate}" />
                            <ComboBox Style="{StaticResource FoundationComboBoxStyle}" x:Name="btPollRateCombo" SelectedIndex="{Binding TempBTPollRateIndex,FallbackValue=4}" MinWidth="140"
                                  ToolTip="{lex:Loc Resources:BtPollRate}" Margin="8,0,0,0">
                                <ComboBoxItem Content="Max (1 ms)" />
                                <ComboBoxItem Content="1000 Hz (1 ms)" />
                                <ComboBoxItem Content="500 Hz (2 ms)" />
                                <ComboBoxItem Content="333 Hz (3 ms)" />
                                <ComboBoxItem Content="250 Hz (4 ms)" />
                                <ComboBoxItem Content="200 Hz (5 ms)" />
                                <ComboBoxItem Content="166 Hz (6 ms)" />
                                <ComboBoxItem Content="142 Hz (7 ms)" />
                                <ComboBoxItem Content="125 Hz (8 ms)" />
                                <ComboBoxItem Content="111 Hz (9 ms)" />
                                <ComboBoxItem Content="100 Hz (10 ms)" />
                                <ComboBoxItem Content="90 Hz (11 ms)" />
                                <ComboBoxItem Content="83 Hz (12 ms)" />
                                <ComboBoxItem Content="76 Hz (13 ms)" />
                                <ComboBoxItem Content="71 Hz (14 ms)" />
                                <ComboBoxItem Content="66 Hz (15 ms)" />
                                <ComboBoxItem Content="62 Hz (16 ms)" />
                            </ComboBox>
                        </WrapPanel>

                        <GroupBox Style="{StaticResource FoundationGroupBoxStyle}" Header="{lex:Loc AbsoluteMouseOptions}" Margin="0,8,0,0">
                            <StackPanel Orientation="Vertical">
                                <Expander IsExpanded="False" Header="Settings">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="{StaticResource FormLabelColumnWidth}" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>

                                        <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="{lex:Loc Width}" ContentStringFormat="{}{0}:" Grid.Row="0" Grid.Column="0" />
                                        <xctk:DoubleUpDown Style="{StaticResource FoundationNumericInputStyle}" d:IsHidden="True" FormatString="F2" Value="{Binding AbsWidth}"
                                            MinWidth="100" Minimum="0.0" Maximum="1.0" Increment="0.05"
                                            Margin="{StaticResource spaceMargin}" Grid.Row="0" Grid.Column="1" />

                                        <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="{lex:Loc Height}" ContentStringFormat="{}{0}:" Grid.Row="1" Grid.Column="0" />
                                        <xctk:DoubleUpDown Style="{StaticResource FoundationNumericInputStyle}" d:IsHidden="True" FormatString="F2" Value="{Binding AbsHeight}"
                                            MinWidth="100" Minimum="0.0" Maximum="1.0" Increment="0.05"
                                            Margin="{StaticResource spaceMargin}" Grid.Row="1" Grid.Column="1" />

                                        <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="{lex:Loc XCenter}" ContentStringFormat="{}{0}:" Grid.Row="2" Grid.Column="0" />
                                        <xctk:DoubleUpDown Style="{StaticResource FoundationNumericInputStyle}" d:IsHidden="True" FormatString="F2" Value="{Binding AbsXCenter}"
                                            MinWidth="100" Minimum="0.0" Maximum="1.0" Increment="0.05"
                                            Margin="{StaticResource spaceMargin}" Grid.Row="2" Grid.Column="1" />

                                        <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="{lex:Loc YCenter}" ContentStringFormat="{}{0}:" Grid.Row="3" Grid.Column="0" />
                                        <xctk:DoubleUpDown Style="{StaticResource FoundationNumericInputStyle}" d:IsHidden="True" FormatString="F2" Value="{Binding AbsYCenter}"
                                            MinWidth="100" Minimum="0.0" Maximum="1.0" Increment="0.05"
                                            Margin="{StaticResource spaceMargin}" Grid.Row="3" Grid.Column="1" />

                                        <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="{lex:Loc AntiRadius}" ContentStringFormat="{}{0}:" Grid.Row="4" Grid.Column="0" />
                                        <DockPanel Grid.Row="4" Grid.Column="1">
                                            <TextBlock Text="%" DockPanel.Dock="Right" Margin="{StaticResource spaceMargin}" VerticalAlignment="Center" />
                                            <xctk:DoubleUpDown Style="{StaticResource FoundationNumericInputStyle}" d:IsHidden="True" FormatString="F2" Value="{Binding AbsAntiRadius}"
                                                MinWidth="100" Minimum="0.0" Maximum="1.0" Increment="0.05"
                                                Margin="{StaticResource spaceMargin}" />
                                        </DockPanel>

                                        <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="{lex:Loc SnapToCenter}" ContentStringFormat="{}{0}:" Grid.Row="5" Grid.Column="0" />
                                        <CheckBox Style="{StaticResource FoundationCheckBoxStyle}" IsChecked="{Binding AbsSnapCenter}" MinWidth="50" Grid.Row="5" Grid.Column="1" />
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>

            </TabItem>
        </TabControl>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
