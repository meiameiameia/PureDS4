                </TabItem.Resources>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <GroupBox Style="{StaticResource FoundationGroupBoxStyle}" Header="Left stick">
