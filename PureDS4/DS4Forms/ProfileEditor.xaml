                                                       Style="{StaticResource FoundationSecondaryTextStyle}" />
                                            <Label Grid.Row="2" Style="{StaticResource FoundationPropertyLabelStyle}" Content="B" Target="{Binding ElementName=lowBlueSlider}" />
                                            <Slider Grid.Row="2" Grid.Column="1" x:Name="lowBlueSlider" Style="{StaticResource FoundationHorizontalSliderStyle}"
