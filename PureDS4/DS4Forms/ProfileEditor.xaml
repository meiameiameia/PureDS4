                                                                    </TextBlock>
                                                                </xctk:DoubleUpDown.ToolTip>
                                                            </xctk:DoubleUpDown>
                                                        </DockPanel>

                                                        <Label Style="{StaticResource FoundationPropertyLabelStyle}" Content="{lex:Loc VerticalScale}" ContentStringFormat="{}{0}:" Grid.Row="4" Grid.Column="0" />
