                                        <xctk:DoubleUpDown Style="{StaticResource FoundationPropertyNumericStyle}" FormatString="F0" Value="{Binding TouchRelMouseRotation,FallbackValue='0'}" Minimum="-180" Maximum="180" Increment="1" AutomationProperties.Name="Rotation" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Min Threshold" Style="{StaticResource FoundationPropertyRowControlStyle}" ToolTip="{lex:Loc TouchpadMinThresholdTooltip}">
                                        <xctk:DoubleUpDown Style="{StaticResource FoundationPropertyNumericStyle}" FormatString="F1" Value="{Binding TouchRelMouseMinThreshold,FallbackValue='1.0'}" Minimum="1.0" Maximum="40.0" Increment="1.0" AutomationProperties.Name="Min Threshold" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Trackball" Style="{StaticResource FoundationPropertyRowControlStyle}" ToolTip="{lex:Loc TouchpadTrackballEnableTooltip}">
                                        <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" Content="Trackball" IsChecked="{Binding TouchTrackball}" AutomationProperties.Name="Trackball" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Friction" Style="{StaticResource FoundationPropertySubRowControlStyle}" Visibility="{Binding TouchTrackball, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{lex:Loc TouchpadTrackballFrictionTooltip}">
                                        <xctk:DoubleUpDown Style="{StaticResource FoundationPropertyNumericStyle}" Value="{Binding TouchTrackballFriction,FallbackValue='10'}" Minimum="0.1" Maximum="20.0" x:Name="frictionUD" IsEnabled="{Binding TouchTrackball}" ValueChanged="FrictionUD_ValueChanged" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Invert" Style="{StaticResource FoundationPropertyRowControlStyle}">
                                        <ComboBox Style="{StaticResource FoundationPropertyComboStyle}" SelectedIndex="{Binding TouchInvertIndex}" AutomationProperties.Name="Invert">
                                            <ComboBoxItem Content="None" />
                                            <ComboBoxItem Content="X" />
                                            <ComboBoxItem Content="Y" />
                                            <ComboBoxItem Content="X+Y" />
                                        </ComboBox>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Disable invert" Style="{StaticResource FoundationPropertyRowControlStyle}" ToolTip="Choose the buttons that temporarily disable inverted touchpad movement">
