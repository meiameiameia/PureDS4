<Window x:Class="DS4WinWPF.DS4Forms.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Lightbar color" Width="360" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Style="{DynamicResource WindowStyle}">
    <Window.Resources>
        <!-- Local presentation only. Keep ColorCanvas' four public template parts
             and existing color conversion, numeric input and live change event. -->
        <ControlTemplate x:Key="LightbarCanvasTemplate" TargetType="xctk:ColorCanvas">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                            HorizontalAlignment="Left" ClipToBounds="True">
                        <Canvas x:Name="PART_ColorShadingCanvas" Width="272" Height="136">
                            <Rectangle Width="272" Height="136">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="{Binding SelectedColor, ElementName=PART_SpectrumSlider}" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Width="272" Height="136">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="White" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Width="272" Height="136">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="Black" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Canvas x:Name="PART_ColorShadeSelector" Width="10" Height="10" IsHitTestVisible="False">
                                <Ellipse Width="10" Height="10" Stroke="White" StrokeThickness="3" />
                                <Ellipse Width="10" Height="10" Stroke="Black" StrokeThickness="1" />
                            </Canvas>
                        </Canvas>
                    </Border>
                    <xctk:ColorSpectrumSlider x:Name="PART_SpectrumSlider" Grid.Column="1"
                                              AutomationProperties.Name="Hue" Margin="4,-8,0,0" />
                </Grid>
                <Grid Margin="0,12,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="112" />
                    </Grid.ColumnDefinitions>
                    <Border Margin="0,0,8,0" BorderThickness="1" BorderBrush="{DynamicResource BorderDefaultBrush}">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding SelectedColor, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border.Background>
                    </Border>
                    <TextBox x:Name="PART_HexadecimalTextBox" Grid.Column="1"
                             Style="{StaticResource FoundationTextBoxStyle}" AutomationProperties.Name="Hexadecimal color" />
                </Grid>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="76" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Text="R" VerticalAlignment="Center" />
                    <Slider x:Name="PART_RSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255"
                            SmallChange="1" LargeChange="10" Margin="8,4" VerticalAlignment="Center"
                            AutomationProperties.Name="R channel" Value="{Binding R, RelativeSource={RelativeSource TemplatedParent}}" />
                    <xctk:ByteUpDown x:Name="RValue" Grid.Row="0" Grid.Column="2" Padding="4,0" Margin="0,4"
                                     MinHeight="{StaticResource ControlHeightDefault}" VerticalContentAlignment="Center"
                                     Background="{DynamicResource SurfaceInsetBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                     AutomationProperties.Name="R value, 0 to 255" Value="{Binding Value, ElementName=PART_RSlider}" />
                    <TextBlock Grid.Row="1" Text="G" VerticalAlignment="Center" />
                    <Slider x:Name="PART_GSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255"
                            SmallChange="1" LargeChange="10" Margin="8,4" VerticalAlignment="Center"
                            AutomationProperties.Name="G channel" Value="{Binding G, RelativeSource={RelativeSource TemplatedParent}}" />
                    <xctk:ByteUpDown x:Name="GValue" Grid.Row="1" Grid.Column="2" Padding="4,0" Margin="0,4"
                                     MinHeight="{StaticResource ControlHeightDefault}" VerticalContentAlignment="Center"
                                     Background="{DynamicResource SurfaceInsetBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                     AutomationProperties.Name="G value, 0 to 255" Value="{Binding Value, ElementName=PART_GSlider}" />
                    <TextBlock Grid.Row="2" Text="B" VerticalAlignment="Center" />
                    <Slider x:Name="PART_BSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255"
                            SmallChange="1" LargeChange="10" Margin="8,4" VerticalAlignment="Center"
                            AutomationProperties.Name="B channel" Value="{Binding B, RelativeSource={RelativeSource TemplatedParent}}" />
                    <xctk:ByteUpDown x:Name="BValue" Grid.Row="2" Grid.Column="2" Padding="4,0" Margin="0,4"
                                     MinHeight="{StaticResource ControlHeightDefault}" VerticalContentAlignment="Center"
                                     Background="{DynamicResource SurfaceInsetBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                     AutomationProperties.Name="B value, 0 to 255" Value="{Binding Value, ElementName=PART_BSlider}" />
                </Grid>
            </StackPanel>
        </ControlTemplate>
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock Text="Lightbar color" Style="{StaticResource FoundationPageTitleStyle}" />
        <TextBlock Text="Changes apply immediately. Closing keeps the selected color."
                   Style="{StaticResource FoundationSecondaryTextStyle}" Margin="0,4,0,12" />
        <xctk:ColorCanvas x:Name="colorPicker" Template="{StaticResource LightbarCanvasTemplate}"
                          FontFamily="{StaticResource TypeUiFontFamily}" FontSize="{StaticResource TypeBodySize}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          SelectedColorChanged="ColorPicker_SelectedColorChanged" UsingAlphaChannel="False" />
        <Button Content="Close" Click="CloseButton_Click" IsCancel="True"
                Style="{StaticResource FoundationButtonStyle}" MinWidth="72"
                HorizontalAlignment="Right" Margin="0,12,0,0" />
    </StackPanel>
</Window>
