                                                    <xctk:IntegerUpDown d:IsHidden="True" x:Name="updPortNum" Width="90" Margin="0,0,16,0" Style="{StaticResource FoundationNumericInputStyle}"
                                                                        AutomationProperties.Name="Motion server port" IsEnabled="{Binding UseUDPServer}"
                                                                        Value="{Binding UdpPort, UpdateSourceTrigger=LostFocus,FallbackValue='26760'}" Increment="1" Maximum="65535" Minimum="0" />
                                                    <CheckBox x:Name="useUdpServerCk" Style="{StaticResource FoundationToggleSwitchStyle}" AutomationProperties.Name="Motion server"
                                                              IsChecked="{Binding UseUDPServer}" Click="UseUdpServerCk_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Smoothing" Style="{StaticResource FoundationSettingTitleStyle}" />
                                                    <TextBlock Text="Filter motion noise with a One Euro filter." Style="{StaticResource FoundationSettingDescriptionStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" AutomationProperties.Name="Motion smoothing"
