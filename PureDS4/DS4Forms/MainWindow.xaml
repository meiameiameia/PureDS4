                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBox x:Name="udpServerTxt" Width="110" Margin="0,0,8,0" Style="{StaticResource FoundationTextBoxStyle}" AutomationProperties.Name="Motion server address"
                                                             IsEnabled="{Binding UseUDPServer,Mode=OneWay}"
