                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource FoundationSettingSubRowStyle}">
                                        <TextBox x:Name="customSteamTxt" VerticalAlignment="Center" Style="{StaticResource FoundationTextBoxStyle}" AutomationProperties.Name="Custom Steam folder path"
