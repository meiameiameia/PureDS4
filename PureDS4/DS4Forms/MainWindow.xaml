                                                    <Button x:Name="hidHideBtn" Content="Open" MinWidth="72" Style="{StaticResource FoundationButtonStyle}" Click="HidHideBtn_Click"
                                                            AutomationProperties.Name="Open controller protection settings" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Driver setup" Style="{StaticResource FoundationSettingTitleStyle}" />
                                                    <TextBlock Text="Install or repair controller drivers. Stops PureDS4 first." Style="{StaticResource FoundationSettingDescriptionStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="driverSetupBtn" Content="Run" MinWidth="72" Style="{StaticResource FoundationButtonStyle}" Click="DriverSetupBtn_Click"
                                                            AutomationProperties.Name="Run driver setup" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Updates" Style="{StaticResource FoundationSettingTitleStyle}" />
                                                    <TextBlock Text="Check GitHub. Downloads and installation stay manual." Style="{StaticResource FoundationSettingDescriptionStyle}" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="releaseCheckStatusText" Style="{StaticResource FoundationSecondaryTextStyle}" TextWrapping="Wrap"
                                                               AutomationProperties.LiveSetting="Polite" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="checkUpdatesBtn" Content="Check" MinWidth="72" Style="{StaticResource FoundationButtonStyle}" Click="CheckUpdatesBtn_Click"
                                                            AutomationProperties.Name="Check updates" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource FoundationSettingRowStyle}">
