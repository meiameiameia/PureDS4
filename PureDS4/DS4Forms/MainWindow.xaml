                                                            AutomationProperties.Name="Explain custom executable name" ToolTip="Explain custom executable name">
                                                        <Image Source="{Binding QuestionMarkSource, Mode=OneTime}" Width="16" Height="16" />
                                                    </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Advanced">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Style="{StaticResource SettingsPageStyle}">
                                    <TextBlock Text="Advanced" Style="{StaticResource FoundationPageTitleStyle}" />
                                    <TextBlock Text="Diagnostics and maintenance utilities. Defaults are best for most people." Margin="0,3,0,0" Style="{StaticResource FoundationSecondaryTextStyle}" />
                                    <TextBlock Text="Diagnostics" Style="{StaticResource FoundationSectionHeadingStyle}" />
                                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
