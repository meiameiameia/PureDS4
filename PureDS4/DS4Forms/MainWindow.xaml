                                            <xctk:DoubleUpDown d:IsHidden="True" Width="100" Margin="0,0,24,0" Style="{StaticResource FoundationNumericInputStyle}" FormatString="F5" AutomationProperties.Name="Minimum cutoff"
                                                               Value="{Binding UdpSmoothMinCutoff,FallbackValue=1.0,UpdateSourceTrigger=LostFocus}"
                                                               Minimum="0.00001" Maximum="100.0" Increment="0.1" />
                                            <TextBlock Text="Beta" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource FoundationSettingTitleStyle}" />
                                            <xctk:DoubleUpDown d:IsHidden="True" Width="100" Style="{StaticResource FoundationNumericInputStyle}" FormatString="F5" AutomationProperties.Name="Beta"
                                                               Value="{Binding UdpSmoothBeta,FallbackValue=0.0,UpdateSourceTrigger=LostFocus}"
                                                               Minimum="0.0" Maximum="1.0" Increment="0.1" />
                                        </WrapPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Compatibility">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Style="{StaticResource SettingsPageStyle}">
                                    <TextBlock Text="Compatibility" Style="{StaticResource FoundationPageTitleStyle}" />
