                                    <Button Grid.Column="1" Content="Open" Tag="slots" Margin="12,0,0,0" Click="ToolsMenuItem_Click" Style="{StaticResource FoundationButtonStyle}" AutomationProperties.Name="Open output slots" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource FoundationPropertyGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Log" Style="{StaticResource FoundationGroupTitleStyle}" /><TextBlock Text="Search, filter, and copy runtime events." Style="{StaticResource FoundationSecondaryTextStyle}" /></StackPanel>
                                    <Button Grid.Column="1" Content="Open" Tag="log" Margin="12,0,0,0" Click="ToolsMenuItem_Click" Style="{StaticResource FoundationButtonStyle}" AutomationProperties.Name="Open runtime log" />
                                </Grid>
                            </Border>
                            <TextBlock Text="RECOVERY AND REFERENCE" Style="{StaticResource FoundationSectionHeadingStyle}" />
                            <Border Style="{StaticResource FoundationPropertyGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="HidHide recovery" Style="{StaticResource FoundationGroupTitleStyle}" /><TextBlock Text="Inspect and release only controller rules left uncertain after an interrupted run. Stop controller handling first." TextWrapping="Wrap" Style="{StaticResource FoundationSecondaryTextStyle}" /></StackPanel>
                                    <Button x:Name="recoverHidHideBtn" Grid.Column="1" Content="Inspect" Margin="12,0,0,0" Click="RecoverHidHideBtn_Click" Style="{StaticResource FoundationButtonStyle}" AutomationProperties.Name="Inspect HidHide recovery" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource FoundationPropertyGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Hotkeys and About" Style="{StaticResource FoundationGroupTitleStyle}" /><TextBlock Text="View application identity, version, links, and keyboard shortcuts." Style="{StaticResource FoundationSecondaryTextStyle}" /></StackPanel>
                                    <Button Grid.Column="1" Content="Open" Margin="12,0,0,0" Click="AboutBtn_Click" Style="{StaticResource FoundationButtonStyle}" AutomationProperties.Name="Open hotkeys and About" />
                                </Grid>
                            </Border>
                            <TextBlock Text="MOVING FROM DS4WINDOWS" Style="{StaticResource FoundationSectionHeadingStyle}" />
                            <Border Style="{StaticResource FoundationPropertyGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Import from DS4Windows" Style="{StaticResource FoundationGroupTitleStyle}" /><TextBlock Text="Copy game profiles from an existing DS4Windows installation into PureDS4. Your DS4Windows files are never changed or removed." Style="{StaticResource FoundationSecondaryTextStyle}" /></StackPanel>
                                    <Button Grid.Column="1" Content="Open" Margin="12,0,0,0" Click="ImportLegacyProfilesBtn_Click" Style="{StaticResource FoundationButtonStyle}" AutomationProperties.Name="Import profiles from DS4Windows" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource FoundationPropertyGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="DS4Windows removal plan" Style="{StaticResource FoundationGroupTitleStyle}" /><TextBlock Text="See exactly what removing a detected DS4Windows installation would involve. Opening the plan does not remove anything." Style="{StaticResource FoundationSecondaryTextStyle}" /></StackPanel>
                                    <Button Grid.Column="1" Content="Open" Margin="12,0,0,0" Click="ShowLegacyRemovalPlanBtn_Click" Style="{StaticResource FoundationButtonStyle}" AutomationProperties.Name="Open DS4Windows removal plan" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem x:Name="logTab" Header="{lex:Loc Log}" Tag="&#xE9D9;" Visibility="Collapsed" Style="{StaticResource BridgeHiddenToolTabItemStyle}">
                <Grid Margin="16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Runtime log" Style="{StaticResource FoundationPageTitleStyle}" />
                            <TextBlock Text="Search, inspect, and export diagnostic events."
                                       Margin="0,3,0,0" Style="{StaticResource FoundationSecondaryTextStyle}" />
                        </StackPanel>
                        <TextBox Grid.Column="1" x:Name="logSearchTextBox" Margin="12,0,0,0"
                                 ToolTip="Search log messages" AutomationProperties.Name="Search log messages"
                                 TextChanged="LogFilter_Changed" />
                        <TextBlock Grid.Column="1" Text="Search messages" IsHitTestVisible="False"
                                                           Margin="22,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=logSearchTextBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ComboBox Grid.Column="2" x:Name="logSeverityFilter" Margin="8,0,0,0"
                                  SelectedIndex="0" SelectionChanged="LogFilter_Changed"
                                  AutomationProperties.Name="Log severity filter">
                            <ComboBoxItem Content="All events" />
                            <ComboBoxItem Content="Warnings" />
                        </ComboBox>
                        <CheckBox Grid.Column="3" x:Name="logAutoScrollCheckBox" Margin="12,0,0,0"
                                  Content="Follow new events" IsChecked="True" VerticalAlignment="Center" />
                    </Grid>
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                            Padding="12,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Time" Style="{StaticResource FoundationColumnHeaderStyle}" />
                            <TextBlock Grid.Column="1" Text="Severity" Style="{StaticResource FoundationColumnHeaderStyle}" />
                            <TextBlock Grid.Column="2" Text="Message" Style="{StaticResource FoundationColumnHeaderStyle}" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListView x:Name="logListView" Style="{StaticResource FoundationTableListViewStyle}"
                                  BorderThickness="1,0,1,1" MouseDoubleClick="LogListView_MouseDoubleClick">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource FoundationTableListItemStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="12,5" />
                                    <Setter Property="MinHeight" Value="30" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Datetime, StringFormat=\{0:HH:mm:ss\}}"
                                                   ToolTip="{Binding Datetime, StringFormat=\{0:G\}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Severity}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource FoundationBodyTextStyle}">
                                                    <!-- Ordinary events carry no label: what stands out should be
                                                         the handful that need attention. -->
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Warning}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Foreground" Value="{DynamicResource StateWarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="logEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False" Margin="0,0,0,40" MaxWidth="360">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=logListView}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="No events yet" HorizontalAlignment="Center"
                                       Style="{StaticResource FoundationGroupTitleStyle}" />
                            <TextBlock Text="Connecting a controller, starting game output or changing a profile is recorded here."
                                       Margin="0,6,0,0" TextAlignment="Center"
                                       Style="{StaticResource FoundationSecondaryTextStyle}" />
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource FoundationToolbarBarStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Copy selected" Click="CopySelectedLogBtn_Click"
                                            Style="{StaticResource FoundationToolbarButtonStyle}" />
                                    <Button x:Name="exportLogBtn" Content="Export" Click="ExportLogBtn_Click"
                                            Style="{StaticResource FoundationToolbarButtonStyle}" />
                                </StackPanel>
                                <!-- Clearing discards evidence, so it keeps its distance
                                     from the two actions that only read the log. -->
                                <Button x:Name="clearLogBtn" Content="Clear log" Click="ClearLogBtn_Click"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource FoundationToolbarButtonStyle}" />
                                <TextBlock Grid.Row="1" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Logs may contain controller IDs and file paths. Review before sharing." />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>
            <local:BusyOverlay x:Name="exposureBusyOverlay"
                               Panel.ZIndex="100"
                               Title="Changing controller exposure"
                               Message="PureDS4 is safely updating physical input and game output. Do not disconnect the controller." />
    </Grid>
</DockPanel>
</Window>
