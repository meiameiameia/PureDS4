<Window x:Name="mainDS4Window" x:Class="DS4WinWPF.DS4Forms.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:LocalizeDictionary.DesignCulture=""
        lex:ResxLocalizationProvider.DefaultAssembly="PureDS4"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
        xmlns:localConverters="clr-namespace:DS4WinWPF.DS4Forms.Converters"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xml:lang="en-US"
        mc:Ignorable="d"
        Title="PureDS4" Icon="/PureDS4;component/Resources/DS4W.ico" Height="660" Width="1024" Closing="MainDS4Window_Closing" Closed="MainDS4Window_Closed" StateChanged="MainDS4Window_StateChanged" SizeChanged="MainDS4Window_SizeChanged" LocationChanged="MainDS4Window_LocationChanged" MinWidth="720" MinHeight="480"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Style="{DynamicResource WindowStyle}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:ImageLocationPaths x:Key="ImgLocPaths" />
    </Window.Resources>
    <DockPanel>
        <tb:TaskbarIcon x:Name="notifyIcon" IconSource="{Binding IconSource,Mode=OneWay}" ToolTipText="{Binding TooltipText,Mode=OneWay}" MenuActivation="RightClick" TrayRightMouseUp="NotifyIcon_TrayRightMouseUp" TrayMiddleMouseDown="NotifyIcon_TrayMiddleMouseDown" TrayMouseDoubleClick="NotifyIcon_TrayMouseDoubleClick">
            <!--<tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open" />
                    <Separator />
                    <MenuItem x:Name="exitMenuItem" Header="Exit" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>-->
        </tb:TaskbarIcon>

        <Border DockPanel.Dock="Bottom"
                MinHeight="30"
                Padding="8,3"
                VerticalAlignment="Bottom"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="StartStopBtn" Content="{lex:Loc StartText}" Margin="8,0,0,0" Click="StartStopBtn_Click" MinWidth="52"
                            Style="{StaticResource BridgeSecondaryButtonStyle}" Padding="8,1" />
                </StackPanel>
                <TextBlock x:Name="serviceStatusText" Text="Service stopped"
                           Style="{StaticResource FoundationSecondaryTextStyle}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <StackPanel DockPanel.Dock="Top">
            <local:StatusBanner x:Name="gameOutputStatusBanner"
                                State="Warning"
                                ActionLabel="Open game output settings"
                                ShowAction="True"
                                ActionRequested="GameOutputStatusBanner_ActionRequested" />
            <local:StatusBanner x:Name="exposureStatusBanner"
                                ActionLabel="Recover"
                                ActionRequested="ExposureStatusBanner_ActionRequested" />
            <local:StatusBanner x:Name="elevationStatusBanner"
                                State="Neutral"
                                ShowAction="True"
                                ActionRequested="ElevationStatusBanner_ActionRequested" />
            <local:StatusBanner x:Name="releaseNotificationBanner"
                                State="Neutral" ActionLabel="Open release page"
                                ActionRequested="ReleaseNotificationBanner_ActionRequested" />
        </StackPanel>
        <Grid DockPanel.Dock="Top">
            <TabControl x:Name="mainTabCon" SelectedIndex="1" SelectionChanged="MainTabCon_SelectionChanged" Style="{StaticResource BridgeMainTabControlStyle}">
            <TabItem x:Name="overviewTab" Header="Quick controls" Tag="&#xE80F;" Visibility="Collapsed" Style="{StaticResource BridgeHiddenToolTabItemStyle}" IsEnabled="{Binding FullTabsEnabled,Mode=OneWay}">
                <local:ControllerOverviewControl x:Name="controllerOverviewControl"
                                                 EditProfileRequested="ControllerOverview_EditProfileRequested"
                                                 ControllerDetailsRequested="ControllerOverview_ControllerDetailsRequested"
                                                 LightbarRequested="ControllerOverview_LightbarRequested"
                                                 DisconnectRequested="ControllerOverview_DisconnectRequested" />
            </TabItem>

            <TabItem x:Name="controllersTab" Header="Home" Tag="&#xE7FC;" IsEnabled="{Binding FullTabsEnabled,Mode=OneWay}">
                <Grid x:Name="homeWorkspace" Margin="16,8" MaxWidth="1180" MaxHeight="360"
                      TextElement.FontFamily="{StaticResource TypeUiFontFamily}"
                      TextElement.FontSize="{StaticResource TypeBodySize}"
                      TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Value="Maximized">
                                    <Setter Property="Height" Value="360" />
                                    <Setter Property="VerticalAlignment" Value="Top" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.Resources>
                        <Style x:Key="HomeRowStyle" TargetType="ListViewItem"
                               BasedOn="{StaticResource FoundationControllerRowStyle}">
                            <Setter Property="local:ControllerRowSelection.SelectOnInteraction" Value="True" />
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" MaxHeight="140" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Controllers" Style="{StaticResource FoundationPageTitleStyle}" Margin="0,0,0,8" />
                    <ListView x:Name="controllerLV" Grid.Row="1" ItemsSource="{Binding ControllerCol}" SelectionMode="Single"
                              SelectedIndex="{Binding CurrentIndex, Mode=OneWayToSource}" Margin="0"
                              SelectedItem="{Binding DataContext.SelectedController, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
                              ItemContainerStyle="{StaticResource HomeRowStyle}"
                              Background="{DynamicResource SurfaceBaseBrush}" BorderThickness="0"
                              AutomationProperties.Name="Connected controllers"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <!-- Header and rows share the same viewport, including when a
                             scrollbar appears. At most eight devices: pixel scrolling
                             here is intentional, not a claim of virtualization. -->
                        <ListView.Template>
                            <ControlTemplate TargetType="ListView">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              CanContentScroll="False" Focusable="False">
                                    <StackPanel>
                                        <Grid Margin="10,0,8,4" IsHitTestVisible="False">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{StaticResource HomeIdentityColumn}" MinWidth="174" />
                                                <ColumnDefinition Width="{StaticResource HomeProtectionColumn}" />
                                                <ColumnDefinition Width="{StaticResource HomeProfileColumn}" MinWidth="128" />
                                                <ColumnDefinition Width="{StaticResource HomeBatteryColumn}" />
                                                <ColumnDefinition Width="{StaticResource HomeLightbarColumn}" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="CONTROLLER" Style="{StaticResource FoundationColumnHeaderStyle}" />
                                            <TextBlock Grid.Column="1" Text="PROTECTION" Style="{StaticResource FoundationColumnHeaderStyle}" />
                                            <TextBlock Grid.Column="2" Text="PROFILE" Style="{StaticResource FoundationColumnHeaderStyle}" />
                                            <TextBlock Grid.Column="3" Text="BATTERY" Style="{StaticResource FoundationColumnHeaderStyle}" />
                                            <TextBlock Grid.Column="4" Text="LIGHTBAR" Style="{StaticResource FoundationColumnHeaderStyle}" />
                                        </Grid>
                                        <ItemsPresenter />
                                    </StackPanel>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListView.Template>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource HomeIdentityColumn}" MinWidth="174" />
                                        <ColumnDefinition Width="{StaticResource HomeProtectionColumn}" />
                                        <ColumnDefinition Width="{StaticResource HomeProfileColumn}" MinWidth="128" />
                                        <ColumnDefinition Width="{StaticResource HomeBatteryColumn}" />
                                        <ColumnDefinition Width="{StaticResource HomeLightbarColumn}" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Margin="0,0,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding ControllerImageSource}" Stretch="Uniform"
                                               Width="32" Height="28" Margin="0,0,6,0"
                                               Visibility="{Binding HasControllerArtwork, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock TextTrimming="CharacterEllipsis" FontWeight="SemiBold">
                                                <Run Text="{Binding ControllerDisplayName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DisplayDevIndex, Mode=OneWay}" />
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal">
                                                <Image x:Name="contStatusImg" Source="{Binding StatusSource}" Width="12" Height="12" Margin="0,0,4,0"
                                                       ToolTip="Right click to disconnect wireless"
                                                       MouseRightButtonUp="ContStatusImg_MouseRightButtonUp" Tag="{Binding DevIndex}" />
                                                <TextBlock Text="{Binding ConnectionText}" FontSize="{StaticResource TypeSecondarySize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding IsExclusiveText}" ToolTip="{Binding IsExclusiveText}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox Grid.Column="2" x:Name="selectProfCombo" Margin="0,0,8,0"
                                              Style="{StaticResource FoundationComboBoxStyle}" VerticalAlignment="Center"
                                              ItemsSource="{Binding ProfileListCol}" SelectedIndex="{Binding SelectedIndex}"
                                              Tag="{Binding DevIndex}" AutomationProperties.Name="Active profile"
                                              ToolTip="{Binding SelectedProfile}"
                                              Visibility="{Binding PrimaryDevice, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              SelectionChanged="SelectProfCombo_SelectionChanged" KeyDown="SelectProfCombo_KeyDown">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Column="3" Text="{Binding BatteryState}" ToolTip="{Binding BatteryState}"
                                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                                    <Button Grid.Column="4" Click="LightColorBtn_Click" Tag="{Binding DevIndex}"
                                            Style="{StaticResource FoundationButtonStyle}" Padding="6,2" VerticalAlignment="Center"
                                            AutomationProperties.Name="Lightbar color" ToolTip="Lightbar: use profile controls or choose a custom color">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="12" Height="12" Background="{Binding LightColor}"
                                                    BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" />
                                            <TextBlock Grid.Column="1" Text="{Binding LightbarModeText}" Margin="4,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="⌄" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Label x:Name="noContLb" Grid.Row="1" Panel.ZIndex="1" Visibility="Hidden"
                           Background="{DynamicResource SurfaceBaseBrush}"
                           HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                           FontWeight="SemiBold" />
                    <!-- Selected runtime truth stays outside the scrolling device rows. -->
                    <Border x:Name="homeInspector" Grid.Row="3" Margin="0,8,0,0" Padding="12,8"
                            Visibility="{Binding HasSelectedController, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0"
                            IsEnabled="{Binding HasSelectedController}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding SelectedController.ControllerDisplayName, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding SelectedController.DisplayDevIndex, Mode=OneWay}" />
                                </TextBlock>
                                <local:StatusChip Grid.Column="1" Label="{Binding SelectedControllerStartupTitle}"
                                                  Detail="{Binding SelectedControllerStartupDetail}"
                                                  State="{Binding SelectedControllerStartupStage, Converter={StaticResource ControllerStartupStageVisualState}}" />
                            </Grid>
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                                <Run Text="Game output: " /><Run Text="{Binding SelectedRuntimeOutputControllerName, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Text="{Binding SelectedControllerStartupDetail}" Margin="0,4,0,12"
                                       TextWrapping="Wrap" ToolTip="{Binding SelectedControllerStartupDetail}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <local:ActionGroupPanel x:Name="homeActions" DataContext="{Binding SelectedController}">
                                <local:ActionGroupPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource FoundationButtonStyle}">
                                        <Setter Property="Margin" Value="0" />
                                    </Style>
                                </local:ActionGroupPanel.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Controller details" Click="HomeControllerDetailsBtn_Click" />
                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                                Visibility="{Binding PrimaryDevice, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button Content="Edit profile" Click="ControllerOverview_EditProfileRequested" />
                                        <Button x:Name="homeProfileMenuButton" Content="▾" Margin="4,0,0,0"
                                                AutomationProperties.Name="More profile actions" ToolTip="More profile actions"
                                                Click="HomeProfileMenu_Click">
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{StaticResource FoundationChoiceMenuStyle}"
                                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="New profile" Click="HomeNewProfileBtn_Click" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Use controller directly" Tag="{Binding DevIndex}" Click="HomeUseNativeBtn_Click"
                                            ToolTip="Stop virtual game output and let games see this controller directly."
                                            Visibility="{Binding PrimaryDevice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button Content="Disconnect" Click="HomeDisconnectBtn_Click" Margin="8,0,0,0"
                                            Visibility="{Binding IsWireless, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </local:ActionGroupPanel>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding NativePhysicalSessions}"
                                  Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource RaisedBackgroundColor}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ModeTitle}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentColor}" />
                                                <TextBlock Text="  ·  " Foreground="{DynamicResource MutedForegroundColor}" />
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="  ·  " Foreground="{DynamicResource MutedForegroundColor}" />
                                                <TextBlock Text="{Binding SlotText}" Foreground="{DynamicResource MutedForegroundColor}" />
                                                <TextBlock Text="  ·  " Foreground="{DynamicResource MutedForegroundColor}" />
                                                <TextBlock Text="{Binding Connection}" Foreground="{DynamicResource MutedForegroundColor}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" Margin="0,3,10,0" FontSize="11"
                                                       Foreground="{DynamicResource MutedForegroundColor}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Use game output"
                                                MinHeight="28" Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                ToolTip="Protect the physical controller again and restore PureDS4 game output."
                                                Tag="{Binding InstanceId}"
                                                Visibility="{Binding CanReturnToManaged, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Click="HomeUseManagedBtn_Click" />
                                        <Button Grid.Column="1" Content="Recover controller"
                                                MinHeight="28" Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                Tag="{Binding InstanceId}"
                                                Visibility="{Binding CanRecover, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Click="HomeRecoverControllerBtn_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>


            <TabItem x:Name="profilesTab" Header="{lex:Loc Profiles}" Tag="&#xE8A5;">
                <!-- Same workspace inset as Home. Without it the title, the
                     toolbar, the search field and the table all sat flush
                     against the window frame. -->
                <Grid x:Name="profDockPanel" Margin="16,8">
                    <Grid x:Name="profilesBrowserPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Home leads with the page title, then its content. The actions
                             used to sit above the title, so the first thing under the tab
                             strip was a row of buttons rather than the name of the page. -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Profiles" Style="{StaticResource FoundationPageTitleStyle}" />
                                <TextBlock Text="Select a profile for actions, or double-click a row to edit it."
                                           Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedForegroundColor}" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource RaisedBackgroundColor}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="2" Padding="10,5" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ElementName=profilesListBox, Path=Items.Count, Converter={StaticResource CountLabel}, ConverterParameter=profile}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedForegroundColor}" />
                            </Border>
                        </Grid>

                        <Grid x:Name="profOptsToolbar" Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <WrapPanel VerticalAlignment="Center">
                                <Button x:Name="newProfListBtn" Click="NewProfListBtn_Click"
                                        Style="{StaticResource FoundationPrimaryButtonStyle}" Margin="0,0,8,6" Content="New profile" />
                                <Button x:Name="editProfBtn" IsEnabled="False" Click="EditProfBtn_Click"
                                        Style="{StaticResource FoundationButtonStyle}" Margin="0,0,8,6" Content="{lex:Loc Edit}" />
                                <Button x:Name="dupProfBtn" IsEnabled="False" Click="DupProfBtn_Click"
                                        Style="{StaticResource FoundationButtonStyle}" Margin="0,0,8,6" Content="{lex:Loc Duplicate}" />
                                <Button x:Name="renameProfBtn" IsEnabled="False" Click="RenameProfBtn_Click"
                                        Style="{StaticResource FoundationButtonStyle}" Margin="0,0,8,6" Content="{lex:Loc RenameProfile}" />
                                <Button x:Name="deleteProfBtn" IsEnabled="False" Click="DeleteProfBtn_Click"
                                        Style="{StaticResource FoundationButtonStyle}" Foreground="{DynamicResource StateErrorBrush}"
                                        Margin="0,0,16,6" Content="{lex:Loc Delete}" />
                                <Button x:Name="importProfBtn" Click="ImportProfBtn_Click"
                                        Style="{StaticResource FoundationButtonStyle}" Margin="0,0,8,6" Content="{lex:Loc Import}" />
                                <Button x:Name="exportProfBtn" IsEnabled="False" Click="ExportProfBtn_Click"
                                        Style="{StaticResource FoundationButtonStyle}" Margin="0,0,0,6" Content="{lex:Loc Export}" />
                            </WrapPanel>
                            <Border Grid.Column="1" Margin="16,0,0,6" VerticalAlignment="Top"
                                    Width="260" MaxWidth="260" HorizontalAlignment="Right"
                                    Background="{DynamicResource RaisedBackgroundColor}"
                                    BorderThickness="1" CornerRadius="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                                        <Style.Triggers>
                                            <!-- The whole search field takes focus, not the
                                                 text box nested inside it. -->
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="{DynamicResource MutedForegroundColor}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Search profiles" IsHitTestVisible="False"
                                               Margin="4,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=profilesSearchTextBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="profilesSearchTextBox" Grid.Column="1" Tag="Embedded"
                                             BorderThickness="0" Background="Transparent"
                                             Padding="4,2" MinHeight="28" VerticalContentAlignment="Center"
                                             Style="{StaticResource FoundationTextBoxStyle}" AutomationProperties.Name="Search profiles"
                                             TextChanged="ProfilesSearchTextBox_TextChanged"
                                             ToolTip="Search profiles by name" />
                                    <Button x:Name="clearProfilesSearchBtn" Grid.Column="2" Content="&#xE711;"
                                            FontFamily="Segoe MDL2 Assets" FontSize="11"
                                            Style="{StaticResource FoundationButtonStyle}"
                                            Background="Transparent" BorderThickness="0"
                                            Visibility="Collapsed" ToolTip="Clear search"
                                            AutomationProperties.Name="Clear profile search"
                                            Click="ClearProfilesSearchBtn_Click" />
                                </Grid>
                            </Border>
                        </Grid>

                        <Border x:Name="dupBoxBar" Grid.Row="2" Style="{StaticResource FoundationPropertyGroupStyle}"
                                Padding="12,8" Margin="0,0,0,8" Visibility="Collapsed">
                            <local:DupBox x:Name="dupBox" HorizontalAlignment="Stretch" />
                        </Border>

                        <Grid Grid.Row="3">
                            <ListBox x:Name="profilesListBox" Background="Transparent" BorderThickness="0"
                                     AutomationProperties.Name="Profiles"
                                     SelectionChanged="ProfilesListBox_SelectionChanged"
                                     MouseDoubleClick="ProfilesListBox_MouseDoubleClick"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.Resources>
                                    <localConverters:EscapeAccessKeysConverter x:Key="escapeAccessConvert" />
                                </ListBox.Resources>
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <!-- Rows paint SurfaceRaised, so the empty area below them
                                             must match or the table changes tone halfway down. -->
                                        <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                BorderThickness="1,0,1,1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="28" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="14,0,12,0" HorizontalAlignment="Left"
                                                        Width="{Binding ViewportWidth, ElementName=ProfileRowsScroll}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="24" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Profile" Style="{StaticResource FoundationColumnHeaderStyle}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Game output" Style="{StaticResource FoundationColumnHeaderStyle}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="Modified" Style="{StaticResource FoundationColumnHeaderStyle}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                                <ScrollViewer x:Name="ProfileRowsScroll" Grid.Row="1" Focusable="False" Padding="0"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource FoundationNavigationListItemStyle}">
                                        <Setter Property="MinHeight" Value="36" />
                                        <Setter Property="Padding" Value="12,5" />
                                        <!-- Without this the row reports its CLR type name. -->
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="24" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name, Mode=OneWay, Converter={StaticResource escapeAccessConvert}}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,12,0"
                                                       ToolTip="{Binding Name}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding GameOutputDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding GameOutputDisplay}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding ModifiedDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModifiedDisplay}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="&#x203A;" FontSize="18"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=profilesListBox, Path=HasItems}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock x:Name="profilesEmptyTitle" Text="No profiles yet" Margin="0,12,0,4" FontSize="13"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock x:Name="profilesEmptyDescription" Text="Create or import a profile to get started." TextWrapping="Wrap" TextAlignment="Center"
                                           Foreground="{DynamicResource MutedForegroundColor}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border x:Name="profileEditorLoadingPanel" Visibility="Collapsed" Panel.ZIndex="2"
                            Background="{DynamicResource CardBackgroundColor}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            CornerRadius="2" Padding="32">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="280">
                            <TextBlock Text="Loading profile editor" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Applying the profile and preparing its controls..."
                                       Margin="0,7,0,16" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundColor}" />
                            <ProgressBar IsIndeterminate="True" Height="4" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem x:Name="autoProfilesTab" Header="{lex:Loc AutoProfiles}" Tag="&#xE823;" Visibility="Collapsed" Style="{StaticResource BridgeHiddenToolTabItemStyle}" IsEnabled="{Binding FullTabsEnabled,Mode=OneWay}">
                <local:AutoProfiles x:Name="autoProfControl">

                </local:AutoProfiles>
            </TabItem>
            <TabItem x:Name="inputDiagnosticsTab" Header="Input diagnostics" Tag="&#xE9D2;" Visibility="Collapsed" Style="{StaticResource BridgeHiddenToolTabItemStyle}" IsEnabled="{Binding FullTabsEnabled,Mode=OneWay}">
                <local:InputDiagnosticsControl x:Name="inputDiagnosticsControl" />
            </TabItem>
            <TabItem x:Name="outputSlotsTab" Header="{lex:Loc OutputSlots}" Tag="&#xE950;" Visibility="Collapsed" Style="{StaticResource BridgeHiddenToolTabItemStyle}" IsEnabled="{Binding FullTabsEnabled,Mode=OneWay}">
                <local:OutputSlotManagerControl x:Name="slotManControl">

                </local:OutputSlotManagerControl>
            </TabItem>
            <TabItem x:Name="settingsTab" Header="{lex:Loc Settings}" Tag="&#xE713;" IsEnabled="{Binding ViewEnabled,Mode=OneWay}">
                <TabItem.Resources>
                    <!-- Every category uses the same column width, so switching categories
                         never resizes the page. Tools shares the 760 DIP cap. -->
                    <Style x:Key="SettingsPageStyle" TargetType="StackPanel">
                        <Setter Property="MaxWidth" Value="760" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,16,16" />
                    </Style>
                    <Style x:Key="SettingsCategoryTabItemStyle" TargetType="TabItem">
                        <Setter Property="Foreground" Value="{DynamicResource ClassicSecondaryTextBrush}" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="CategoryChrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="CategoryChrome" Property="Background" Value="{DynamicResource ClassicSelectedSurfaceBrush}" />
                                            <Setter TargetName="CategoryChrome" Property="BorderBrush" Value="{DynamicResource ClassicAccentBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource ClassicPrimaryTextBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CategoryChrome" Property="Background" Value="{DynamicResource ClassicSurfaceBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="CategoryChrome" Property="BorderBrush" Value="{DynamicResource ClassicFocusBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="SettingsCategoryTabControlStyle" TargetType="TabControl">
                        <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsCategoryTabItemStyle}" />
                        <Setter Property="TabStripPlacement" Value="Left" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabControl">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource ClassicWorkspaceBrush}" BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="0,0,1,0">
                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                <StackPanel IsItemsHost="True" Margin="6" KeyboardNavigation.DirectionalNavigation="Contained" />
                                            </ScrollViewer>
                                        </Border>
                                        <ContentPresenter Grid.Column="1" Margin="16,0,0,0" ContentSource="SelectedContent" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabItem.Resources>
                <Grid Margin="16,8" Background="{DynamicResource ClassicWorkspaceBrush}">
                    <TabControl x:Name="settingsCategoryTabs" Style="{StaticResource SettingsCategoryTabControlStyle}" SelectedIndex="0">
                        <TabItem Header="General">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Style="{StaticResource SettingsPageStyle}">
                                    <TextBlock Text="General" Style="{StaticResource FoundationPageTitleStyle}" />
                                    <TextBlock Text="Startup, window behavior, notifications and appearance." Margin="0,3,0,0" Style="{StaticResource FoundationSecondaryTextStyle}" />
                                    <TextBlock Text="Startup" Style="{StaticResource FoundationSectionHeadingStyle}" />
                                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Start with Windows" Style="{StaticResource FoundationSettingTitleStyle}" />
                                                    <TextBlock Text="Open PureDS4 automatically when you sign in." Style="{StaticResource FoundationSettingDescriptionStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox x:Name="runAtStartCk" Style="{StaticResource FoundationToggleSwitchStyle}" AutomationProperties.Name="Start with Windows"
                                                              IsChecked="{Binding RunAtStartup}" IsEnabled="{Binding CanChangeRunAtStartup}" Click="RunAtStartCk_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource FoundationSettingSubRowStyle}" x:Name="runAsGroupBox" Visibility="{Binding ShowRunStartPanel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Launch as" VerticalAlignment="Center" Style="{StaticResource FoundationSettingTitleStyle}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <RadioButton Content="Program" GroupName="RunAsOpt" VerticalAlignment="Center" IsChecked="{Binding RunStartProg}" />
                                                    <RadioButton Content="Scheduled task" GroupName="RunAsOpt" Margin="16,0,0,0" VerticalAlignment="Center"
                                                                 IsChecked="{Binding RunStartTask}" IsEnabled="{Binding CanWriteTask}" />
                                                    <Image x:Name="uacImg" Source="{Binding UACSource, Mode=OneTime}" Width="16" Height="16" Margin="6,0,0,0"
                                                           VerticalAlignment="Center" ToolTip="{lex:Loc Resources:UACTask}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Start minimized" Style="{StaticResource FoundationSettingTitleStyle}" />
                                                    <TextBlock Text="Open quietly in the notification area without showing this window." Style="{StaticResource FoundationSettingDescriptionStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" AutomationProperties.Name="Start minimized"
                                                              IsChecked="{Binding StartMinimize}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Window" Style="{StaticResource FoundationSectionHeadingStyle}" />
                                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Minimize to taskbar" Style="{StaticResource FoundationSettingTitleStyle}" />
                                                    <TextBlock Text="Keep a taskbar button when minimized, not only the notification-area icon." Style="{StaticResource FoundationSettingDescriptionStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" AutomationProperties.Name="Minimize to taskbar"
                                                              IsChecked="{Binding MinimizeToTaskbar}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Keep running when closed" Style="{StaticResource FoundationSettingTitleStyle}" />
                                                    <TextBlock Text="The close button hides the window. Quit from the notification-area icon." Style="{StaticResource FoundationSettingDescriptionStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" AutomationProperties.Name="Keep running when closed"
                                                              IsChecked="{Binding CloseMinimizes}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Notifications" Style="{StaticResource FoundationSectionHeadingStyle}" />
                                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Windows notifications" Style="{StaticResource FoundationSettingTitleStyle}" />
                                                    <TextBlock Text="Choose which events show a notification." Style="{StaticResource FoundationSettingDescriptionStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ComboBox MinWidth="150" Style="{StaticResource FoundationComboBoxStyle}" AutomationProperties.Name="Windows notifications" SelectedIndex="{Binding ShowNotificationsIndex}">
                                                        <ComboBoxItem Content="None" />
                                                        <ComboBoxItem Content="Warnings only" />
                                                        <ComboBoxItem Content="All" />
                                                    </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource FoundationSettingRowStyle}" Visibility="{Binding IsProfileChangedCheckVisible}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Profile switches" Style="{StaticResource FoundationSettingTitleStyle}" />
                                                    <TextBlock Text="Also notify when a profile is switched." Style="{StaticResource FoundationSettingDescriptionStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" AutomationProperties.Name="Notify on profile switches"
                                                              IsChecked="{Binding ProfileChangedNotification}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Appearance" Style="{StaticResource FoundationSectionHeadingStyle}" />
                                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Theme" Style="{StaticResource FoundationSettingTitleStyle}" />
                                                    <TextBlock Text="Default follows your Windows setting." Style="{StaticResource FoundationSettingDescriptionStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ComboBox x:Name="appThemeCom" MinWidth="150" Style="{StaticResource FoundationComboBoxStyle}" AutomationProperties.Name="Theme" SelectedIndex="{Binding AppChoiceIndex,FallbackValue='0'}">
                                                        <ComboBoxItem Content="Default" />
                                                        <ComboBoxItem Content="Light" />
                                                        <ComboBoxItem Content="Dark" />
                                                    </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Notification-area icon" Style="{StaticResource FoundationSettingTitleStyle}" />
                                                    <TextBlock Text="Style of the PureDS4 icon next to the clock." Style="{StaticResource FoundationSettingDescriptionStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ComboBox x:Name="useIconChoiceCom" MinWidth="150" Style="{StaticResource FoundationComboBoxStyle}" AutomationProperties.Name="Notification-area icon" SelectedIndex="{Binding IconChoiceIndex,FallbackValue='0'}">
                                                        <ComboBoxItem Content="System adaptive" />
                                                        <ComboBoxItem Content="Full color" />
                                                        <ComboBoxItem Content="Light" />
                                                        <ComboBoxItem Content="Dark" />
                                                        <ComboBoxItem Content="Battery status" />
                                                    </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="New release notifications" Style="{StaticResource FoundationSettingTitleStyle}" />
                                                <TextBlock Text="Check GitHub when the app opens, at most once a day. Installation stays manual."
                                                           Style="{StaticResource FoundationSettingDescriptionStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource FoundationToggleSwitchStyle}"
                                                      AutomationProperties.Name="New release notifications"
                                                      IsChecked="{Binding CheckForUpdates}" />
                                        </Grid>
                                    </Border>
                                    <!-- Language packs remain unavailable in this release. -->
                                    <StackPanel Visibility="Collapsed">
                                        <local:LanguagePackControl />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Controller">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Style="{StaticResource SettingsPageStyle}">
                                    <TextBlock Text="Controller" Style="{StaticResource FoundationPageTitleStyle}" />
                                    <TextBlock Text="Physical controller protection, gestures and battery." Margin="0,3,0,0" Style="{StaticResource FoundationSecondaryTextStyle}" />
                                    <TextBlock Text="Protection" Style="{StaticResource FoundationSectionHeadingStyle}" />
                                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Legacy exclusive access" Style="{StaticResource FoundationSettingTitleStyle}" />
                                                    <TextBlock Text="Optional exclusive device access. Game output protects the physical controller separately; turning this off does not expose it. Use controller directly for that." Style="{StaticResource FoundationSettingDescriptionStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox x:Name="hideDS4ContCk" x:Uid="hideDS4Checkbox" Style="{StaticResource FoundationToggleSwitchStyle}" AutomationProperties.Name="Legacy exclusive access"
                                                              IsChecked="{Binding HideDS4Controller}" Click="HideDS4ContCk_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Reclaim from Steam Input" Style="{StaticResource FoundationSettingTitleStyle}" />
                                                    <TextBlock Text="If Steam grabs the controller first, try to reclaim it. Enabling this also turns on legacy exclusive access." Style="{StaticResource FoundationSettingDescriptionStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox x:Name="reclaimSteamInputCk" Style="{StaticResource FoundationToggleSwitchStyle}" AutomationProperties.Name="Reclaim from Steam Input"
                                                              IsChecked="{Binding ReclaimSteamInput}" Click="ReclaimSteamInputCk_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Gestures" Style="{StaticResource FoundationSectionHeadingStyle}" />
                                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Swipe to switch profiles" Style="{StaticResource FoundationSettingTitleStyle}" />
                                                    <TextBlock Text="Swipe two fingers left or right on the touchpad to change profile." Style="{StaticResource FoundationSettingDescriptionStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="configSwipeProfilesBtn" Content="Choose profiles" Margin="0,0,16,0" Style="{StaticResource FoundationButtonStyle}"
                                                            Click="ConfigSwipeProfilesBtn_Click" ToolTip="Choose which profiles the swipe gesture switches between" />
                                                    <CheckBox x:Name="swipeTouchCk" Style="{StaticResource FoundationToggleSwitchStyle}" AutomationProperties.Name="Swipe to switch profiles"
                                                              IsChecked="{Binding SwipeTouchSwitchProfile}" Click="SwipeTouchCk_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Bluetooth and battery" Style="{StaticResource FoundationSectionHeadingStyle}" />
                                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Disconnect Bluetooth when stopping" Style="{StaticResource FoundationSettingTitleStyle}" />
                                                    <TextBlock Text="Turn wireless controllers off when PureDS4 stops." Style="{StaticResource FoundationSettingDescriptionStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" AutomationProperties.Name="Disconnect Bluetooth when stopping"
                                                              IsChecked="{Binding DisconnectBTStop}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Quick charge" Style="{StaticResource FoundationSettingTitleStyle}" />
                                                    <TextBlock Text="Disconnect Bluetooth automatically when the controller is plugged in by USB." Style="{StaticResource FoundationSettingDescriptionStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" AutomationProperties.Name="Quick charge"
                                                              IsChecked="{Binding QuickCharge}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Flash the lightbar on long report intervals" Style="{StaticResource FoundationSettingTitleStyle}" />
                                                    <TextBlock Text="Warn when the average time between controller reports exceeds the threshold; this is not game latency." Style="{StaticResource FoundationSettingDescriptionStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" AutomationProperties.Name="Flash the lightbar on long report intervals"
                                                              IsChecked="{Binding FlashHighLatency}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource FoundationSettingSubRowStyle}" IsEnabled="{Binding FlashHighLatency,FallbackValue='False'}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Report interval threshold" VerticalAlignment="Center" Style="{StaticResource FoundationSettingTitleStyle}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <xctk:IntegerUpDown d:IsHidden="True" Width="80" Style="{StaticResource FoundationNumericInputStyle}" AutomationProperties.Name="Report interval threshold in milliseconds"
                                                                        Value="{Binding FlashHighLatencyAt}" Increment="1" Maximum="100" Minimum="10" />
                                                    <TextBlock Text="ms" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource FoundationSecondaryTextStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Game output">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Style="{StaticResource SettingsPageStyle}">
                                    <TextBlock Text="Game output" Style="{StaticResource FoundationPageTitleStyle}" />
                                    <TextBlock Text="The virtual controller that games see." Margin="0,3,0,0" Style="{StaticResource FoundationSecondaryTextStyle}" />
                                    <TextBlock Text="Virtual controller" Style="{StaticResource FoundationSectionHeadingStyle}" />
                                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Game output runtime" Style="{StaticResource FoundationSettingTitleStyle}" />
                                                <TextBlock x:Name="viiperSummaryText" Text="Checking whether game output is ready."
                                                           Style="{StaticResource FoundationSettingDescriptionStyle}" />
                                            </StackPanel>
                                            <local:StatusChip x:Name="viiperStatusChip" Grid.Column="1" Label="Checking game output" State="Neutral"
                                                              VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Maintenance" Style="{StaticResource FoundationSettingTitleStyle}" />
                                                    <TextBlock Text="Install or repair the virtual controller used by game output, including Xbox 360 output." Style="{StaticResource FoundationSettingDescriptionStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="viiperRefreshBtn" Content="Refresh" Margin="0,0,8,0" Style="{StaticResource FoundationButtonStyle}" Click="ViiperRefreshBtn_Click" />
                                                    <Button x:Name="viiperSetupBtn" Content="Set up / repair" Style="{StaticResource FoundationButtonStyle}" Click="ViiperSetupBtn_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Prompt when setup is needed" Style="{StaticResource FoundationSettingTitleStyle}" />
                                                    <TextBlock Text="Offer setup automatically when game output isn't ready. Set up and Refresh stay available here." Style="{StaticResource FoundationSettingDescriptionStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox Style="{StaticResource FoundationToggleSwitchStyle}" AutomationProperties.Name="Prompt when setup is needed"
                                                              IsChecked="{Binding PromptForViiperSetup}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource FoundationSettingRowStyle}">
                                        <Expander Header="Technical details" VerticalAlignment="Center">
                                            <StackPanel Margin="0,6,0,0">
