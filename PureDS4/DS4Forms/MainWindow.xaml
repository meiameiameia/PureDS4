                                                             IsEnabled="{Binding UseOSCSender,Mode=OneWay}"
                                                             Text="{Binding OscSenderAddress, UpdateSourceTrigger=LostFocus,FallbackValue='127.0.0.1'}" />
                                                    <TextBlock Text="Port" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource FoundationSecondaryTextStyle}" />
                                                    <xctk:IntegerUpDown d:IsHidden="False" x:Name="oscSendPort" Width="90" Margin="0,0,16,0" Style="{StaticResource FoundationNumericInputStyle}"
                                                                        AutomationProperties.Name="Monitoring service port" IsEnabled="{Binding UseOSCSender}"
                                                                        Value="{Binding OscSendPort, UpdateSourceTrigger=LostFocus,FallbackValue='9000'}" Increment="1" Maximum="65535" Minimum="0" />
                                                    <CheckBox x:Name="useOscSenderCk" Style="{StaticResource FoundationToggleSwitchStyle}" AutomationProperties.Name="Monitoring service"
                                                              IsChecked="{Binding UseOSCSender}" Click="UseOscSenderCk_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Motion server (DSU)" Style="{StaticResource FoundationSectionHeadingStyle}" />
