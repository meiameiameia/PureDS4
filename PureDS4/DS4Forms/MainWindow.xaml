                                    <Button Grid.Column="1" Content="Open" Tag="diagnostics" Margin="12,0,0,0" Click="ToolsMenuItem_Click" Style="{StaticResource FoundationButtonStyle}" AutomationProperties.Name="Open input diagnostics" />
                                </Grid>
                            </Border>
