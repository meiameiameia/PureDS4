                                <Button x:Name="html5GameBtn" Margin="0,0,6,6" Style="{StaticResource ClassicCompactButtonStyle}" Click="Html5GameBtn_Click" Content="{lex:Loc GamepadTest}" />
                                <Button x:Name="xinputCheckerBtn" Margin="0,0,6,6" Style="{StaticResource ClassicCompactButtonStyle}" Click="XinputCheckerBtn_Click" Content="{lex:Loc XInputChecker}" />
                                <Button x:Name="hidHideBtn" Margin="0,0,6,6" Style="{StaticResource ClassicCompactButtonStyle}" Click="HidHideBtn_Click" Content="Controller protection settings" Visibility="{Binding HidHideClientFound, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                <Button x:Name="driverSetupBtn" Margin="0,0,6,6" Style="{StaticResource ClassicCompactButtonStyle}" Click="DriverSetupBtn_Click" Content="{lex:Loc DriverSetup}" />
                                <Button x:Name="checkUpdatesBtn" Margin="0,0,6,6" Style="{StaticResource ClassicCompactButtonStyle}" Click="CheckUpdatesBtn_Click" Content="{lex:Loc CheckUpdateNow}" />
                                <Button x:Name="checklogViewBtn" Margin="0,0,6,6" Style="{StaticResource ClassicCompactButtonStyle}" Click="ChecklogViewBtn_Click" Content="{lex:Loc Changelog}" />
                            </WrapPanel>
                        </GroupBox>

                        <Button x:Name="deviceOptionSettingsBtn"
                                HorizontalAlignment="Left"
                                Margin="{StaticResource spaceMargin}"
                                MaxWidth="140"
                                Content="{lex:Loc DeviceOptions}"
                                Click="DeviceOptionSettingsBtn_Click" Style="{StaticResource ClassicCompactButtonStyle}" />
                                </StackPanel>
                            </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>

            </TabItem>
            <TabItem x:Name="toolsTab" Header="Tools" Tag="&#xE713;">
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Tools" Style="{StaticResource FoundationPageTitleStyle}" />
                        <TextBlock Text="Specialist diagnostics and controller-output utilities. These destinations do not become permanent primary tabs."
                                   Margin="0,3,0,0"
                                   Style="{StaticResource FoundationSecondaryTextStyle}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Width="760" HorizontalAlignment="Left">
                            <Border Style="{StaticResource FoundationPropertyGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Auto Profiles" Style="{StaticResource FoundationGroupTitleStyle}" /><TextBlock Text="Associate profiles with games and applications." Style="{StaticResource FoundationSecondaryTextStyle}" /></StackPanel>
                                    <Button Grid.Column="1" Content="Open" Tag="auto" Margin="12,0,0,0" Click="ToolsMenuItem_Click" Style="{StaticResource FoundationButtonStyle}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource FoundationPropertyGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Output Slots" Style="{StaticResource FoundationGroupTitleStyle}" /><TextBlock Text="Inspect and reserve virtual game-output slots." Style="{StaticResource FoundationSecondaryTextStyle}" /></StackPanel>
                                    <Button Grid.Column="1" Content="Open" Tag="slots" Margin="12,0,0,0" Click="ToolsMenuItem_Click" Style="{StaticResource FoundationButtonStyle}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource FoundationPropertyGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Log" Style="{StaticResource FoundationGroupTitleStyle}" /><TextBlock Text="Search, filter, and copy runtime events." Style="{StaticResource FoundationSecondaryTextStyle}" /></StackPanel>
                                    <Button Grid.Column="1" Content="Open" Tag="log" Margin="12,0,0,0" Click="ToolsMenuItem_Click" Style="{StaticResource FoundationButtonStyle}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource FoundationPropertyGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Hotkeys and About" Style="{StaticResource FoundationGroupTitleStyle}" /><TextBlock Text="View application identity, version, links, and keyboard shortcuts." Style="{StaticResource FoundationSecondaryTextStyle}" /></StackPanel>
                                    <Button Grid.Column="1" Content="Open" Margin="12,0,0,0" Click="AboutBtn_Click" Style="{StaticResource FoundationButtonStyle}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource FoundationPropertyGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Import from DS4Windows" Style="{StaticResource FoundationGroupTitleStyle}" /><TextBlock Text="Copy game profiles from an existing DS4Windows or DS4Windows Reworked installation into PureDS4. DS4Windows' own files are never changed or removed." Style="{StaticResource FoundationSecondaryTextStyle}" /></StackPanel>
                                    <Button Grid.Column="1" Content="Open" Margin="12,0,0,0" Click="ImportLegacyProfilesBtn_Click" Style="{StaticResource FoundationButtonStyle}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource FoundationPropertyGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="DS4Windows removal plan" Style="{StaticResource FoundationGroupTitleStyle}" /><TextBlock Text="See exactly what removing a detected DS4Windows or DS4Windows Reworked installation would involve. This only describes; it does not remove anything." Style="{StaticResource FoundationSecondaryTextStyle}" /></StackPanel>
                                    <Button Grid.Column="1" Content="Open" Margin="12,0,0,0" Click="ShowLegacyRemovalPlanBtn_Click" Style="{StaticResource FoundationButtonStyle}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem x:Name="logTab" Header="{lex:Loc Log}" Tag="&#xE9D9;" Visibility="Collapsed" Style="{StaticResource BridgeHiddenToolTabItemStyle}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Runtime log" Style="{StaticResource FoundationPageTitleStyle}" />
                            <TextBlock Text="Search, inspect, and export diagnostic events."
                                       Margin="0,3,0,0" Style="{StaticResource FoundationSecondaryTextStyle}" />
                        </StackPanel>
                        <TextBox Grid.Column="1" x:Name="logSearchTextBox" Margin="12,0,0,0"
                                 ToolTip="Search log messages" AutomationProperties.Name="Search log messages"
                                 TextChanged="LogFilter_Changed" />
                        <TextBlock Grid.Column="1" Text="Search messages" IsHitTestVisible="False"
                                                           Margin="22,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=logSearchTextBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ComboBox Grid.Column="2" x:Name="logSeverityFilter" Margin="8,0,0,0"
                                  SelectedIndex="0" SelectionChanged="LogFilter_Changed"
                                  AutomationProperties.Name="Log severity filter">
                            <ComboBoxItem Content="All events" />
                            <ComboBoxItem Content="Warnings" />
                        </ComboBox>
                        <CheckBox Grid.Column="3" x:Name="logAutoScrollCheckBox" Margin="12,0,0,0"
                                  Content="Follow new events" IsChecked="True" VerticalAlignment="Center" />
                    </Grid>
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                            Padding="12,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Time" Style="{StaticResource FoundationColumnHeaderStyle}" />
                            <TextBlock Grid.Column="1" Text="Severity" Style="{StaticResource FoundationColumnHeaderStyle}" />
                            <TextBlock Grid.Column="2" Text="Message" Style="{StaticResource FoundationColumnHeaderStyle}" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListView x:Name="logListView" Style="{StaticResource FoundationTableListViewStyle}"
                                  BorderThickness="1,0,1,1" MouseDoubleClick="LogListView_MouseDoubleClick">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource FoundationTableListItemStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="12,5" />
                                    <Setter Property="MinHeight" Value="30" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Datetime, StringFormat=\{0:G\}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Severity}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource FoundationBodyTextStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Warning}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource StateWarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Border Grid.Row="1" Style="{StaticResource FoundationToolbarBarStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Copy selected" Click="CopySelectedLogBtn_Click"
                                        Style="{StaticResource FoundationToolbarButtonStyle}" />
                                <Button x:Name="exportLogBtn" Content="{lex:Loc Export}" Click="ExportLogBtn_Click"
                                        Style="{StaticResource FoundationToolbarButtonStyle}" />
                                <Button x:Name="clearLogBtn" Content="{lex:Loc Clear}" Click="ClearLogBtn_Click"
                                        Style="{StaticResource FoundationToolbarButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>
            <local:BusyOverlay x:Name="exposureBusyOverlay"
                               Panel.ZIndex="100"
                               Title="Changing controller exposure"
                               Message="PureDS4 is safely updating physical input and game output. Do not disconnect the controller." />
    </Grid>
</DockPanel>
</Window>
