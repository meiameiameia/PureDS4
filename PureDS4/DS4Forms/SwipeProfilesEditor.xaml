<Window x:Class="DS4WinWPF.DS4Forms.SwipeProfilesEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Swipe profile rotation" Height="560" Width="520"
        MinHeight="420" MinWidth="420" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{DynamicResource WindowStyle}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Swipe profile rotation" Style="{StaticResource FoundationPageTitleStyle}" />
            <TextBlock Text="Choose which profiles the two-finger touchpad swipe may cycle through. With none selected, every profile remains available."
                       TextWrapping="Wrap" Margin="0,4,0,0"
                       Style="{StaticResource FoundationSecondaryTextStyle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource FoundationToolbarBarStyle}" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="selectAllBtn" Content="Select all" Click="SelectAllBtn_Click"
                        Style="{StaticResource FoundationToolbarButtonStyle}" />
                <Button x:Name="clearAllBtn" Content="Clear all" Margin="8,0,0,0"
                        Click="ClearAllBtn_Click" Style="{StaticResource FoundationToolbarButtonStyle}" />
            </StackPanel>
        </Border>

        <ListBox Grid.Row="2" x:Name="profilesListBox" ItemsSource="{Binding Items}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsAllowed, Mode=TwoWay}"
                              Margin="4,2" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="cancelBtn" Content="Cancel" MinWidth="88" IsCancel="True" Click="CancelBtn_Click" />
            <Button x:Name="okBtn" Content="Save" MinWidth="88" Margin="8,0,0,0"
                    IsDefault="True" Click="OkBtn_Click"
                    Style="{StaticResource FoundationPrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
