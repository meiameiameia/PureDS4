<Window x:Class="DS4WinWPF.DS4Forms.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="About PureDS4" Icon="/PureDS4;component/Resources/DS4W.ico" Height="600" Width="760"
        MinHeight="480" MinWidth="640" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource WindowStyle}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="/PureDS4;component/Resources/AppIcon.png"
                   Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   AutomationProperties.Name="PureDS4 controller icon" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="PureDS4" FontSize="22" Style="{StaticResource FoundationPageTitleStyle}" />
                <TextBlock Text="A focused Windows tool for the DualShock 4"
                           Margin="0,3,0,0" Style="{StaticResource FoundationSecondaryTextStyle}" />
                <TextBlock x:Name="versionText" Margin="0,6,0,0"
                           Style="{StaticResource FoundationSecondaryTextStyle}" />
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" x:Name="aboutTabs" SelectedIndex="0"
                    Style="{StaticResource FoundationDialogTabsStyle}" AutomationProperties.Name="About PureDS4 sections">
            <TabItem Header="_Overview">
                <ScrollViewer x:Name="overviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,0" TextElement.FontWeight="Normal">
                        <TextBlock Text="Built around the DualShock 4" Style="{StaticResource FoundationGroupTitleStyle}" />
                        <TextBlock Margin="0,6,0,12" TextWrapping="Wrap" Style="{StaticResource FoundationBodyTextStyle}"
                                   Text="PureDS4 is an independently maintained fork of hbashton's DS4Windows for Windows. It supports the DualShock 4 over USB and Bluetooth." />
                        <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" Style="{StaticResource FoundationBodyTextStyle}"
                                   Text="Use Xbox 360 or DS4 game output, with profiles, remapping and controller adjustments. You can also switch a controller to direct/native use while PureDS4 stays open." />
                        <TextBlock Margin="0,0,0,16" Style="{StaticResource FoundationSecondaryTextStyle}"
                                   Text="For DualSense, DualSense Edge, Switch Pro, Joy-Con or other controller families, use DS4Windows instead. DualShock 3 is not supported by this release." />
                        <Border Style="{StaticResource FoundationPropertyGroupStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Project" VerticalAlignment="Center" Style="{StaticResource FoundationColumnHeaderStyle}" />
                                <Button Grid.Column="1" Content="Open source repository" HorizontalAlignment="Left"
                                        Click="SourceLink_Click" Style="{StaticResource FoundationLinkButtonStyle}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource FoundationPropertyGroupStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Upstream" VerticalAlignment="Center" Style="{StaticResource FoundationColumnHeaderStyle}" />
                                <Button Grid.Column="1" Content="hbashton/DS4Windows" HorizontalAlignment="Left"
                                        Click="UpstreamLink_Click" Style="{StaticResource FoundationLinkButtonStyle}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource FoundationPropertyGroupStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="License" VerticalAlignment="Center" Style="{StaticResource FoundationColumnHeaderStyle}" />
                                <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                           Style="{StaticResource FoundationBodyTextStyle}"
                                           Text="GPL-3.0-or-later. You may redistribute and modify this software under the license terms. No warranty is provided." />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="_Shortcuts">
                <ScrollViewer x:Name="shortcutsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,0" TextElement.FontWeight="Normal">
                        <TextBlock Text="Controller shortcuts" Style="{StaticResource FoundationGroupTitleStyle}" />
                        <TextBlock Text="Shortcuts depend on the active profile and enabled features."
                                   Margin="0,4,0,12" Style="{StaticResource FoundationSecondaryTextStyle}" />
                        <Border Style="{StaticResource FoundationPropertyRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="PS + Options, or hold PS for 10 seconds" Margin="0,0,16,0" TextWrapping="Wrap"
                                           Style="{StaticResource FoundationGroupTitleStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Disconnect a Bluetooth controller."
                                           VerticalAlignment="Center" Style="{StaticResource FoundationSecondaryTextStyle}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource FoundationPropertyRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Touchpad + PS" Margin="0,0,16,0" TextWrapping="Wrap"
                                           Style="{StaticResource FoundationGroupTitleStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Toggle touchpad movement while preserving clicks."
                                           VerticalAlignment="Center" Style="{StaticResource FoundationSecondaryTextStyle}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource FoundationPropertyRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Two-finger swipe left or right" Margin="0,0,16,0" TextWrapping="Wrap"
                                           Style="{StaticResource FoundationGroupTitleStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Cycle profiles when swipe profiles are enabled."
                                           VerticalAlignment="Center" Style="{StaticResource FoundationSecondaryTextStyle}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource FoundationPropertyRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Touchpad gestures" Margin="0,0,16,0" TextWrapping="Wrap"
                                           Style="{StaticResource FoundationGroupTitleStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Two-finger vertical swipe scrolls; tap-and-hold starts a left-button drag when enabled."
                                           VerticalAlignment="Center" Style="{StaticResource FoundationSecondaryTextStyle}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="Mapping terms" Style="{StaticResource FoundationGroupTitleStyle}" Margin="0,10,0,8" />
                        <TextBlock Text="Toggle keeps a mapping held until pressed again. Macro assigns a sequence. Scan Code uses low-level keyboard codes required by some games. Shift Modifier exposes a second mapping layer."
                                   TextWrapping="Wrap" Style="{StaticResource FoundationBodyTextStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="_Licenses and credits">
                <ScrollViewer x:Name="licensesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,0" TextElement.FontWeight="Normal">
                        <TextBlock Text="Open-source lineage" Style="{StaticResource FoundationGroupTitleStyle}" />
                        <TextBlock Margin="0,5,0,14" TextWrapping="Wrap"
                                   Style="{StaticResource FoundationBodyTextStyle}"
                                   Text="PureDS4 builds on hbashton's DS4Windows and the work of the DS4Windows authors and contributors before it. Original authors and contributors retain their respective copyrights." />
                        <TextBlock Text="Bundled components" Style="{StaticResource FoundationGroupTitleStyle}" />
                        <TextBlock Margin="0,5,0,14" TextWrapping="Wrap"
                                   Style="{StaticResource FoundationBodyTextStyle}"
                                   Text="Bundled and linked components remain governed by their own license terms. Driver, codec, and artwork notices ship with the application; pinned third-party binary provenance is maintained in the repository." />
                        <TextBlock Text="Required notices" Style="{StaticResource FoundationGroupTitleStyle}" />
                        <TextBlock Margin="0,5,0,14" TextWrapping="Wrap"
                                   Style="{StaticResource FoundationBodyTextStyle}"
                                   Text="The complete GPL text and bundled third-party license notices are included with the distribution. Component versions and source locations are documented in the repository. No warranty is provided." />
                        <Button Content="Open repository notices" HorizontalAlignment="Left"
                                Click="NoticesLink_Click" Style="{StaticResource FoundationToolbarButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Style="{StaticResource FoundationDialogActionsStyle}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Maintained by meiameiameia" Margin="0,0,16,0" VerticalAlignment="Center"
                           Style="{StaticResource FoundationSecondaryTextStyle}" />
                <Button Grid.Column="1" x:Name="aboutCloseBtn" Content="Close" IsCancel="True" MinWidth="88"
                        AutomationProperties.Name="Close About PureDS4" Style="{StaticResource FoundationPrimaryButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>
