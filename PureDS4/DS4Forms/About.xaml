<Window x:Class="DS4WinWPF.DS4Forms.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="About PureDS4" Height="600" Width="760"
        MinHeight="480" MinWidth="640" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource WindowStyle}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="/PureDS4;component/Resources/AppIcon.png"
                   Width="48" Height="48" Margin="0,0,12,0"
                   AutomationProperties.Name="PureDS4 controller icon" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="PureDS4" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="A focused Windows tool for the DualShock 4"
                           Margin="0,3,0,0" Style="{StaticResource FoundationSecondaryTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                <TextBlock x:Name="versionText" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Text="Maintained by meiameiameia" Margin="0,3,0,0"
                           Style="{StaticResource FoundationSecondaryTextStyle}" />
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="About this derivative" Style="{StaticResource FoundationGroupTitleStyle}" />
                        <TextBlock Margin="0,6,0,16" TextWrapping="Wrap"
                                   Text="PureDS4 continues the DS4Windows lineage as a deliberately narrow tool for the DualShock 4, with a focused desktop-tool interface, explicit game-output status, and safer controller exposure transitions. If you use a DualSense, DualSense Edge, Switch Pro, Joy-Con or any other controller family, use DS4Windows instead. DualShock 3 is a planned future milestone and is not supported by this release." />
                        <Border Style="{StaticResource FoundationPropertyGroupStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Project" Style="{StaticResource FoundationColumnHeaderStyle}" />
                                <Button Grid.Column="1" Content="Open source repository" HorizontalAlignment="Left"
                                        Click="SourceLink_Click" Style="{StaticResource FoundationLinkButtonStyle}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource FoundationPropertyGroupStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Upstream lineage" Style="{StaticResource FoundationColumnHeaderStyle}" />
                                <Button Grid.Column="1" Content="hbashton/DS4Windows" HorizontalAlignment="Left"
                                        Click="UpstreamLink_Click" Style="{StaticResource FoundationLinkButtonStyle}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource FoundationPropertyGroupStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="License" Style="{StaticResource FoundationColumnHeaderStyle}" />
                                <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                           Text="GNU General Public License v3.0. This software comes with no warranty. You may redistribute and modify it under the license terms." />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Hotkeys">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Controller shortcuts" Style="{StaticResource FoundationGroupTitleStyle}" />
                        <TextBlock Text="Shortcuts depend on the active profile and enabled features."
                                   Margin="0,4,0,12" Style="{StaticResource FoundationSecondaryTextStyle}" />
                        <TextBlock Text="PS + Options, or hold PS for 10 seconds" FontWeight="SemiBold" />
                        <TextBlock Text="Disconnect a Bluetooth controller." Margin="0,2,0,12" Style="{StaticResource FoundationSecondaryTextStyle}" />
                        <TextBlock Text="Touchpad + PS" FontWeight="SemiBold" />
                        <TextBlock Text="Toggle touchpad movement while preserving clicks." Margin="0,2,0,12" Style="{StaticResource FoundationSecondaryTextStyle}" />
                        <TextBlock Text="Two-finger touchpad swipe left or right" FontWeight="SemiBold" />
                        <TextBlock Text="Cycle profiles when swipe profiles are enabled." Margin="0,2,0,12" Style="{StaticResource FoundationSecondaryTextStyle}" />
                        <TextBlock Text="Touchpad gestures" FontWeight="SemiBold" />
                        <TextBlock Text="Two-finger vertical swipe scrolls; tap-and-hold starts a left-button drag when enabled."
                                   Margin="0,2,0,12" Style="{StaticResource FoundationSecondaryTextStyle}" />
                        <TextBlock Text="Mapping terms" Style="{StaticResource FoundationGroupTitleStyle}" Margin="0,10,0,8" />
                        <TextBlock Text="Toggle keeps a mapping held until pressed again. Macro assigns a sequence. Scan Code uses low-level keyboard codes required by some games. Shift Modifier exposes a second mapping layer."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Licenses and acknowledgements">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Open-source lineage" Style="{StaticResource FoundationGroupTitleStyle}" />
                        <TextBlock Margin="0,5,0,14" TextWrapping="Wrap"
                                   Text="PureDS4 is a modified DS4Windows derivative. Original authors and contributors retain their respective copyrights." />
                        <TextBlock Text="Bundled components" Style="{StaticResource FoundationGroupTitleStyle}" />
                        <TextBlock Margin="0,5,0,14" TextWrapping="Wrap"
                                   Text="Bundled and linked components remain governed by their own license terms. Driver, codec, and artwork notices ship with the application; pinned third-party binary provenance is maintained in the repository." />
                        <TextBlock Text="Required notices" Style="{StaticResource FoundationGroupTitleStyle}" />
                        <TextBlock Margin="0,5,0,14" TextWrapping="Wrap"
                                   Text="The complete GPL text and bundled third-party license notices are included with the distribution. Component versions and source locations are documented in the repository. No warranty is provided." />
                        <Button Content="Open repository notices" HorizontalAlignment="Left"
                                Click="NoticesLink_Click" Style="{StaticResource FoundationToolbarButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2" Content="Close" IsCancel="True" MinWidth="90"
                HorizontalAlignment="Right" Margin="0,16,0,0"
                Style="{StaticResource FoundationPrimaryButtonStyle}" />
    </Grid>
</Window>
