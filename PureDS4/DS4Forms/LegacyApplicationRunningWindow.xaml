<Window x:Class="DS4WinWPF.DS4Forms.LegacyApplicationRunningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PureDS4 found another controller application running"
        SizeToContent="Height" Width="560" MinWidth="520"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Style="{DynamicResource WindowStyle}">
    <DockPanel Margin="16">
        <Border x:Name="migrationActions" DockPanel.Dock="Bottom" Style="{StaticResource FoundationDialogActionsStyle}">
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="exitButton" Content="Exit PureDS4" Click="ExitBtn_Click" MinWidth="120"
                        Margin="0,0,8,0" Style="{StaticResource FoundationButtonStyle}"
                        AutomationProperties.HelpText="Close PureDS4 without checking again." />
                <Button x:Name="checkAgainButton" Content="Check Again" Click="CheckAgainBtn_Click" MinWidth="120"
                        Style="{StaticResource FoundationPrimaryButtonStyle}"
                        AutomationProperties.HelpText="Check again after closing the other application." />
            </WrapPanel>
        </Border>
        <ScrollViewer x:Name="migrationScroll" MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Width="{Binding ViewportWidth, ElementName=migrationScroll}">
                <TextBlock x:Name="headingText" Style="{StaticResource FoundationPageTitleStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="explanationText" Margin="0,8,0,0" TextWrapping="Wrap"
                           Style="{StaticResource FoundationSecondaryTextStyle}" />
                <TextBlock x:Name="statusText" Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource StateWarningBrush}" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
