<UserControl x:Class="DS4WinWPF.DS4Forms.AutoProfiles"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:LocalizeDictionary.DesignCulture=""
             lex:ResxLocalizationProvider.DefaultAssembly="PureDS4"
             lex:ResxLocalizationProvider.DefaultDictionary="Strings"
             xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
             xmlns:entity="clr-namespace:DS4WinWPF"
             mc:Ignorable="d" 
             d:DesignHeight="380" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="AutoProfileRuleItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RuleCard" Background="{DynamicResource SurfaceBaseBrush}"
                                BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="2,0,0,1"
                                CornerRadius="0" Padding="12,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RuleCard" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RuleCard" Property="Background" Value="{DynamicResource NavigationSelectionColor}" />
                                <Setter TargetName="RuleCard" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AutoProfileMetaLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,1,10,1" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="AutoProfileMetaValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="16,8">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Auto profiles" Style="{StaticResource FoundationPageTitleStyle}" />
            <TextBlock Text="Switch profiles automatically when a game or application takes focus."
                       Margin="0,3,0,0" Style="{StaticResource FoundationSecondaryTextStyle}" />
        </StackPanel>
            <Border DockPanel.Dock="Right" Width="304" Margin="12,0,0,0"
                    Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1,0,0,0" CornerRadius="0" Padding="12">
            <ScrollViewer x:Name="sidebarScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Thickness x:Key="spaceMargin" Bottom="8" />
                </ScrollViewer.Resources>
                <StackPanel x:Name="outerEditControlsPanel" Margin="0,0,8,0" Grid.IsSharedSizeScope="True">
                    <StackPanel.Resources>
                        <CollectionViewSource x:Key="profileCollection" Source="{Binding ProfileList.ProfileListCol,Mode=OneWay}" />
                    </StackPanel.Resources>

                    <StackPanel Margin="0,4,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled, ElementName=editControlsPanel}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="No rule selected" Style="{StaticResource FoundationGroupTitleStyle}" />
                        <TextBlock Text="Select a rule to choose the profile it loads, or use Add programs to create one."
                                   Margin="0,4,0,0" Style="{StaticResource FoundationSecondaryTextStyle}" />
                    </StackPanel>

                    <StackPanel x:Name="editControlsPanel" IsEnabled="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Selected rule" Margin="0,0,0,8" Style="{StaticResource FoundationSectionHeadingStyle}" />
                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <Button x:Name="removeAutoBtn" Content="Remove" Margin="0,0,6,0" Style="{StaticResource FoundationButtonStyle}"
                                    IsEnabled="{Binding Exists}" Click="RemoveAutoBtn_Click" />
                            <Button x:Name="duplicateAutoBtn" Content="Duplicate" Margin="0,0,6,0" Style="{StaticResource FoundationButtonStyle}"
                                    Click="DuplicateAutoBtn_Click" />
                            <Button x:Name="saveAutoBtn" Content="Save" Style="{StaticResource FoundationPrimaryButtonStyle}"
                                    Click="SaveAutoBtn_Click" />
                        </UniformGrid>
                        <Grid Margin="0,0,0,8" MinHeight="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Same profile for every controller" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Margin="0,0,12,0" Style="{StaticResource FoundationSettingTitleStyle}" />
                            <CheckBox Grid.Column="1" Style="{StaticResource FoundationToggleSwitchStyle}" AutomationProperties.Name="Same profile for every controller"
                                      IsChecked="{Binding ApplyToAllControllers}" />
                        </Grid>
                        <Grid x:Name="autoProfilesGrid" Margin="0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="AutoProfileLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Label Content="{lex:Loc Controller1Text}" Margin="{StaticResource spaceMargin}"
                                   VerticalAlignment="Center" />
                            <ComboBox x:Name="cont1AutoProf" Grid.Column="1" Margin="{StaticResource spaceMargin}"
                              SelectedIndex="{Binding SelectedIndexCon1}">
                                <ComboBox.Resources>
                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.Resources>
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="(none)"/>
                                        <CollectionContainer x:Name="cont1AutoProfCol" Collection="{Binding Source={StaticResource profileCollection}}" />
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>

                            <Label Content="{lex:Loc Controller2Text}" Grid.Row="1" Margin="{StaticResource spaceMargin}"
                                   Visibility="{Binding ControllerSpecificProfilesVisible}" />
                            <ComboBox x:Name="cont2AutoProf" Grid.Row="1" Grid.Column="1" Margin="{StaticResource spaceMargin}"
                              Visibility="{Binding ControllerSpecificProfilesVisible}"
                              SelectedIndex="{Binding SelectedIndexCon2}">
                                <ComboBox.Resources>
                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.Resources>
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="(none)"/>
                                        <CollectionContainer x:Name="cont2AutoProfCol" Collection="{Binding Source={StaticResource profileCollection}}" />
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>

                            <Label Content="{lex:Loc Controller3Text}" Grid.Row="2" Margin="{StaticResource spaceMargin}"
                                   Visibility="{Binding ControllerSpecificProfilesVisible}" />
                            <ComboBox x:Name="cont3AutoProf" Grid.Row="2" Grid.Column="1" Margin="{StaticResource spaceMargin}"
                              Visibility="{Binding ControllerSpecificProfilesVisible}"
                              SelectedIndex="{Binding SelectedIndexCon3}">
                                <ComboBox.Resources>
                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.Resources>
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="(none)"/>
                                        <CollectionContainer x:Name="cont3AutoProfCol" Collection="{Binding Source={StaticResource profileCollection}}" />
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>

                            <Label Content="{lex:Loc Controller4Text}" Grid.Row="3" Margin="{StaticResource spaceMargin}"
                                   Visibility="{Binding ControllerSpecificProfilesVisible}" />
                            <ComboBox x:Name="cont4AutoProf" Grid.Row="3" Grid.Column="1" Margin="{StaticResource spaceMargin}"
                              Visibility="{Binding ControllerSpecificProfilesVisible}"
                              SelectedIndex="{Binding SelectedIndexCon4}">
                                <ComboBox.Resources>
                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.Resources>
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="(none)"/>
                                        <CollectionContainer x:Name="cont4AutoProfCol" Collection="{Binding Source={StaticResource profileCollection}}" />
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>

                        <Label Content="{lex:Loc Controller5Text}" Grid.Row="4" Visibility="{Binding ExpandedControllerSpecificProfilesVisible}" Margin="{StaticResource spaceMargin}" />
                        <ComboBox x:Name="cont5AutoProf" Grid.Row="4" Grid.Column="1" Visibility="{Binding ExpandedControllerSpecificProfilesVisible}" Margin="{StaticResource spaceMargin}"
                              SelectedIndex="{Binding SelectedIndexCon5}">
                                <ComboBox.Resources>
                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.Resources>
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="(none)"/>
                                        <CollectionContainer Collection="{Binding Source={StaticResource profileCollection}}" />
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>

                        <Label Content="{lex:Loc Controller6Text}" Grid.Row="5" Visibility="{Binding ExpandedControllerSpecificProfilesVisible}" Margin="{StaticResource spaceMargin}" />
                        <ComboBox x:Name="cont6AutoProf" Grid.Row="5" Grid.Column="1" Visibility="{Binding ExpandedControllerSpecificProfilesVisible}" Margin="{StaticResource spaceMargin}"
                              SelectedIndex="{Binding SelectedIndexCon6}">
                                <ComboBox.Resources>
                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.Resources>
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="(none)"/>
                                        <CollectionContainer Collection="{Binding Source={StaticResource profileCollection}}" />
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>


                        <Label Content="{lex:Loc Controller7Text}" Grid.Row="6" Visibility="{Binding ExpandedControllerSpecificProfilesVisible}" Margin="{StaticResource spaceMargin}" />
                        <ComboBox x:Name="cont7AutoProf" Grid.Row="6" Grid.Column="1" Visibility="{Binding ExpandedControllerSpecificProfilesVisible}" Margin="{StaticResource spaceMargin}"
                              SelectedIndex="{Binding SelectedIndexCon7}">
                                <ComboBox.Resources>
                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.Resources>
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="(none)"/>
                                        <CollectionContainer Collection="{Binding Source={StaticResource profileCollection}}" />
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>

                        <Label Content="{lex:Loc Controller8Text}" Grid.Row="7" Visibility="{Binding ExpandedControllerSpecificProfilesVisible}" Margin="{StaticResource spaceMargin}" />
                        <ComboBox x:Name="cont8AutoProf" Grid.Row="7" Grid.Column="1" Visibility="{Binding ExpandedControllerSpecificProfilesVisible}" Margin="{StaticResource spaceMargin}"
                              SelectedIndex="{Binding SelectedIndexCon8}">
                                <ComboBox.Resources>
                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.Resources>
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="(none)"/>
                                        <CollectionContainer Collection="{Binding Source={StaticResource profileCollection}}" />
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,4,0,8" MinHeight="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="Turn PureDS4 off" Style="{StaticResource FoundationSettingTitleStyle}" />
                                <TextBlock Text="While this program is active, for games with their own controller support."
                                           Style="{StaticResource FoundationSettingDescriptionStyle}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource FoundationToggleSwitchStyle}" AutomationProperties.Name="Turn PureDS4 off while this program is active"
                                      IsChecked="{Binding Turnoff}" />
                        </Grid>
                        <Grid Margin="{StaticResource spaceMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="AutoProfileLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Content="Device" Padding="0" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.DeviceOptionList, ElementName=outerEditControlsPanel}"
                                      DisplayMemberPath="DisplayName" SelectedValuePath="ChoiceValue"
                                      SelectedValue="{Binding DeviceOption}" />
                        </Grid>
                        <TextBlock Text="Program path" Margin="0,4,0,4" Style="{StaticResource FoundationSettingTitleStyle}" />
                        <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource spaceMargin}" ToolTip="{lex:Loc AutoProfPathTip}"
                                 AutomationProperties.Name="Program path"
                                 TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto" MaxHeight="90"/>

                        <TextBlock Text="Window title" Margin="0,4,0,4" Style="{StaticResource FoundationSettingTitleStyle}" />
                        <Grid>
                            <TextBox x:Name="mainTxtBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource spaceMargin}" ToolTip="{lex:Loc AutoProfTitleTip}"
                                     AutomationProperties.Name="Window title" />

                            <TextBlock Margin="5,2" MinWidth="50" Text="Any title" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=mainTxtBox, Path=Text.IsEmpty, Mode=OneWay}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding ElementName=mainTxtBox, Path=Text.IsEmpty, Mode=OneWay}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                        </Grid>
                    </StackPanel>

                    <Border Margin="0,16,0,0" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="All rules" Margin="0,8,0,8" Style="{StaticResource FoundationSectionHeadingStyle}" />
                            <Grid Margin="0,0,0,8" MinHeight="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Return to the default profile" Style="{StaticResource FoundationSettingTitleStyle}" />
                                    <TextBlock Text="When the active program matches no rule." Style="{StaticResource FoundationSettingDescriptionStyle}" />
                                </StackPanel>
                                <CheckBox x:Name="revertDefaultProfileOnUnknownCk" Grid.Column="1" Style="{StaticResource FoundationToggleSwitchStyle}"
                                          AutomationProperties.Name="Return to the default profile when no rule matches"
                                          IsChecked="{Binding RevertDefaultProfileOnUnknown}" />
                            </Grid>
                            <Grid Margin="0,0,0,8" MinHeight="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Log matching details" Style="{StaticResource FoundationSettingTitleStyle}" />
                                    <TextBlock Text="Write each rule decision to the log." Style="{StaticResource FoundationSettingDescriptionStyle}" />
                                </StackPanel>
                                <CheckBox x:Name="showAutoDebugCk" Grid.Column="1" Style="{StaticResource FoundationToggleSwitchStyle}"
                                          AutomationProperties.Name="Log matching details" Click="ShowAutoDebugCk_Click" />
                            </Grid>
                            <TextBlock Text="Announce profile switches" Margin="0,4,0,4" Style="{StaticResource FoundationSettingTitleStyle}" />
                            <ComboBox ItemsSource="{Binding DisplayProfileSwitchList}" DisplayMemberPath="DisplayName" SelectedValuePath="ChoiceValue"
                                      SelectedValue="{Binding ProfileSwitchChoice}" AutomationProperties.Name="Announce profile switches"
                                      Style="{StaticResource FoundationComboBoxStyle}" />
                        </StackPanel>
                    </Border>

            </StackPanel>
            </ScrollViewer>
            </Border>

        <DockPanel>
            <Border DockPanel.Dock="Top" Width="390" MaxWidth="390"
                    HorizontalAlignment="Left" Margin="0,0,0,10"
                    Background="{DynamicResource RaisedBackgroundColor}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    CornerRadius="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource MutedForegroundColor}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Search rules" IsHitTestVisible="False"
                               Margin="4,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=autoProfilesSearchTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="autoProfilesSearchTextBox" Grid.Column="1"
                             BorderThickness="0" Background="Transparent"
                             Padding="2,8" VerticalContentAlignment="Center"
                             TextChanged="AutoProfilesSearchTextBox_TextChanged"
                             ToolTip="Search by profile, window title, executable, or path" />
                    <Button x:Name="clearAutoProfilesSearchBtn" Grid.Column="2" Content="&#xE711;"
                            FontFamily="Segoe MDL2 Assets" FontSize="11"
                            Background="Transparent" BorderThickness="0"
                            Visibility="Collapsed" ToolTip="Clear search"
                            AutomationProperties.Name="Clear auto-profile search"
                            Click="ClearAutoProfilesSearchBtn_Click" />
                </Grid>
            </Border>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button x:Name="addProgramsBtn" Content="Add programs" Click="AddProgramsBtn_Click"
                        Style="{StaticResource FoundationPrimaryButtonStyle}" Margin="0,0,8,0">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="steamMenuItem" Header="{lex:Loc AddSteamGames}" Click="SteamMenuItem_Click" />
                            <MenuItem x:Name="startMenuItem" Header="{lex:Loc AddStartMenuPrograms}" Click="StartMenuItem_Click" />
                            <MenuItem x:Name="browseProgsMenuItem" Header="{lex:Loc AddDirectory}" Click="BrowseProgsMenuItem_Click" />
                            <MenuItem x:Name="browseAddProgMenuItem" Header="{lex:Loc BrowseOtherPrograms}" Click="BrowseAddProgMenuItem_Click" />
                            <Separator />
                            <MenuItem x:Name="windowTitleRuleMenuItem" Header="{lex:Loc AddWindowTitleRule}" Click="WindowTitleRuleMenuItem_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="hideUncheckedBtn" Content="Hide missing programs" Click="HideUncheckedBtn_Click"
                        Style="{StaticResource FoundationButtonStyle}" />
            </WrapPanel>
            <Grid>
            <StackPanel x:Name="autoProfilesEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False" Margin="0,0,0,40">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=programListLV, Path=HasItems}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="No auto-profile rules yet" HorizontalAlignment="Center"
                           Style="{StaticResource FoundationGroupTitleStyle}" />
                <TextBlock Text="Use Add programs to pick a game or application, then choose the profile it should load."
                           Margin="0,6,0,0" MaxWidth="360" TextAlignment="Center" TextWrapping="Wrap"
                           Style="{StaticResource FoundationSecondaryTextStyle}" />
            </StackPanel>
            <ListView x:Name="programListLV" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                      SelectedIndex="{Binding SelectedIndex}" SelectedItem="{Binding SelectedItem}"
                      ItemContainerStyle="{StaticResource AutoProfileRuleItemStyle}"
                      Background="Transparent" BorderThickness="0">
                <ListView.Template>
                    <!-- The theme's implicit ListView template draws a header rule that
                         shows as a stray line over the empty state. Rules need no header. -->
                    <ControlTemplate TargetType="ListView">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListView.Template>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding Exists,Mode=OneWay}" IsEnabled="False"
                                      VerticalAlignment="Top" Margin="0,7,10,0" />
                            <StackPanel Grid.Column="1">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Exeicon}" Width="28" Height="28" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Filename}" FontSize="13"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Filename}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{lex:Loc Path}" Style="{StaticResource AutoProfileMetaLabelStyle}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Path}" ToolTip="{Binding Path}"
                                               Style="{StaticResource AutoProfileMetaValueStyle}" />
                                    <TextBlock Grid.Row="1" Text="DEVICE" Style="{StaticResource AutoProfileMetaLabelStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeviceOption}"
                                               Style="{StaticResource AutoProfileMetaValueStyle}" />
                                    <TextBlock Grid.Row="2" Text="{lex:Loc WindowTitle}"
                                               Style="{StaticResource AutoProfileMetaLabelStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Title}"
                                               ToolTip="{Binding Title}" Style="{StaticResource AutoProfileMetaValueStyle}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{lex:Loc MoveUp}" Name="MoveUp" Click="MoveUpDownAutoBtn_Click"/>
                        <MenuItem Header="{lex:Loc MoveDown}" Name="MoveDown" Click="MoveUpDownAutoBtn_Click"/>
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>
            </Grid>
        </DockPanel>
    </DockPanel>
</UserControl>
