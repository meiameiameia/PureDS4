<Window x:Class="DS4WinWPF.DS4Forms.ControllerExposureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Use controller directly" Width="500" MinWidth="420"
        SizeToContent="Height" MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Style="{DynamicResource WindowStyle}">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Bottom" Style="{StaticResource FoundationDialogActionsStyle}">
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="cancelButton" Content="Cancel" MinWidth="88" Margin="0,0,8,0"
                        IsCancel="True" Style="{StaticResource FoundationButtonStyle}" />
                <Button x:Name="confirmButton" Content="Use controller directly" MinWidth="150"
                        IsDefault="True" Style="{StaticResource FoundationPrimaryButtonStyle}"
                        ContentTemplate="{StaticResource FoundationWrappedControlCaptionTemplate}" Click="ConfirmButton_Click" />
            </WrapPanel>
        </Border>
        <ScrollViewer x:Name="exposureScroll" MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Width="{Binding ViewportWidth, ElementName=exposureScroll}">
                <TextBlock Text="Use the controller directly?" Style="{StaticResource FoundationPageTitleStyle}" TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0" Text="PureDS4 will stop its virtual game output and let games see the original controller."
                           Style="{StaticResource FoundationBodyTextStyle}" TextWrapping="Wrap" />
                <TextBlock Margin="0,6,0,0" Text="Choose Use game output later to restore PureDS4's protected virtual controller."
                           Style="{StaticResource FoundationSecondaryTextStyle}" TextWrapping="Wrap" />
                <Border Style="{StaticResource FoundationPropertyGroupStyle}" Margin="0,16,0,0"
                        BorderBrush="{DynamicResource StateWarningBrush}" BorderThickness="3,1,1,1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="⚠" Margin="0,0,8,0" Foreground="{DynamicResource StateWarningBrush}"
                                   AutomationProperties.Name="Direct mode limitations" />
                        <TextBlock Grid.Column="1" Text="Profile remapping and virtual-controller features are unavailable in direct mode. Launch the game after switching."
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
