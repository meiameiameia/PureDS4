<Window x:Class="DS4WinWPF.DS4Forms.ControllerExposureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Use controller directly"
        Width="500"
        SizeToContent="Height"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        MinWidth="420"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Style="{DynamicResource WindowStyle}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Use the controller directly?"
                       Style="{StaticResource FoundationPageTitleStyle}" />
            <TextBlock Margin="0,8,0,0"
                       Text="PureDS4 will stop its virtual game output and let games see the original controller."
                       Style="{StaticResource FoundationBodyTextStyle}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,6,0,0"
                       Text="Choose Use game output later to restore PureDS4's protected virtual controller."
                       Style="{StaticResource FoundationSecondaryTextStyle}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Padding="10,8"
                Background="{DynamicResource SurfaceInsetBrush}"
                BorderBrush="{DynamicResource StateWarningBrush}"
                BorderThickness="3,1,1,1"
                CornerRadius="{StaticResource RadiusSmall}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="⚠" Margin="0,0,8,0"
                           Foreground="{DynamicResource StateWarningBrush}" />
                <TextBlock Grid.Column="1" Text="Profile remapping and virtual-controller features are unavailable in direct mode. Launch the game after switching."
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>
        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    MinWidth="88"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Style="{StaticResource FoundationButtonStyle}" />
            <Button Content="Use controller directly"
                    MinWidth="150"
                    IsDefault="True"
                    Style="{StaticResource FoundationPrimaryButtonStyle}"
                    Click="ConfirmButton_Click" />
        </StackPanel>
    </Grid>
</Window>
