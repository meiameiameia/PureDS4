<UserControl x:Class="DS4WinWPF.DS4Forms.DupBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:LocalizeDictionary.DesignCulture=""
             lex:ResxLocalizationProvider.DefaultAssembly="PureDS4"
             lex:ResxLocalizationProvider.DefaultDictionary="Strings"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,16,0">
            <Label Content="{lex:Loc Resources:TypeNewName}" Target="{Binding ElementName=profileTxt}"
                   Style="{StaticResource FoundationPropertyLabelStyle}" />
            <TextBox x:Name="profileTxt" TextWrapping="Wrap" Text="" MaxLines="1"
                     AutomationProperties.Name="New profile name"
                     Style="{StaticResource FoundationTextBoxStyle}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Button x:Name="saveBtn" Content="{lex:Loc Save}" MinWidth="72" Click="SaveBtn_Click"
                    Style="{StaticResource FoundationPrimaryButtonStyle}" />
            <Button x:Name="cancelBtn" Content="{lex:Loc Cancel}" MinWidth="72" Click="CancelBtn_Click"
                    Style="{StaticResource FoundationButtonStyle}" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
