<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        PureDS4 application shell.

        This dictionary only owns layout and component geometry. Theme colors live in
        DefaultTheme.xaml and DarkTheme.xaml so the existing runtime theme switch keeps
        working without rebuilding any views.

        BridgeCardStyle and the larger Bridge component styles below are transitional
        resources for unmigrated screens. New screen work should use the opt-in classic
        foundation styles instead of extending those card-oriented patterns.
    -->

    <!-- Compatibility names for views already migrated to the classic-derived
         direction. Geometry and interaction now come from Foundation.xaml. -->
    <Style x:Key="ClassicCompactButtonStyle" TargetType="Button" BasedOn="{StaticResource FoundationButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="ClassicCompactComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource FoundationComboBoxStyle}" />

    <Style x:Key="ClassicCompactCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource FoundationCheckBoxStyle}">
        <Setter Property="Margin" Value="0,2" />
    </Style>

    <Style x:Key="ClassicSectionHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource FoundationGroupTitleStyle}">
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="ClassicPropertyGroupStyle" TargetType="Border" BasedOn="{StaticResource FoundationPropertyGroupStyle}" />

    <Style x:Key="BridgeCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style x:Key="BridgeSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="FontSize" Value="{StaticResource TypePageTitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="BridgePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FoundationPrimaryButtonStyle}">
        <Setter Property="Padding" Value="{StaticResource ControlPaddingProminent}" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightProminent}" />
    </Style>

    <Style x:Key="BridgeSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FoundationButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="Padding" Value="{StaticResource ControlPaddingDefault}" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightDefault}" />
    </Style>

    <Style x:Key="BridgeProfileComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource FoundationComboBoxStyle}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="110" />
        <!-- Sits on the shared control scale. Surfaces that need the taller
             42 DIP box (Controller Overview) set Height and MinHeight locally. -->
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightDefault}" />
        <Setter Property="MaxDropDownHeight" Value="280" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemStyle}">
                    <Setter Property="Padding" Value="10,8" />
                    <Setter Property="Margin" Value="0,1" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="ItemChrome" Background="Transparent" CornerRadius="2"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource NavigationSelectionColor}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource NavigationSelectionColor}" />
                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="ProfileChrome" Background="{DynamicResource RaisedBackgroundColor}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Margin="12,0,7,0" VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch" IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding ItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                <Border Grid.Column="1" Background="{DynamicResource CardBackgroundColor}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1,0,0,0"
                                        CornerRadius="{StaticResource RadiusSmall}">
                                    <Path x:Name="ProfileArrow" Data="M 1 2 L 5 6 L 9 2"
                                          Width="10" Height="7" Stretch="Fill"
                                          Stroke="{DynamicResource MutedForegroundColor}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Fade">
                            <Border Margin="0,6,0,0" MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource CardBackgroundColor}"
                                    BorderBrush="{DynamicResource AccentColor}" BorderThickness="1"
                                    CornerRadius="2" Padding="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              CanContentScroll="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ProfileChrome" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            <Setter TargetName="ProfileArrow" Property="Stroke" Value="{DynamicResource AccentColor}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ProfileChrome" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="ProfileChrome" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            <Setter TargetName="ProfileChrome" Property="BorderThickness" Value="2" />
                            <Setter TargetName="ProfileArrow" Property="Stroke" Value="{DynamicResource AccentColor}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BridgeDescribedCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource FoundationCheckBoxStyle}">
        <Setter Property="Margin" Value="4,2,4,13" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Margin="3,0,0,0">
                        <TextBlock Text="{Binding}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundColor}" />
                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=ToolTip}"
                                   Margin="0,3,0,0" MaxWidth="620" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource MutedForegroundColor}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BridgeControllerCardItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid>
                        <Border x:Name="Card"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="8,7">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="SelectionIndicator" Width="3" Background="{DynamicResource AccentBrush}"
                                HorizontalAlignment="Left" Visibility="Collapsed" />
                        <Border x:Name="FocusRing" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="1"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Classic-derived main shell: compact task tabs and a plain work surface. -->
    <Style x:Key="BridgeNavigationTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}" />
        <Setter Property="Background" Value="Transparent" />
        <!-- TabControl copies the selected TabItem's content alignment onto
             itself, and the selected-content presenter follows it. Centring
             here made every page size to its own content and float in the
             middle of the window instead of filling it. The header is centred
             by the template below, which is where that belongs. -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabChrome" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- The selected TabItem also owns its page content. Hover must
                             follow the visible header, not the whole selected page. -->
                        <Trigger SourceName="TabChrome" Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource RaisedBackgroundColor}" />
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tool tabs use the existing TabControl content path without taking a
         permanent place in the primary navigation strip. -->
    <Style x:Key="BridgeHiddenToolTabItemStyle" TargetType="TabItem"
           BasedOn="{StaticResource BridgeNavigationTabItemStyle}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border Visibility="Collapsed" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BridgeMainTabControlStyle" TargetType="TabControl">
        <Setter Property="TabStripPlacement" Value="Top" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource BridgeNavigationTabItemStyle}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundColor}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid Background="{DynamicResource SurfaceBackgroundColor}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource SidebarBackgroundColor}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once" />
                        </Border>
                        <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BridgeToolMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource FoundationButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="BridgeColumnHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}" />
        <!-- Flush to the column edge. A per-cell margin here offset every header
             from the data cell beneath it. -->
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="BridgeProfileTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundColor}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
