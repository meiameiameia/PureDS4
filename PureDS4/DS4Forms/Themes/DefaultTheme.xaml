<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:DS4WinWPF.DS4Forms.Themes" xmlns:system="clr-namespace:System;assembly=mscorlib">
    <!-- Brushes -->
    <SolidColorBrush x:Key="ForegroundColor" Color="#FF20272C" />
    <SolidColorBrush x:Key="SecondaryColor" Color="#FFC8D9E5"  />
    <SolidColorBrush x:Key="AccentColor" Color="#FF2E647F" />
    <SolidColorBrush x:Key="BorderColor" Color="#FF65727C" />
    <SolidColorBrush x:Key="BackgroundColor" Color="#FFE0E6EA"/>
    <SolidColorBrush x:Key="SurfaceBackgroundColor" Color="#FFE0E6EA" />
    <SolidColorBrush x:Key="SidebarBackgroundColor" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundColor" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="RaisedBackgroundColor" Color="#FFF1F4F6" />
    <SolidColorBrush x:Key="NavigationSelectionColor" Color="#FFC8D9E5" />
    <SolidColorBrush x:Key="MutedForegroundColor" Color="#FF515E67" />
    <SolidColorBrush x:Key="SuccessColor" Color="#FF1F6B3A" />
    <SolidColorBrush x:Key="DangerColor" Color="#FFA42831" />

    <!-- Gate 7 semantic palette. Component styles consume these roles so light
         and dark modes share geometry, hierarchy, and interaction states. -->
    <SolidColorBrush x:Key="SurfaceBaseBrush" Color="#FFE0E6EA" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SurfaceInsetBrush" Color="#FFF1F4F6" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FFD8E3EA" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#FFC8D9E5" />
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#FF65727C" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF20272C" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF515E67" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#FF6F7B84" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF2E647F" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF25526B" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF1D4358" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="FocusBrush" Color="#FF245F8C" />
    <SolidColorBrush x:Key="StateNeutralBrush" Color="#FF515E67" />
    <SolidColorBrush x:Key="StateSuccessBrush" Color="#FF1F6B3A" />
    <SolidColorBrush x:Key="StateWarningBrush" Color="#FF7A5200" />
    <SolidColorBrush x:Key="StateErrorBrush" Color="#FFA42831" />
    <SolidColorBrush x:Key="StateRecoveryBrush" Color="#FF245F8C" />

    <!-- Opt-in classic-derived foundation. These semantic tokens intentionally do
         not replace legacy control colors until each surface is migrated. -->
    <SolidColorBrush x:Key="ClassicWorkspaceBrush" Color="#FFE0E6EA" />
    <SolidColorBrush x:Key="ClassicSurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ClassicSelectedSurfaceBrush" Color="#FFC8D9E5" />
    <SolidColorBrush x:Key="ClassicDividerBrush" Color="#FF65727C" />
    <SolidColorBrush x:Key="ClassicPrimaryTextBrush" Color="#FF20272C" />
    <SolidColorBrush x:Key="ClassicSecondaryTextBrush" Color="#FF515E67" />
    <SolidColorBrush x:Key="ClassicDisabledTextBrush" Color="#FF6F7B84" />
    <SolidColorBrush x:Key="ClassicAccentBrush" Color="#FF2E647F" />
    <SolidColorBrush x:Key="ClassicFocusBrush" Color="#FF245F8C" />
    <SolidColorBrush x:Key="ClassicReadyBrush" Color="#FF1F6B3A" />
    <SolidColorBrush x:Key="ClassicWarningBrush" Color="#FF7A5200" />
    <SolidColorBrush x:Key="ClassicErrorBrush" Color="#FFA42831" />

    <system:String x:Key="KeyImageImg">key-solid.png</system:String>
    <system:String x:Key="CancelImg">cancel.png</system:String>
    <system:String x:Key="CheckedImg">checked.png</system:String>
    <system:String x:Key="BtImg">BT.png</system:String>
    <system:String x:Key="UsbImg">USB.png</system:String>
    <system:String x:Key="KeyUpImg">keyup.png</system:String>
    <system:String x:Key="KeyDownImg">keydown.png</system:String>
    <system:String x:Key="ClockImg">clock.png</system:String>
    <system:String x:Key="DS4ConfigImg">DS4 Config.png</system:String>

    <system:String x:Key="CopyImg">copy.png</system:String>
    <system:String x:Key="DeleteImg">delete.png</system:String>
    <system:String x:Key="EditImg">edit.png</system:String>
    <system:String x:Key="ExportImg">export.png</system:String>
    <system:String x:Key="ImportImg">import.png</system:String>
    <system:String x:Key="NewProfileImg">newprofile.png</system:String>

    <system:String x:Key="GitHubImg">GitHub-Mark-64px.png</system:String>

    <Style TargetType="FlowDocument" x:Key="DocumentStyleGithubLike">
        <Setter Property="FontFamily"    Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="PagePadding"   Value="0"/>
        <Setter Property="FontSize"      Value="14"/>

        <Style.Resources>
            <Style TargetType="Section">
                <Style.Triggers>
                    <Trigger Property="Tag" Value="Blockquote">
                        <Setter Property="Padding"         Value="10, 5"/>
                        <Setter Property="BorderBrush"     Value="#DEDEDE"/>
                        <Setter Property="BorderThickness" Value="5,0,0,0"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="avalonEdit:TextEditor" xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit">
                <Setter Property="Background"                    Value="#EEEEEE"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
                <Setter Property="Margin"                        Value="2,0,2,0"/>
                <Setter Property="Padding"                       Value="3"/>
            </Style>

            <Style TargetType="Paragraph">
                <Setter Property="Margin" Value="0, 7, 0, 0"/>

                <Style.Triggers>
                    <Trigger Property="Tag" Value="Heading1">
                        <Setter Property="Margin" Value="0, 0, 15, 0"/>

                        <Setter Property="Foreground"  Value="#ff000000" />
                        <Setter Property="FontSize"    Value="28"/>
                        <Setter Property="FontWeight"  Value="UltraBold" />
                    </Trigger>

                    <Trigger Property="Tag" Value="Heading2">
                        <Setter Property="Margin" Value="0, 0, 15, 0"/>

                        <Setter Property="Foreground"  Value="#ff000000" />
                        <Setter Property="FontSize"    Value="21"/>
                        <Setter Property="FontWeight"  Value="Bold" />
                    </Trigger>

                    <Trigger Property="Tag" Value="Heading3">
                        <Setter Property="Margin" Value="0, 0, 10, 0"/>

                        <Setter Property="Foreground"  Value="#ff000000" />
                        <Setter Property="FontSize"    Value="17.5" />
                        <Setter Property="FontWeight"  Value="Bold" />
                    </Trigger>

                    <Trigger Property="Tag" Value="Heading4">
                        <Setter Property="Margin" Value="0, 0, 5, 0"/>

                        <Setter Property="Foreground"  Value="#ff000000" />
                        <Setter Property="FontSize"    Value="14"/>
                        <Setter Property="FontWeight"  Value="Bold" />
                    </Trigger>

                    <Trigger Property="Tag" Value="CodeBlock">
                        <Setter Property="FontFamily" Value="Courier New"/>
                        <Setter Property="FontSize"   Value="11.9"/>
                        <Setter Property="Background" Value="#12181F25"/>
                        <Setter Property="Padding"     Value="20, 10"/>
                    </Trigger>

                    <Trigger Property="Tag" Value="Note">
                        <Setter Property="Margin"      Value="5,0,5,0"/>
                        <Setter Property="Padding"     Value="10, 5"/>
                        <Setter Property="BorderBrush" Value="#DEDEDE"/>
                        <Setter Property="BorderThickness" Value="3,3,3,3"/>
                        <Setter Property="Background"  Value="#FAFAFA"/>
                    </Trigger>

                </Style.Triggers>
            </Style>

            <Style TargetType="Run">
                <Style.Triggers>
                    <Trigger Property="Tag" Value="CodeSpan">
                        <Setter Property="FontFamily" Value="Courier New"/>
                        <Setter Property="FontSize"   Value="11.9"/>
                        <Setter Property="Background" Value="#12181F25"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="Span">
                <Style.Triggers>
                    <Trigger Property="Tag" Value="CodeSpan">
                        <Setter Property="FontFamily" Value="Courier New"/>
                        <Setter Property="FontSize"   Value="11.9"/>
                        <Setter Property="Background" Value="#12181F25"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="Hyperlink">
                <Setter Property="TextDecorations"    Value="None" />
            </Style>

            <Style TargetType="Image">
                <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor" />
                <Style.Triggers>
                    <Trigger Property="Tag" Value="imageright">
                        <Setter Property="Margin"  Value="20,0,0,0" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
		    The Table's style don't seem to support border-collapse.
		    By making the ruled line width 0.5 and applying it to cell and table,
		    it looks like the ruled lines are not doubled.
		    -->
            <Style TargetType="Table">
                <Setter Property="CellSpacing" Value="0"/>
                <Setter Property="BorderThickness" Value="0.5"/>
                <Setter Property="BorderBrush" Value="#DFE2E5"/>
                <Style.Resources>
                    <Style TargetType="TableCell">
                        <Setter Property="BorderThickness" Value="0.5"/>
                        <Setter Property="BorderBrush" Value="#DFE2E5"/>
                        <Setter Property="Padding" Value="13, 6"/>
                    </Style>
                </Style.Resources>
            </Style>

            <Style TargetType="TableRowGroup">
                <Style.Triggers>
                    <Trigger Property="Tag" Value="TableHeader">
                        <Setter Property="FontWeight" Value="DemiBold"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Background" Value="#FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="TableRow">
                <Style.Triggers>
                    <Trigger Property="Tag" Value="EvenTableRow">
                        <Setter Property="Background" Value="#F6F8FA"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="BlockUIContainer">
                <Style.Triggers>
                    <Trigger Property="Tag"  Value="RuleSingle">
                        <Setter Property="Margin" Value="0,3"/>
                    </Trigger>

                    <Trigger Property="Tag"  Value="RuleDouble">
                        <Setter Property="Margin" Value="0,3"/>
                    </Trigger>

                    <Trigger Property="Tag"  Value="RuleBold">
                        <Setter Property="Margin" Value="0,3"/>
                    </Trigger>

                    <Trigger Property="Tag"  Value="RuleBoldWithSingle">
                        <Setter Property="Margin" Value="0,3"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Style.Resources>
    </Style>


    <!-- based on https://github.com/whistyun/MdXaml/blob/787605545ace5b7cd7d02ff19e80b1c7a019b0d3/MdXaml/Markdown.Style.xaml#L338
    need to use it here because I had to modify it to accomodate for dark theme too -->
    <!--
        BridgeShellStyles is loaded after either application theme and builds
        its component styles on these stable keys. DarkTheme supplies fully
        templated versions; the light/default theme intentionally inherits the
        native Windows control chrome through empty keyed base styles.
    -->
    <Style x:Key="ButtonStyle" TargetType="{x:Type Button}" />
    <Style x:Key="CheckBoxStyle" TargetType="{x:Type CheckBox}" />
    <Style x:Key="ComboBoxStyle" TargetType="{x:Type ComboBox}" />
    <Style x:Key="ComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}" />
    <Style x:Key="WindowStyle" TargetType="{x:Type Window}" />
</ResourceDictionary>
