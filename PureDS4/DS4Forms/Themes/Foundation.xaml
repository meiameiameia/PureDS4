<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:DS4WinWPF.DS4Forms.Converters">
    <!-- The installer links the presentation-only dictionary, not the app or
         any controller/backend types. App-specific converters stay here. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PresentationControls.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <converters:ControllerStartupStageVisualStateConverter x:Key="ControllerStartupStageVisualState" />
    <converters:BatteryTextVisualStateConverter x:Key="BatteryTextVisualState" />
    <converters:CountLabelConverter x:Key="CountLabel" />
    <!-- Opt-in for read-only document dialogs. Keep Markdown's formatting and
         commands, but give otherwise unstyled text the application palette. -->
    <Style x:Key="FoundationDocumentStyle" TargetType="FlowDocument"
           BasedOn="{StaticResource DocumentStyleGithubLike}">
        <Setter Property="FontFamily" Value="{StaticResource TypeUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="PagePadding" Value="0" />
        <Style.Resources>
            <Style TargetType="Hyperlink">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </Style>
        </Style.Resources>
    </Style>
</ResourceDictionary>
