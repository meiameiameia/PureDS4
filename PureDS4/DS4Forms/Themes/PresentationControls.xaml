<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:DS4WinWPF.DS4Forms">

    <!-- Shared metrics. Theme dictionaries own color only; component geometry
         and interaction stay identical in light and dark modes. -->
    <system:Double x:Key="Space1">4</system:Double>
    <system:Double x:Key="Space2">8</system:Double>
    <system:Double x:Key="Space3">12</system:Double>
    <system:Double x:Key="Space4">16</system:Double>
    <system:Double x:Key="Space5">24</system:Double>
    <system:Double x:Key="Space6">32</system:Double>

    <Thickness x:Key="Space1Thickness">4</Thickness>
    <Thickness x:Key="Space2Thickness">8</Thickness>
    <Thickness x:Key="Space3Thickness">12</Thickness>
    <Thickness x:Key="Space4Thickness">16</Thickness>
    <Thickness x:Key="ControlPaddingDense">8,2</Thickness>
    <Thickness x:Key="ControlPaddingDefault">10,4</Thickness>
    <Thickness x:Key="ControlPaddingProminent">14,6</Thickness>
    <Thickness x:Key="PropertyGroupPadding">12,8</Thickness>

    <system:Double x:Key="ControlHeightDense">24</system:Double>
    <system:Double x:Key="ControlHeightDefault">28</system:Double>
    <system:Double x:Key="ControlHeightProminent">32</system:Double>
    <system:Double x:Key="TypePageTitleSize">20</system:Double>
    <system:Double x:Key="TypeGroupTitleSize">13</system:Double>
    <system:Double x:Key="TypeBodySize">12</system:Double>
    <system:Double x:Key="TypeSecondarySize">12</system:Double>
    <system:Double x:Key="TypeColumnHeaderSize">11</system:Double>

    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusSurface">8</CornerRadius>
    <FontFamily x:Key="TypeUiFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="TypeIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="TypeMonoFontFamily">Cascadia Mono, Consolas</FontFamily>

    <!-- Shared by the main window and dialogs. The frame remains OS-owned. -->
    <Style x:Key="WindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TypeUiFontFamily}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="local:NativeWindowFrame.CaptionBackground" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="local:NativeWindowFrame.CaptionForeground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="local:NativeWindowFrame.IsEnabled" Value="True" />
    </Style>

    <!-- Home columns are shared by header and rows, never inferred from content. -->
    <GridLength x:Key="HomeIdentityColumn">1.3*</GridLength>
    <GridLength x:Key="HomeProtectionColumn">84</GridLength>
    <GridLength x:Key="HomeProfileColumn">*</GridLength>
    <system:Double x:Key="HomeProfileColumnMaxWidth">220</system:Double>
    <GridLength x:Key="HomeBatteryColumn">82</GridLength>
    <GridLength x:Key="HomeLightbarColumn">116</GridLength>

    <!-- Original monochrome DS4 silhouette. Even-odd cutouts identify the
         touchpad, symmetric sticks, d-pad and face buttons at small sizes. -->
    <Geometry x:Key="DualShock4SilhouetteGeometry">F0
        M 13,4 C 8.5,3.3 6,6 5,11 L 1.5,25 C 0.7,29 1.8,31 4.5,31
        C 7,31 9,28 12,23 L 16.5,19.5 C 19,22 29,22 31.5,19.5 L 36,23
        C 39,28 41,31 43.5,31 C 46.2,31 47.3,29 46.5,25 L 43,11
        C 42,6 39.5,3.3 35,4 C 32,5 16,5 13,4 Z
        M 18,6.5 H 30 Q 31,6.5 31,7.5 V 12 Q 31,13 30,13
        H 18 Q 17,13 17,12 V 7.5 Q 17,6.5 18,6.5 Z
        M 10,8 H 12 V 10 H 14 V 12 H 12 V 14 H 10 V 12 H 8 V 10 H 10 Z
        M 14.2,16 A 2.8,2.8 0 1 0 19.8,16 A 2.8,2.8 0 1 0 14.2,16 Z
        M 28.2,16 A 2.8,2.8 0 1 0 33.8,16 A 2.8,2.8 0 1 0 28.2,16 Z
        M 35.8,9 A 1.2,1.2 0 1 0 38.2,9 A 1.2,1.2 0 1 0 35.8,9 Z
        M 38.3,11.5 A 1.2,1.2 0 1 0 40.7,11.5 A 1.2,1.2 0 1 0 38.3,11.5 Z
        M 35.8,14 A 1.2,1.2 0 1 0 38.2,14 A 1.2,1.2 0 1 0 35.8,14 Z
        M 33.3,11.5 A 1.2,1.2 0 1 0 35.7,11.5 A 1.2,1.2 0 1 0 33.3,11.5 Z
    </Geometry>

    <!-- Center the caption line box and compensate the UI font's optical
         baseline by one DIP. Only control captions, not page/body text. -->
    <Style x:Key="FoundationControlCaptionStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
        <Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Control}}" />
        <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Control}}" />
        <Setter Property="FontWeight" Value="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Control}}" />
        <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="-1" /></Setter.Value></Setter>
    </Style>

    <Style x:Key="FoundationFocusVisualStyle" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="1"
                            BorderBrush="{DynamicResource FocusBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSmall}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FoundationButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightDefault}" />
        <Setter Property="Padding" Value="{StaticResource ControlPaddingDefault}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TypeUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FoundationFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusSmall}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FoundationControlCaptionStyle}" />
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <Border x:Name="KeyboardFocusRing"
                                Margin="1"
                                BorderBrush="{DynamicResource FocusBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsDefaulted" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="FoundationWrappedControlCaptionTemplate">
        <AccessText Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" />
    </DataTemplate>

    <Style x:Key="FoundationWrappedButtonStyle" TargetType="Button" BasedOn="{StaticResource FoundationButtonStyle}">
        <Setter Property="ContentTemplate" Value="{StaticResource FoundationWrappedControlCaptionTemplate}" />
    </Style>

    <Style x:Key="FoundationKeyButtonStyle" TargetType="Button" BasedOn="{StaticResource FoundationButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightDense}" />
        <Setter Property="Padding" Value="2,2" />
        <Setter Property="FontSize" Value="{StaticResource TypeColumnHeaderSize}" />
    </Style>

    <Style x:Key="FoundationPrimaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource FoundationButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusSmall}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True">
                                <ContentPresenter.Resources>
                                    <!-- The themes carry an implicit TextBlock style. An implicit style
                                         beats an inherited value, so without this the label ignores the
                                         button's own foreground and renders light text on the accent
                                         fill. Bind it back to the button. -->
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FoundationControlCaptionStyle}">
                                        <Setter Property="Foreground"
                                                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <Border x:Name="KeyboardFocusRing"
                                Margin="1"
                                BorderBrush="{DynamicResource AccentForegroundBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsDefaulted" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FoundationCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightDense}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TypeUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FoundationFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box"
                                Width="16" Height="16"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SurfaceInsetBrush}"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}">
                            <Path x:Name="CheckMark"
                                  Width="9" Height="7"
                                  Data="M 0 3 L 3 6 L 9 0"
                                  Stretch="Fill"
                                  Stroke="{DynamicResource TextPrimaryBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Square"
                                  StrokeEndLineCap="Square"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                        <Border x:Name="KeyboardFocusRing"
                                Grid.ColumnSpan="2"
                                Margin="1"
                                BorderBrush="{DynamicResource FocusBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                            <Setter TargetName="CheckMark" Property="Data" Value="M 0 3 L 9 3" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                            <Setter TargetName="CheckMark" Property="Stroke" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FoundationComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightDefault}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FoundationFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemChrome"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource RadiusSmall}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsHighlighted" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource SurfaceSelectedHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FoundationComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightDefault}" />
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TypeUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource FoundationComboBoxItemStyle}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FoundationFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusSmall}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="26" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Margin="8,0,6,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  IsHitTestVisible="False">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FoundationControlCaptionStyle}" />
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <Border Grid.Column="1"
                                        BorderThickness="0">
                                    <Path x:Name="Arrow"
                                          Width="8" Height="5"
                                          Data="M 0 0 L 4 4 L 8 0"
                                          Stretch="Fill"
                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                          StrokeThickness="1.5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <ToggleButton Background="Transparent"
                                      BorderThickness="0"
                                      ClickMode="Press"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border x:Name="KeyboardFocusRing"
                                Margin="1"
                                BorderBrush="{DynamicResource FocusBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="Fade">
                            <Border Margin="0,2,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusSmall}"
                                    Padding="2">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              CanContentScroll="True">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                            <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource FocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                            <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FoundationTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightDefault}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TypeUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FoundationFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusSmall}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <Border x:Name="KeyboardFocusRing"
                                Margin="1"
                                BorderBrush="{DynamicResource FocusBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                        <!-- A box embedded in a larger field (a search bar with its
                             own icon and clear button) must not draw a second focus
                             ring inside that field's border. The host draws it. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="Tag" Value="Embedded" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FoundationSearchFieldStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FoundationPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TypeUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypePageTitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="FoundationGroupTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TypeUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeGroupTitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="FoundationBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TypeUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="FoundationSecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TypeUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeSecondarySize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FoundationColumnHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TypeUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeColumnHeaderSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>


    <Style x:Key="FoundationPropertyGroupStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="{StaticResource PropertyGroupPadding}" />
    </Style>

    <Style x:Key="FoundationGroupBoxStyle" TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TypeUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource SurfaceDividerBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,7">
                            <ContentPresenter ContentSource="Header"
                                              TextElement.FontSize="{StaticResource TypeGroupTitleSize}"
                                              TextElement.FontWeight="SemiBold" />
                        </Border>
                        <Border Grid.Row="1"
                                Background="{DynamicResource SurfaceBaseBrush}"
                                Padding="12,10">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FoundationToolbarBarStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightDefault}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <!-- A destination rather than a command: repository links, lineage, anything
         that opens something outside PureDS4. Reads as text, not as a field. -->
    <Style x:Key="FoundationLinkButtonStyle" TargetType="Button"
           BasedOn="{StaticResource FoundationButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Padding" Value="0,2" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightDense}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FoundationToolbarButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource FoundationButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightDense}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="{StaticResource ControlPaddingDense}" />
    </Style>

    <Style x:Key="FoundationNavigationListItemStyle" TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightDefault}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FoundationFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="2,0,0,0"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="SelectionIndicator" Width="4" Margin="0,4" CornerRadius="2"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                Background="{DynamicResource AccentBrush}"
                                IsHitTestVisible="False" Visibility="Collapsed" />
                        <Border x:Name="KeyboardFocusRing"
                                Margin="1"
                                BorderBrush="{DynamicResource FocusBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceBaseHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceSelectedHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FoundationTextNavigationListItemStyle" TargetType="ListBoxItem"
           BasedOn="{StaticResource FoundationNavigationListItemStyle}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource FoundationControlCaptionStyle}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Textual section tabs share the navigation list's selection/focus cues.
         Keep the native header/content relationship and automation peer. -->
    <Style x:Key="FoundationSectionTabItemStyle" TargetType="TabItem">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightProminent}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TypeUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Margin="0,1">
                        <Border x:Name="CategoryChrome" Background="Transparent"
                                BorderThickness="3,0,0,0" BorderBrush="Transparent"
                                CornerRadius="{StaticResource RadiusSmall}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FoundationControlCaptionStyle}">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <Border x:Name="SelectionIndicator" Width="4" Margin="0,4" CornerRadius="2"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                Background="{DynamicResource AccentBrush}" IsHitTestVisible="False" Visibility="Collapsed" />
                        <Border x:Name="KeyboardFocusRing" Margin="1"
                                BorderBrush="{DynamicResource FocusBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}" IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="CategoryChrome" Property="IsMouseOver" Value="True">
                            <Setter TargetName="CategoryChrome" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="CategoryChrome" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition SourceName="CategoryChrome" Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CategoryChrome" Property="Background" Value="{DynamicResource SurfaceSelectedHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain choice lists share table interaction colors without adding a
         navigation stripe. Keep ListBox's native selection and virtualization. -->
    <Style x:Key="FoundationListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightDefault}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}"
                                CornerRadius="{StaticResource RadiusSmall}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="KeyboardFocusRing" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}" Margin="1" IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceSelectedHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FoundationListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource FoundationListBoxItemStyle}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One native Track/Thumb contract in both themes. Page commands and drag
         behavior remain WPF-owned; only chrome and the cross-axis size change. -->
    <Style x:Key="FoundationScrollPageStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FoundationScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Grip" Background="{TemplateBinding Background}" CornerRadius="3" Margin="3,1" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Static Orientation.Horizontal}"><Setter TargetName="Grip" Property="Margin" Value="1,3" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource TextPrimaryBrush}" /></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource AccentBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="FoundationScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="DecreasePage" Command="{x:Static ScrollBar.PageUpCommand}"
                                              Style="{StaticResource FoundationScrollPageStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource FoundationScrollThumbStyle}" Tag="{TemplateBinding Orientation}" /></Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="IncreasePage" Command="{x:Static ScrollBar.PageDownCommand}"
                                              Style="{StaticResource FoundationScrollPageStyle}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            <Setter TargetName="DecreasePage" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                            <Setter TargetName="IncreasePage" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Track" Property="Visibility" Value="Hidden" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
            </Trigger>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Tables that draw their own header row must not use the GridView scroll
         viewer: it reserves a band at the top for GridView column headers, which
         renders as an empty strip under the real header. -->
    <Style x:Key="FoundationTableListViewStyle" TargetType="ListView">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListView">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                            <ItemsPresenter SnapsToDevicePixels="True" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Visibility x:Key="TableRowSelectionIndicatorVisibility">Visible</Visibility>
    <Style x:Key="FoundationTableListItemStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightDefault}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FoundationFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid>
                        <Border x:Name="Chrome" Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource SurfaceDividerBrush}"
                                BorderThickness="2,0,0,1" Padding="{TemplateBinding Padding}"
                                CornerRadius="{StaticResource RadiusSmall}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="SelectionIndicator" Width="4" Margin="0,6" CornerRadius="2"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                Background="{DynamicResource AccentBrush}"
                                IsHitTestVisible="False" Visibility="Collapsed" />
                        <Border x:Name="KeyboardFocusRing" Margin="1"
                                BorderBrush="{DynamicResource FocusBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}"
                                IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="{DynamicResource TableRowSelectionIndicatorVisibility}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceSelectedHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Controls without a local style receive the same geometry, focus,
         and interaction behavior in both themes. -->
    <Style x:Key="FoundationControllerRowStyle" TargetType="ListViewItem"
           BasedOn="{StaticResource FoundationTableListItemStyle}">
        <Style.Resources>
            <!-- The selected background is sufficient in the controller list.
                 Other tables retain their cue; keyboard focus stays independent. -->
            <Visibility x:Key="TableRowSelectionIndicatorVisibility">Collapsed</Visibility>
        </Style.Resources>
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontFamily" Value="{StaticResource TypeUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
    </Style>

    <!-- Opt-in for flat, checked choice menus; not a replacement for submenu templates. -->
    <!-- Opt-in horizontal property slider. Native Track commands/keyboard and
         value semantics are retained; interaction states never change geometry. -->
    <Style x:Key="FoundationHorizontalSliderStyle" TargetType="Slider">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightDefault}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FoundationFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid MinHeight="{StaticResource ControlHeightDefault}">
                        <Track x:Name="PART_Track" VerticalAlignment="Center" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                        <Border Height="4" Background="{DynamicResource AccentBrush}" CornerRadius="{StaticResource RadiusSmall}" />
                                    </ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="18" Focusable="False">
                                    <Thumb.Template><ControlTemplate TargetType="Thumb">
                                        <Border x:Name="ThumbChrome" Background="{DynamicResource TextPrimaryBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource AccentHoverBrush}" /></Trigger>
                                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource AccentPressedBrush}" /></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource TextDisabledBrush}" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate></Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                        <Border Height="4" Background="{DynamicResource BorderDefaultBrush}" CornerRadius="{StaticResource RadiusSmall}" />
                                    </ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                        <TickBar x:Name="Ticks" Visibility="Collapsed" IsHitTestVisible="False"
                                 Margin="7,0,7,0" Height="4" VerticalAlignment="Bottom" Placement="Bottom"
                                 Fill="{DynamicResource TextSecondaryBrush}" Minimum="{TemplateBinding Minimum}"
                                 Maximum="{TemplateBinding Maximum}" TickFrequency="{TemplateBinding TickFrequency}" Ticks="{TemplateBinding Ticks}" />
                        <Border x:Name="FocusRing" Visibility="Collapsed" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource FocusBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TickPlacement" Value="BottomRight"><Setter TargetName="Ticks" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Native MenuItem owns pointer/keyboard routing and submenu lifetime.
         The same template is used for tray, application and editing menus. -->
    <Style x:Key="FoundationMenuItemStyle" TargetType="MenuItem">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightDefault}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontFamily" Value="{StaticResource TypeUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FoundationFocusVisualStyle}" />
        <Setter Property="HeaderTemplate">
            <Setter.Value><DataTemplate>
                <AccessText Text="{Binding}" TextWrapping="Wrap" MaxWidth="360"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
            </DataTemplate></Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="MenuItemChrome" Padding="{TemplateBinding Padding}"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                                CornerRadius="{StaticResource RadiusSmall}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="MenuIcon" ContentSource="Icon"
                                                  VerticalAlignment="Center" />
                                <TextBlock x:Name="CheckGlyph" Text="✓" Visibility="Hidden"
                                           Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  RecognizesAccessKey="True" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0,4,0"
                                           VerticalAlignment="Center" />
                                <Path x:Name="SubmenuArrow" Grid.Column="3" Visibility="Hidden"
                                      Data="M 0,0 L 4,4 L 0,8" Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Right" PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}">
                            <Border x:Name="SubmenuChrome" Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusSmall}" Padding="4" MinWidth="180">
                                <ScrollViewer CanContentScroll="False" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              MaxHeight="{Binding Height, Source={x:Static SystemParameters.WorkArea}}">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                                    KeyboardNavigation.TabNavigation="Cycle" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                            <Setter TargetName="MenuIcon" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="MenuItemChrome" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="MenuItemChrome" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="MenuItemChrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                            <Setter TargetName="MenuItemChrome" Property="Background" Value="Transparent" />
                        </Trigger>
                        <Trigger Property="IsSuspendingPopupAnimation" Value="True">
                            <Setter TargetName="PART_Popup" Property="PopupAnimation" Value="None" />
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FoundationMenuSeparatorStyle" TargetType="Separator">
        <Setter Property="Margin" Value="28,4,8,4" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Separator">
                <Border Height="1" Background="{DynamicResource SurfaceDividerBrush}" SnapsToDevicePixels="True" />
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="FoundationContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="FontFamily" Value="{StaticResource TypeUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="MaxHeight" Value="{Binding Height, Source={x:Static SystemParameters.WorkArea}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border x:Name="MenuChrome" Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSmall}" Padding="4" SnapsToDevicePixels="True">
                        <ScrollViewer CanContentScroll="False" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                            KeyboardNavigation.TabNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Compatibility names for the existing lightbar and profile choice menus. -->
    <Style x:Key="FoundationChoiceMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource FoundationMenuItemStyle}" />
    <Style x:Key="FoundationChoiceMenuStyle" TargetType="ContextMenu"
           BasedOn="{StaticResource FoundationContextMenuStyle}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource FoundationChoiceMenuItemStyle}" />
    </Style>
    <Style x:Key="FoundationToolTipStyle" TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource TypeUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ToolTip">
                <Border x:Name="ToolTipChrome" Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSmall}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter>
                        <ContentPresenter.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Style>
                        </ContentPresenter.Resources>
                    </ContentPresenter>
                </Border>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <!-- Retain the system ProgressBar's determinate/indeterminate animation,
         value/automation semantics; supply the shared surface and accent. -->
    <Style x:Key="FoundationProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceDividerBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Opt-in property editors retain native numeric parsing/spin/validation.
         No replacement template or value-update policy belongs in this style. -->
    <Style x:Key="FoundationNumericInputStyle" TargetType="Control">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightDefault}" />
        <Setter Property="MinWidth" Value="72" />
        <!-- A numeric field is as wide as its number. Left-aligning keeps the
             value beside its label instead of stretching to the far side of a
             star-sized property column. -->
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="FontFamily" Value="{StaticResource TypeUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FoundationFocusVisualStyle}" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FoundationPropertyLabelStyle" TargetType="Label">
        <Setter Property="Padding" Value="0,4,8,4" />
        <Setter Property="FontFamily" Value="{StaticResource TypeUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Keep native Label targets/content while allowing long property names
         and assigned actions to fit the available column instead of clipping. -->
    <Style x:Key="FoundationWrappedPropertyLabelStyle" TargetType="Label"
           BasedOn="{StaticResource FoundationPropertyLabelStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <AccessText Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One label column for every property row in the profile editor, so the
         value column starts at the same place whether the row is a Grid, a
         WrapPanel, or led by a check box instead of a label. Rows used to size
         to their own label, which left the fields scattered across a 90px
         spread within a single section. -->
    <system:Double x:Key="FormLabelColumnWidth">160</system:Double>

    <Style x:Key="FoundationFormLabelStyle" TargetType="Label"
           BasedOn="{StaticResource FoundationPropertyLabelStyle}">
        <Setter Property="MinWidth" Value="{StaticResource FormLabelColumnWidth}" />
    </Style>

    <Style x:Key="FoundationFormCheckBoxStyle" TargetType="CheckBox"
           BasedOn="{StaticResource FoundationCheckBoxStyle}">
        <Setter Property="MinWidth" Value="{StaticResource FormLabelColumnWidth}" />
    </Style>

    <!-- Setting rows share Tools' row geometry: a raised surface with a bottom
         divider, the title and a one-line description on the left, and the
         control on the right. Settings, Tools and Auto Profiles use one pattern. -->
    <Style x:Key="FoundationSettingRowStyle" TargetType="Border"
           BasedOn="{StaticResource FoundationPropertyGroupStyle}">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- Compact profile-property rows use the same surface and separator as
         Settings, with room for native numeric editors and wrapped labels. -->
    <Style x:Key="FoundationPropertyRowStyle" TargetType="Border"
           BasedOn="{StaticResource FoundationSettingRowStyle}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,0,1" />
    </Style>

    <Style x:Key="FoundationDialogActionsStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,12,0,0" />
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="MinHeight" Value="40" />
    </Style>

    <!-- Opt-in, downward disclosure. The native Expander and ToggleButton
         retain expansion, access keys, keyboard and automation semantics. -->
    <Style x:Key="FoundationExpanderStyle" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderSite" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Left"
                                      MinHeight="{StaticResource ControlHeightDefault}" Background="Transparent"
                                      FocusVisualStyle="{StaticResource FoundationFocusVisualStyle}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="HeaderChrome" Background="{TemplateBinding Background}" Padding="4"
                                            CornerRadius="{StaticResource RadiusSmall}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Path x:Name="Chevron" Data="M 2,0 L 6,4 L 2,8" Width="8" Height="8"
                                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  RenderTransformOrigin="0.5,0.5" />
                                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" /></Trigger>
                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" /></Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- A row nested under the setting it depends on, such as a threshold that
         only applies while its switch is on. -->
    <Style x:Key="FoundationSettingSubRowStyle" TargetType="Border"
           BasedOn="{StaticResource FoundationSettingRowStyle}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="36,6,12,6" />
    </Style>

    <Style x:Key="FoundationSettingTitleStyle" TargetType="TextBlock"
           BasedOn="{StaticResource FoundationBodyTextStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FoundationSettingDescriptionStyle" TargetType="TextBlock"
           BasedOn="{StaticResource FoundationSecondaryTextStyle}">
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- Section label above a run of setting rows. -->
    <Style x:Key="FoundationSectionHeadingStyle" TargetType="TextBlock"
           BasedOn="{StaticResource FoundationColumnHeaderStyle}">
        <Setter Property="Margin" Value="0,16,0,6" />
    </Style>

    <!-- On/off switch for setting rows. It is still a CheckBox, so IsChecked
         bindings, Click handlers and automation keep their existing meaning.
         The pill shape conveys the control's function, so it stays rounded.
         Give every switch an AutomationProperties.Name: it has no text of its own. -->
    <Style x:Key="FoundationToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightDense}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Border x:Name="Track"
                                Width="40" Height="20"
                                CornerRadius="10"
                                Background="{DynamicResource SurfaceInsetBrush}"
                                BorderBrush="{DynamicResource TextSecondaryBrush}"
                                BorderThickness="1">
                            <Ellipse x:Name="Knob"
                                     Width="12" Height="12"
                                     Margin="4,0"
                                     HorizontalAlignment="Left"
                                     Fill="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <Border x:Name="KeyboardFocusRing"
                                Margin="-3"
                                CornerRadius="13"
                                BorderBrush="{DynamicResource FocusBrush}"
                                BorderThickness="2"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentForegroundBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact dialog pages retain native TabControl selection and automation. -->
    <Style x:Key="FoundationDialogTabItemStyle" TargetType="TabItem">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightProminent}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="HeaderChrome" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="SelectionIndicator" Height="3" Margin="12,0" CornerRadius="1.5" VerticalAlignment="Bottom"
                                Background="{DynamicResource AccentBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Border x:Name="KeyboardFocusRing" Margin="1" CornerRadius="{StaticResource RadiusSmall}" BorderThickness="1"
                                BorderBrush="{DynamicResource FocusBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="HeaderChrome" Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FoundationDialogTabsStyle" TargetType="TabControl">
        <Setter Property="ItemContainerStyle" Value="{StaticResource FoundationDialogTabItemStyle}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid Background="{DynamicResource SurfaceBaseBrush}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border BorderBrush="{DynamicResource SurfaceDividerBrush}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once" />
                        </Border>
                        <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0,12,0,0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Content-only tabs are driven by an existing section or mode selector.
         Keep the TabControl and its index/content association, not a second nav. -->
    <Style x:Key="FoundationContentTabsStyle" TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- The section list, not a tab strip, drives this control. The
                                     items host still has to exist: without it WPF generates no
                                     TabItem containers, and with no TabItem the selected content
                                     never reaches the automation tree at all. Zero height and
                                     clipping keep it invisible. -->
                                <RowDefinition Height="0" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TabPanel IsItemsHost="True" ClipToBounds="True" Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource FoundationButtonStyle}">
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource FoundationCheckBoxStyle}">
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource FoundationComboBoxStyle}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource FoundationTextBoxStyle}">
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style TargetType="GroupBox" BasedOn="{StaticResource FoundationGroupBoxStyle}" />
    <Style TargetType="ListBox" BasedOn="{StaticResource FoundationListBoxStyle}" />
    <Style TargetType="ScrollBar" BasedOn="{StaticResource FoundationScrollBarStyle}" />
    <!-- Do not let the legacy dark dictionary silently replace native geometry
         on otherwise migrated pages. Keep keyed legacy resources available for
         the remaining explicitly opted-in views. -->
    <Style TargetType="ScrollViewer" />
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TypeUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style TargetType="Label" BasedOn="{StaticResource FoundationPropertyLabelStyle}" />
    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource TypeUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource FoundationComboBoxItemStyle}" />
    <Style TargetType="ListView" BasedOn="{StaticResource FoundationTableListViewStyle}" />
    <Style TargetType="ListViewItem" BasedOn="{StaticResource FoundationTableListItemStyle}" />
    <Style TargetType="TabItem" BasedOn="{StaticResource FoundationSectionTabItemStyle}" />
    <Style TargetType="TabControl" BasedOn="{StaticResource FoundationDialogTabsStyle}" />
    <Style TargetType="ContextMenu" BasedOn="{StaticResource FoundationContextMenuStyle}" />
    <Style TargetType="MenuItem" BasedOn="{StaticResource FoundationMenuItemStyle}" />
    <Style TargetType="Separator" BasedOn="{StaticResource FoundationMenuSeparatorStyle}" />
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator"
           BasedOn="{StaticResource FoundationMenuSeparatorStyle}" />
    <Style TargetType="ToolTip" BasedOn="{StaticResource FoundationToolTipStyle}" />
    <Style TargetType="Expander" BasedOn="{StaticResource FoundationExpanderStyle}" />
    <Style TargetType="ProgressBar" BasedOn="{StaticResource FoundationProgressBarStyle}" />
</ResourceDictionary>
