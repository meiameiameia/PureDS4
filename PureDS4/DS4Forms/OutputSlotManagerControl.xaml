<UserControl x:Name="userControl" x:Class="DS4WinWPF.DS4Forms.OutputSlotManagerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:LocalizeDictionary.DesignCulture=""
             lex:ResxLocalizationProvider.DefaultAssembly="PureDS4"
             lex:ResxLocalizationProvider.DefaultDictionary="Strings"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Output slots" Style="{StaticResource FoundationPageTitleStyle}" />
            <TextBlock Text="Inspect and manage the virtual controller slots presented to games."
                       Margin="0,3,0,0" Style="{StaticResource FoundationSecondaryTextStyle}" />
        </StackPanel>

        <!-- Header and rows share one content-independent column set, so the
             headers always sit above their own cells. -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1,1,1,0" Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="200" />
                        <ColumnDefinition Width="1.4*" MinWidth="130" />
                        <ColumnDefinition Width="1.4*" MinWidth="130" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{lex:Loc OutputSlotMan.InputNum}" Style="{StaticResource FoundationColumnHeaderStyle}" />
                    <TextBlock Grid.Column="1" Text="{lex:Loc Current}" Style="{StaticResource FoundationColumnHeaderStyle}" />
                    <TextBlock Grid.Column="2" Text="{lex:Loc Requested}" Style="{StaticResource FoundationColumnHeaderStyle}" />
                    <TextBlock Grid.Column="3" Text="{lex:Loc OutputSlotMan.XInputNum}" Style="{StaticResource FoundationColumnHeaderStyle}" />
                    <TextBlock Grid.Column="4" Text="{lex:Loc Active}" Style="{StaticResource FoundationColumnHeaderStyle}" />
                </Grid>
            </Border>
            <ListView Grid.Row="1" x:Name="currentOutDevLV" ItemsSource="{Binding SlotDeviceEntries}"
                      SelectedIndex="{Binding SelectedIndex,Mode=OneWayToSource}"
                      Style="{StaticResource FoundationTableListViewStyle}"
                      ItemContainerStyle="{StaticResource FoundationTableListItemStyle}"
                      AutomationProperties.Name="Output slots">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="200" />
                        <ColumnDefinition Width="1.4*" MinWidth="130" />
                        <ColumnDefinition Width="1.4*" MinWidth="130" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding InputSlotDisplayString}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding InputSlotDisplayString}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding CurrentType}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding DesiredType}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding XInputSlotNum}" VerticalAlignment="Center"
                                       Visibility="{Binding DisplayXInputSlotNum, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center"
                                       AutomationProperties.Name="Slot active">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FoundationBodyTextStyle}">
                                        <Setter Property="Text" Value="&#x2014;" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BoundInput,Mode=OneWay}" Value="True">
                                                <Setter Property="Text" Value="Active" />
                                                <Setter Property="Foreground" Value="{DynamicResource StateSuccessBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Border Grid.Row="2" x:Name="actionToolbar" Margin="0,12,0,0" Style="{StaticResource FoundationToolbarBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="pluginBtn" MinWidth="70" Content="{lex:Loc Plug}"
                        IsEnabled="{Binding PluginEnabled}" Click="PluginBtn_Click"
                        Style="{StaticResource FoundationToolbarButtonStyle}" />
                <Button Grid.Column="1" x:Name="unplugBtn" MinWidth="70" Content="{lex:Loc Unplug}"
                        IsEnabled="{Binding UnpluginEnabled}" Click="UnplugBtn_Click"
                        Style="{StaticResource FoundationToolbarButtonStyle}" />
                <Grid Grid.Column="3" Grid.ColumnSpan="4" x:Name="reservationPanel"
                      Visibility="{Binding DataContext.SidePanelVisibility, ElementName=actionToolbar}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Reservation" VerticalAlignment="Center"
                               Style="{StaticResource FoundationColumnHeaderStyle}" />
                    <ComboBox Grid.Column="1" x:Name="reserveCombo" Margin="8,0,0,0" MinWidth="130"
                              SelectedIndex="{Binding ReserveChoice,FallbackValue=0}">
                        <ComboBoxItem Tag="0" Content="{lex:Loc Dynamic}" ToolTip="Release the slot when it is no longer used." />
                        <ComboBoxItem Tag="1" Content="{lex:Loc Permanent}" ToolTip="Keep the selected slot reserved between sessions." />
                    </ComboBox>
                    <TextBlock Grid.Column="2" Margin="10,0" VerticalAlignment="Center"
                               Text="Dynamic releases unused slots; Permanent keeps this slot reserved."
                               Style="{StaticResource FoundationSecondaryTextStyle}" />
                    <Button Grid.Column="3" x:Name="slotChangeAcceptBtn" Content="{lex:Loc Accept}"
                            IsEnabled="{Binding Dirty,FallbackValue=False}"
                            Click="SlotChangeAcceptBtn_Click"
                            Style="{StaticResource FoundationPrimaryButtonStyle}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
