<Window x:Class="DS4WinWPF.DS4Forms.ViiperSetupProgress"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game output setup" Width="560" MinWidth="440" MinHeight="260"
        SizeToContent="Height" MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        ResizeMode="NoResize" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" Style="{DynamicResource WindowStyle}">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Bottom" Style="{StaticResource FoundationDialogActionsStyle}">
            <TextBlock x:Name="detailText" Text="Keep this window open. Setup will finish automatically."
                       Style="{StaticResource FoundationSecondaryTextStyle}" TextWrapping="Wrap" />
        </Border>
        <ScrollViewer x:Name="progressScroll" MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Width="{Binding ViewportWidth, ElementName=progressScroll}">
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="statusGlyph" Text="&#x21BB;" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource StateRecoveryBrush}" AutomationProperties.Name="Setup status" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="headingText" Text="Setting up game output"
                                   Style="{StaticResource FoundationPageTitleStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="PureDS4 is verifying the components that present a controller to games."
                                   Margin="0,4,0,0" Style="{StaticResource FoundationSecondaryTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource FoundationPropertyGroupStyle}">
                    <StackPanel>
                        <TextBlock x:Name="phaseText" Text="Preparing verified package..."
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <ProgressBar x:Name="setupProgress" Height="4" Margin="0,12,0,16" IsIndeterminate="True"
                                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceInsetBrush}"
                                     AutomationProperties.Name="Game output setup progress" />
                        <TextBlock Text="• Verify packaged files" TextWrapping="Wrap" />
                        <TextBlock Text="• Install verified game-output service" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="• Verify required system driver" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="• Verify startup and API" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
