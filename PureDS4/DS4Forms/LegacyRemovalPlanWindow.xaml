<Window x:Class="DS4WinWPF.DS4Forms.LegacyRemovalPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
        mc:Ignorable="d"
        Title="DS4Windows removal plan"
        SizeToContent="Height" Width="600" MinWidth="560"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Style="{DynamicResource WindowStyle}">
    <StackPanel Margin="20">
        <TextBlock x:Name="headingText" Style="{StaticResource FoundationPageTitleStyle}"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="summaryText" Margin="0,6,0,0" TextWrapping="Wrap"
                   Style="{StaticResource FoundationSecondaryTextStyle}" />

        <Border Style="{StaticResource FoundationPropertyGroupStyle}"
                Margin="0,14,0,0" x:Name="itemListBorder">
            <StackPanel>
                <TextBlock Text="What removal would involve" Style="{StaticResource FoundationGroupTitleStyle}" />
                <ItemsControl x:Name="itemList" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="0,4,0,4"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource FoundationSecondaryTextStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock x:Name="preservationText" Margin="0,14,0,0" TextWrapping="Wrap"
                   Style="{StaticResource FoundationSecondaryTextStyle}"
                   Visibility="Collapsed" />

        <TextBlock x:Name="blockedText" Margin="0,14,0,0" TextWrapping="Wrap"
                   Style="{StaticResource FoundationSecondaryTextStyle}"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button x:Name="uninstallButton" Content="Uninstall DS4Windows..."
                    Click="UninstallBtn_Click" MinWidth="180" MinHeight="32"
                    Visibility="Collapsed"
                    Style="{StaticResource FoundationButtonStyle}"
                    AutomationProperties.HelpText="Starts Windows' own uninstaller for the detected installation. PureDS4 does not remove anything itself." />
            <Button x:Name="recheckButton" Content="Re-check"
                    Click="RecheckBtn_Click" MinWidth="100" MinHeight="32"
                    Margin="10,0,0,0" Visibility="Collapsed"
                    Style="{StaticResource FoundationButtonStyle}" />
            <Button x:Name="closeButton" Content="Close"
                    Click="CloseBtn_Click" MinWidth="100" MinHeight="32"
                    Margin="10,0,0,0"
                    Style="{StaticResource FoundationPrimaryButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
