<Window x:Class="DS4WinWPF.DS4Forms.LegacyRemovalPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DS4Windows removal plan"
        SizeToContent="Height" Width="600" MinWidth="560"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Style="{DynamicResource WindowStyle}">
    <DockPanel Margin="16">
        <Border x:Name="migrationActions" DockPanel.Dock="Bottom" Style="{StaticResource FoundationDialogActionsStyle}">
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="uninstallButton" Content="Uninstall DS4Windows..." Click="UninstallBtn_Click"
                        MinWidth="180" Margin="0,0,8,8" Visibility="Collapsed"
                        Style="{StaticResource FoundationWrappedButtonStyle}"
                        AutomationProperties.HelpText="Starts Windows' own uninstaller for the detected installation. PureDS4 does not remove anything itself." />
                <Button x:Name="recheckButton" Content="Re-check" Click="RecheckBtn_Click"
                        MinWidth="100" Margin="0,0,8,8" Visibility="Collapsed"
                        Style="{StaticResource FoundationButtonStyle}" />
                <Button x:Name="closeButton" Content="Close" Click="CloseBtn_Click"
                        MinWidth="100" Margin="0,0,0,8" Style="{StaticResource FoundationPrimaryButtonStyle}"
                        ContentTemplate="{StaticResource FoundationWrappedControlCaptionTemplate}" />
            </WrapPanel>
        </Border>
        <ScrollViewer x:Name="migrationScroll" MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Width="{Binding ViewportWidth, ElementName=migrationScroll}">
                <TextBlock x:Name="headingText" Style="{StaticResource FoundationPageTitleStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="summaryText" Margin="0,8,0,16" TextWrapping="Wrap"
                           Style="{StaticResource FoundationSecondaryTextStyle}" />
                <Border x:Name="itemListBorder" Style="{StaticResource FoundationPropertyGroupStyle}">
                    <StackPanel>
                        <TextBlock Text="What removal would involve" Style="{StaticResource FoundationGroupTitleStyle}" TextWrapping="Wrap" />
                        <ItemsControl x:Name="itemList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,4,0,4" TextWrapping="Wrap"
                                               Style="{StaticResource FoundationSecondaryTextStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="preservationText" Margin="0,12,0,0" TextWrapping="Wrap"
                           Style="{StaticResource FoundationSecondaryTextStyle}" Visibility="Collapsed" />
                <TextBlock x:Name="blockedText" Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource StateWarningBrush}" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
