<Window x:Class="DS4WinWPF.DS4Forms.ViiperSetupPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game output setup" Width="620" MinWidth="520" MinHeight="360"
        SizeToContent="Height" MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        ResizeMode="CanResize" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" Style="{DynamicResource WindowStyle}">
    <DockPanel Margin="16">
        <Border x:Name="promptActions" DockPanel.Dock="Bottom" Style="{StaticResource FoundationDialogActionsStyle}">
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="notNowButton" Content="Continue without game output"
                        Style="{StaticResource FoundationWrappedButtonStyle}" Margin="0,0,8,8"
                        IsCancel="True" Click="NotNowButton_Click" />
                <Button x:Name="installPortableButton" Content="Keep this folder portable"
                        Style="{StaticResource FoundationWrappedButtonStyle}" Margin="0,0,8,8"
                        Click="InstallPortableButton_Click" />
                <Button x:Name="installButton" Content="Set up game output" Margin="0,0,0,8"
                        Style="{StaticResource FoundationPrimaryButtonStyle}"
                        ContentTemplate="{StaticResource FoundationWrappedControlCaptionTemplate}"
                        Click="InstallButton_Click" />
            </WrapPanel>
        </Border>
        <ScrollViewer x:Name="promptScroll" MaxHeight="520" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Width="{Binding ViewportWidth, ElementName=promptScroll}">
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="i" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource StateRecoveryBrush}"
                               AutomationProperties.Name="Setup information" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="headingText" Text="Set up game output" TextWrapping="Wrap"
                                   Style="{StaticResource FoundationPageTitleStyle}" />
                        <TextBlock x:Name="summaryText" Margin="0,4,0,0" Style="{StaticResource FoundationSecondaryTextStyle}"
                                   Text="Set up the verified components PureDS4 uses to make your controller available to games." TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource FoundationPropertyGroupStyle}">
                    <StackPanel>
                        <TextBlock x:Name="requirementsHeadingText" Text="What setup will do"
                                   Style="{StaticResource FoundationGroupTitleStyle}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <TextBlock x:Name="requirementsText" Text="• Verify the components required for game output&#x0a;• Request Windows permission only when setup needs it"
                                   TextWrapping="Wrap" LineHeight="22" />
                        <Expander x:Name="technicalDetailsExpander" Header="Technical details" Margin="0,8,0,0"
                                  Style="{StaticResource FoundationExpanderStyle}">
                            <TextBlock x:Name="statusText" TextWrapping="Wrap" Margin="0,8,0,0"
                                       FontFamily="{StaticResource TypeMonoFontFamily}" />
                        </Expander>
                    </StackPanel>
                </Border>
                <Border x:Name="existingViiperPanel" Style="{StaticResource FoundationPropertyGroupStyle}"
                        BorderBrush="{DynamicResource StateWarningBrush}" BorderThickness="3,1,1,1" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="existingViiperHeadingText" Text="Another game-output service was detected"
                                   Style="{StaticResource FoundationGroupTitleStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="existingViiperDescriptionText" Margin="0,4,0,8"
                                   Text="This executable will not be elevated or selected. Setup uses the verified service and only removes recognized legacy files:"
                                   Style="{StaticResource FoundationSecondaryTextStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="existingViiperPathText" FontFamily="{StaticResource TypeMonoFontFamily}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FoundationSettingRowStyle}" Visibility="{Binding Visibility, ElementName=suppressPromptCheck}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Label Content="Don't show this setup prompt again" Target="{Binding ElementName=suppressPromptCheck}"
                               Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Margin="0,0,12,0" />
                        <CheckBox x:Name="suppressPromptCheck" Grid.Column="1" Content="Don't show this setup prompt again"
                                  Style="{StaticResource FoundationToggleSwitchStyle}" AutomationProperties.Name="Don't show this setup prompt again"
                                  ToolTip="You can turn setup prompts back on from Settings → Game output." />
                    </Grid>
                </Border>
                <Border x:Name="portableWarningPanel" Style="{StaticResource FoundationPropertyGroupStyle}">
                    <TextBlock Text="Keeping PureDS4 portable leaves this app exactly where it is. Game-output setup is still installed in protected Program Files. Standard setup moves only package-owned PureDS4 files. Profiles, settings, and unrecognized files are preserved."
                               Style="{StaticResource FoundationSecondaryTextStyle}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
