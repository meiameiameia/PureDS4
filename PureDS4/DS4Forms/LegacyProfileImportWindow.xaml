<Window x:Class="DS4WinWPF.DS4Forms.LegacyProfileImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
        mc:Ignorable="d"
        Title="Import profiles from DS4Windows"
        SizeToContent="Height" Width="560" MinWidth="520"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Style="{DynamicResource WindowStyle}">
    <StackPanel Margin="20">
        <TextBlock x:Name="headingText" Style="{StaticResource FoundationPageTitleStyle}"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="summaryText" Margin="0,6,0,0" TextWrapping="Wrap"
                   Style="{StaticResource FoundationSecondaryTextStyle}" />

        <Border Style="{StaticResource FoundationPropertyGroupStyle}"
                Margin="0,14,0,0" x:Name="candidateListBorder">
            <StackPanel>
                <TextBlock Text="Profiles found" Style="{StaticResource FoundationGroupTitleStyle}" />
                <ListBox x:Name="candidateList" Margin="0,6,0,0" MaxHeight="180"
                         BorderThickness="0" Background="Transparent" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="resultText" Margin="0,14,0,0" TextWrapping="Wrap"
                   Style="{StaticResource FoundationSecondaryTextStyle}"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button x:Name="closeButton" Content="Close"
                    Click="CloseBtn_Click" MinWidth="100" MinHeight="32"
                    Style="{StaticResource FoundationButtonStyle}" />
            <Button x:Name="importButton" Content="Import"
                    Click="ImportBtn_Click" MinWidth="100" MinHeight="32"
                    Margin="10,0,0,0"
                    Style="{StaticResource FoundationPrimaryButtonStyle}"
                    AutomationProperties.HelpText="Copy these profiles into PureDS4. DS4Windows' own files are never changed or removed." />
        </StackPanel>
    </StackPanel>
</Window>
