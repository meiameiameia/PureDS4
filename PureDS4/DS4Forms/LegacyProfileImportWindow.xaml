<Window x:Class="DS4WinWPF.DS4Forms.LegacyProfileImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import profiles from DS4Windows"
        SizeToContent="Height" Width="560" MinWidth="520"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Style="{DynamicResource WindowStyle}">
    <DockPanel Margin="16">
        <Border x:Name="migrationActions" DockPanel.Dock="Bottom" Style="{StaticResource FoundationDialogActionsStyle}">
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="closeButton" Content="Close" Click="CloseBtn_Click" MinWidth="100"
                        Style="{StaticResource FoundationButtonStyle}" Margin="0,0,8,0" />
                <Button x:Name="importButton" Content="Import" Click="ImportBtn_Click" MinWidth="100"
                        Style="{StaticResource FoundationPrimaryButtonStyle}"
                        AutomationProperties.HelpText="Copy these profiles into PureDS4. DS4Windows' own files are never changed or removed." />
            </WrapPanel>
        </Border>
        <ScrollViewer x:Name="migrationScroll" MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Width="{Binding ViewportWidth, ElementName=migrationScroll}">
                <TextBlock x:Name="headingText" Style="{StaticResource FoundationPageTitleStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="summaryText" Margin="0,8,0,16" TextWrapping="Wrap"
                           Style="{StaticResource FoundationSecondaryTextStyle}" />
                <Border x:Name="candidateListBorder" Style="{StaticResource FoundationPropertyGroupStyle}">
                    <StackPanel>
                        <TextBlock Text="Profiles found" Style="{StaticResource FoundationGroupTitleStyle}" />
                        <ListBox x:Name="candidateList" Margin="0,8,0,0" MaxHeight="180"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 AutomationProperties.Name="Profiles found and import results">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Width" Value="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                                    <Setter Property="Padding" Value="4" />
                                    <Setter Property="MinHeight" Value="{StaticResource ControlHeightDefault}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource FoundationFocusVisualStyle}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="resultText" Margin="0,12,0,0" TextWrapping="Wrap"
                           Style="{StaticResource FoundationSecondaryTextStyle}" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
