<Window x:Class="DS4WinWPF.DS4Forms.SaveWhere"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose where PureDS4 stores its data"
        SizeToContent="Height" Width="560" MinWidth="520"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Style="{DynamicResource WindowStyle}">
    <ScrollViewer x:Name="storageScroll" Margin="16" MaxHeight="520"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Width="{Binding ViewportWidth, ElementName=storageScroll}">
            <TextBlock x:Name="headingText" Style="{StaticResource FoundationPageTitleStyle}" TextWrapping="Wrap" />
            <TextBlock x:Name="summaryText" Margin="0,8,0,0" TextWrapping="Wrap"
                       Style="{StaticResource FoundationSecondaryTextStyle}" />
            <TextBlock x:Name="existingDataText" Margin="0,12,0,0" TextWrapping="Wrap"
                       Style="{StaticResource FoundationSecondaryTextStyle}" />
            <Border Style="{StaticResource FoundationPropertyGroupStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <Button x:Name="accountButton" Click="AccountBtn_Click"
                            HorizontalAlignment="Stretch" MinHeight="32"
                            Style="{StaticResource FoundationPrimaryButtonStyle}"
                            ContentTemplate="{StaticResource FoundationWrappedControlCaptionTemplate}"
                            AutomationProperties.HelpText="Store PureDS4 profiles and settings in the AppData folder for this Windows account." />
                    <TextBlock x:Name="accountDescriptionText" Margin="0,8,0,0" TextWrapping="Wrap"
                               Style="{StaticResource FoundationSecondaryTextStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FoundationPropertyGroupStyle}" Margin="0,12,0,0">
                <StackPanel x:Name="portablePanel">
                    <Button x:Name="portableButton" Click="PortableBtn_Click"
                            HorizontalAlignment="Stretch" MinHeight="32"
                            Style="{StaticResource FoundationWrappedButtonStyle}"
                            AutomationProperties.HelpText="Store PureDS4 profiles and settings in the folder that contains PureDS4.exe." />
                    <TextBlock x:Name="portableDescriptionText" Margin="0,8,0,0" TextWrapping="Wrap"
                               Style="{StaticResource FoundationSecondaryTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
