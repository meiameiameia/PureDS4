<Window x:Class="DS4WinWPF.DS4Forms.LogMessageDisplay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
        lex:LocalizeDictionary.DesignCulture=""
        lex:ResxLocalizationProvider.DefaultAssembly="PureDS4"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        mc:Ignorable="d"
        Title="Log message" MinHeight="320" Height="440" Width="640" MinWidth="420"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Style="{DynamicResource WindowStyle}">
    <Grid Margin="16" TextElement.FontWeight="Normal">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Log message" Style="{StaticResource FoundationPageTitleStyle}" />
            <TextBlock Text="Full message from the runtime log." Margin="0,4,0,0"
                       Style="{StaticResource FoundationSecondaryTextStyle}" />
        </StackPanel>
        <RichTextBox Grid.Row="1" x:Name="richMessageBox" IsReadOnly="True" IsDocumentEnabled="True"
                     Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource SurfaceDividerBrush}" BorderThickness="1" Padding="12,8"
                     FontFamily="{StaticResource TypeUiFontFamily}" FontSize="{StaticResource TypeBodySize}"
                     FontWeight="Normal" FocusVisualStyle="{StaticResource FoundationFocusVisualStyle}"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Full log message" />
        <Border Grid.Row="2" Style="{StaticResource FoundationDialogActionsStyle}">
            <Button x:Name="okayButton" Content="OK" MinWidth="88" Click="OkayButton_Click"
                    HorizontalAlignment="Right" Style="{StaticResource FoundationPrimaryButtonStyle}" />
        </Border>
    </Grid>
</Window>
