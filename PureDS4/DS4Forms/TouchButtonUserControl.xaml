<UserControl x:Class="DS4WinWPF.DS4Forms.TouchButtonUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
             mc:Ignorable="d"
             d:DesignHeight="40" d:DesignWidth="400">
    <!-- A property row like the ones on the page that hosts it. -->
    <HeaderedContentControl Header="Button Activation Mode"
                            Style="{StaticResource FoundationPropertyRowControlStyle}">
        <ComboBox x:Name="touchButtonModeCombo" ItemsSource="{Binding TouchButtonModes}"
                  DisplayMemberPath="DisplayName" SelectedValuePath="ChoiceValue"
                  SelectedValue="{Binding CurrentMode}"
                  AutomationProperties.Name="Button activation mode"
                  Style="{StaticResource FoundationPropertyComboStyle}" />
    </HeaderedContentControl>
</UserControl>
