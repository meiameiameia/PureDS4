<UserControl x:Class="DS4WinWPF.DS4Forms.ControllerOverviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
    mc:Ignorable="d" d:DesignHeight="540" d:DesignWidth="1008"
    FontFamily="{StaticResource TypeUiFontFamily}" FontSize="{StaticResource TypeBodySize}"
    Foreground="{DynamicResource TextPrimaryBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <xctk:InverseBoolConverter x:Key="InverseBoolConverter" />
        <Style TargetType="Button" BasedOn="{StaticResource FoundationButtonStyle}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource FoundationComboBoxStyle}" />
        <Style TargetType="Slider" BasedOn="{StaticResource FoundationHorizontalSliderStyle}" />
        <Style TargetType="CheckBox" BasedOn="{StaticResource FoundationCheckBoxStyle}">
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,0,12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Controller details" Style="{StaticResource FoundationPageTitleStyle}" Margin="0,0,0,12" />
        <StackPanel x:Name="emptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelectedController}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="No controller selected" Style="{StaticResource FoundationGroupTitleStyle}" TextAlignment="Center"/>
            <TextBlock Text="Connect a controller, then select it on Home." Margin="0,8,0,12" TextWrapping="Wrap"
                Style="{StaticResource FoundationSecondaryTextStyle}" TextAlignment="Center"/>
            <Button Content="Back to Home" HorizontalAlignment="Center" Click="ControllerDetailsBtn_Click"/>
        </StackPanel>
        <ScrollViewer x:Name="detailsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
            Visibility="{Binding HasSelectedController, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel x:Name="selectedDetails" Margin="0,0,8,8" MaxWidth="960" HorizontalAlignment="Stretch"
                IsEnabled="{Binding HasSelectedController}">
                <Border Style="{StaticResource FoundationPropertyGroupStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="controllerIdentity" Text="{Binding SelectedController.IdText}" ToolTip="{Binding SelectedController.IdText}"
                                TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>
                            <local:StatusChip Grid.Column="1" Label="{Binding SelectedControllerStartupTitle}"
                                Detail="{Binding SelectedControllerStartupDetail}"
                                State="{Binding SelectedControllerStartupStage, Converter={StaticResource ControllerStartupStageVisualState}}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Connection" Margin="0,4,12,4" Style="{StaticResource FoundationSecondaryTextStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedControllerConnection}" Margin="0,4" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="1" Text="Battery" Margin="0,4,12,4" Style="{StaticResource FoundationSecondaryTextStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedControllerBattery}" Margin="0,4" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2" Text="Active profile" Margin="0,4,12,4" Style="{StaticResource FoundationSecondaryTextStyle}"/>
                            <TextBlock x:Name="activeProfileText" Grid.Row="2" Grid.Column="1" Text="{Binding CurrentProfileName}" ToolTip="{Binding CurrentProfileName}" Margin="0,4" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="3" Text="Active game output" Margin="0,4,12,4" Style="{StaticResource FoundationSecondaryTextStyle}"/>
                            <TextBlock x:Name="runtimeOutputText" Grid.Row="3" Grid.Column="1" Text="{Binding SelectedRuntimeOutputControllerName}" Margin="0,4" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="4" Text="Report interval / rate" Margin="0,4,12,4" Style="{StaticResource FoundationSecondaryTextStyle}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedControllerLatency}" Margin="0,4" TextWrapping="Wrap"
                                ToolTip="Observed controller report interval and effective rate; not controller-to-game latency."/>
                        </Grid>
                        <TextBlock x:Name="runtimeDetailText" Text="{Binding SelectedControllerStartupDetail}" Margin="0,8,0,12" TextWrapping="Wrap"
                            Style="{StaticResource FoundationSecondaryTextStyle}"/>
                        <local:ActionGroupPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Edit active profile" Click="EditProfileBtn_Click" Margin="0,0,8,0"/>
                                <Button x:Name="lightbarButton" Content="Lightbar controls" Click="LightbarBtn_Click" Margin="0,0,8,0"
                                    ToolTip="Use profile lightbar controls or choose a custom color"/>
                                <Button Content="Back to Home" Click="ControllerDetailsBtn_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="disconnectButton" Content="Disconnect" Click="DisconnectBtn_Click"
                                    IsEnabled="{Binding SelectedControllerIsWireless}"
                                    Visibility="{Binding SelectedControllerIsWireless, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </local:ActionGroupPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="Profile settings" Style="{StaticResource FoundationGroupTitleStyle}" Margin="0,16,0,4"/>
                <TextBlock Text="Changes below save to the active profile and apply automatically. Active game output above shows the current runtime state."
                    Style="{StaticResource FoundationSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <Border Style="{StaticResource FoundationPropertyGroupStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Game output and feedback" Style="{StaticResource FoundationGroupTitleStyle}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Emulated controller" Target="{Binding ElementName=outputControllerCombo}"/>
                            <ComboBox x:Name="outputControllerCombo" Grid.Column="1"
                                ItemsSource="{Binding OutputControllerChoices}" SelectedValuePath="Type"
                                SelectedValue="{Binding SelectedOutputController, Mode=OneWay}"
                                SelectionChanged="OutputControllerCombo_SelectionChanged"
                                DropDownOpened="OutputControllerCombo_DropDownOpened"
                                DropDownClosed="OutputControllerCombo_DropDownClosed"
                                PreviewKeyDown="OutputControllerCombo_PreviewKeyDown"
                                AutomationProperties.Name="Emulated controller">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <TextBlock Text="Changing this setting saves the profile, then performs one controlled output reload."
                            Style="{StaticResource FoundationSecondaryTextStyle}" TextWrapping="Wrap" Margin="180,4,0,8"/>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="{Binding SelectedController.FeedbackControlLabel}" Target="{Binding ElementName=feedbackSlider}" />
                            <Slider x:Name="feedbackSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1"
                                Value="{Binding HapticStrengthPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=220}" AutomationProperties.Name="{Binding SelectedController.FeedbackControlLabel}" />
                            <TextBlock Grid.Column="2" Text="{Binding HapticStrengthPercent, StringFormat={}{0}%}" VerticalAlignment="Center" TextAlignment="Right" Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FoundationPropertyGroupStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedController.ControllerAudioHeader}" Style="{StaticResource FoundationGroupTitleStyle}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedController.ControllerAudioDescription}" Style="{StaticResource FoundationSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <StackPanel x:Name="audioRoutingControls" IsEnabled="{Binding SelectedControllerSupportsAudio}">
                            <CheckBox Content="Stream audio to controller" IsChecked="{Binding SpeakerOutputEnabled, Mode=TwoWay}"
                                ToolTip="Streams the selected audio to the controller. Uses its built-in speaker unless Headset only routes it exclusively to the AUX port."/>
                            <CheckBox Content="Headset only (mute controller speaker)" IsChecked="{Binding HeadsetOnlyAudio, Mode=TwoWay}"
                                IsEnabled="{Binding SpeakerOutputEnabled}"
                                ToolTip="Mutes the built-in speaker while continuing the stream through a headset connected to the controller's AUX port."/>
                            <Grid Margin="0,8,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Audio source" Target="{Binding ElementName=controllerAudioSourceCombo}"
                                    ToolTip="Default captures the normal endpoint mix. Choose an app to stream only that app."/>
                                <ComboBox x:Name="controllerAudioSourceCombo" Grid.Column="1"
                                    ItemsSource="{Binding ControllerAudioSourceChoices}" SelectedValuePath="EndpointId"
                                    SelectedValue="{Binding ControllerAudioSourceId, Mode=OneWay}"
                                    SelectionChanged="ControllerAudioSourceCombo_SelectionChanged"
                                    DropDownOpened="ControllerAudioSourceCombo_DropDownOpened"
                                    DropDownClosed="ControllerAudioSourceCombo_DropDownClosed"
                                    PreviewKeyDown="ControllerAudioSourceCombo_PreviewKeyDown"
                                    AutomationProperties.Name="Audio source"
                                    ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button x:Name="refreshControllerAudioSourcesButton" Grid.Column="2" Content="Refresh" Margin="8,0,0,0"
                                    AutomationProperties.Name="Refresh audio sources" ToolTip="Refresh running audio sources"
                                    Click="RefreshControllerAudioSources_Click"/>
                            </Grid>
                        </StackPanel>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Controller speaker" Target="{Binding ElementName=speakerSlider}" IsEnabled="{Binding HeadsetOnlyAudio, Converter={StaticResource InverseBoolConverter}}"/>
                            <Slider x:Name="speakerSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1"
                                Value="{Binding SpeakerVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=220}" AutomationProperties.Name="Controller speaker" IsEnabled="{Binding HeadsetOnlyAudio, Converter={StaticResource InverseBoolConverter}}"/>
                            <TextBlock Grid.Column="2" Text="{Binding SpeakerVolumePercent, StringFormat={}{0}%}" VerticalAlignment="Center" TextAlignment="Right" Margin="8,0,0,0" IsEnabled="{Binding HeadsetOnlyAudio, Converter={StaticResource InverseBoolConverter}}"/>
                        </Grid>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Headset / AUX" Target="{Binding ElementName=headphoneSlider}" IsEnabled="{Binding HeadsetOnlyAudio}"/>
                            <Slider x:Name="headphoneSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1"
                                Value="{Binding HeadphoneVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=220}" AutomationProperties.Name="Headset / AUX" IsEnabled="{Binding HeadsetOnlyAudio}"/>
                            <TextBlock Grid.Column="2" Text="{Binding HeadphoneVolumePercent, StringFormat={}{0}%}" VerticalAlignment="Center" TextAlignment="Right" Margin="8,0,0,0" IsEnabled="{Binding HeadsetOnlyAudio}"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Dynamic range" Target="{Binding ElementName=compressionCombo}" ToolTip="Raises quiet detail and safely restrains loud effects without look-ahead latency."/>
                            <ComboBox x:Name="compressionCombo" Grid.Column="1" SelectedIndex="{Binding SpeakerCompressionIndex, Mode=TwoWay}" AutomationProperties.Name="Dynamic range">
                                <ComboBoxItem Content="Off"/>
                                <ComboBoxItem Content="Balanced"/>
                                <ComboBoxItem Content="Strong"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Bass / body" Target="{Binding ElementName=bassSlider}" />
                            <Slider x:Name="bassSlider" Grid.Column="1" Minimum="0" Maximum="6" TickFrequency="1" TickPlacement="BottomRight" IsSnapToTickEnabled="True"
                                Value="{Binding SpeakerBassBoostDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=220}" AutomationProperties.Name="Bass / body" />
                            <TextBlock Grid.Column="2" Text="{Binding SpeakerBassBoostDb, StringFormat={}{0} dB}" VerticalAlignment="Center" TextAlignment="Right" Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FoundationPropertyGroupStyle}">
                    <StackPanel>
                        <TextBlock Text="Microphone" Style="{StaticResource FoundationGroupTitleStyle}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="microphoneToggle" Content="{Binding SelectedController.MicrophoneToggleLabel}"
                            IsChecked="{Binding MicrophoneInputEnabled, Mode=TwoWay}" IsEnabled="{Binding CanChangeMicrophoneInput}"
                            ToolTip="{Binding MicrophoneAvailabilityText}"/>
                        <TextBlock Text="{Binding SelectedController.MicrophoneDescription}" Style="{StaticResource FoundationSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4"/>
                        <TextBlock x:Name="microphoneAvailabilityText" Text="{Binding MicrophoneAvailabilityText}" Style="{StaticResource FoundationSecondaryTextStyle}"
                            TextWrapping="Wrap" Margin="0,4,0,8"
                            Visibility="{Binding ShowMicrophoneAvailabilityMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <StackPanel x:Name="microphoneLevels" IsEnabled="{Binding MicrophoneLevelControlsEnabled}">
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Microphone level" Target="{Binding ElementName=microphoneSlider}" />
                                <Slider x:Name="microphoneSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1"
                                    Value="{Binding MicrophoneVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=220}" AutomationProperties.Name="Microphone level" />
                                <TextBlock Grid.Column="2" Text="{Binding MicrophoneVolumePercent, StringFormat={}{0}%}" VerticalAlignment="Center" TextAlignment="Right" Margin="8,0,0,0" />
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Noise suppression" Target="{Binding ElementName=noiseCombo}"/>
                                <ComboBox x:Name="noiseCombo" Grid.Column="1" SelectedIndex="{Binding MicrophoneNoiseSuppressionIndex, Mode=TwoWay}" AutomationProperties.Name="Noise suppression">
                                    <ComboBoxItem Content="Off"/>
                                    <ComboBoxItem Content="Balanced"/>
                                    <ComboBoxItem Content="Strong"/>
                                    <ComboBoxItem Content="NVIDIA AI" IsEnabled="{Binding NvidiaNoiseSuppressionAvailable}" ToolTip="{Binding NvidiaNoiseSuppressionAvailability}"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
