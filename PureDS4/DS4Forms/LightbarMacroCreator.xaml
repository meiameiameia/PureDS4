<Window x:Class="DS4WinWPF.DS4Forms.LightbarMacroCreator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        lex:LocalizeDictionary.DesignCulture=""
        lex:ResxLocalizationProvider.DefaultAssembly="PureDS4"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        mc:Ignorable="d"
        Style="{DynamicResource WindowStyle}"
        Title="Lightbar macro" Height="520" Width="760"
        MinHeight="420" MinWidth="620" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16" TextElement.FontWeight="Normal">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Lightbar macro" Style="{StaticResource FoundationPageTitleStyle}" />
            <TextBlock Text="Build a timed color sequence, then choose how it is triggered."
                       Style="{StaticResource FoundationSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="230" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Macro sequence" Style="{StaticResource FoundationGroupTitleStyle}" Margin="0,0,0,8" />
                <ListBox Grid.Row="1" x:Name="MacroListBox"
                         Style="{StaticResource FoundationListBoxStyle}"
                         ItemsSource="{Binding LightbarMacro.Macro}"
                         SelectionMode="Single" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel"
                         AutomationProperties.Name="Lightbar macro sequence">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="4,2"
                                       FontFamily="{StaticResource TypeMonoFontFamily}" FontWeight="Normal" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource FoundationPropertyGroupStyle}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button x:Name="addColorBtn" Style="{StaticResource FoundationButtonStyle}" Content="{lex:Loc Add}" Click="AddColor_OnClick" Margin="0,0,8,4" />
                        <Button x:Name="deleteColorBtn" Style="{StaticResource FoundationButtonStyle}" Content="{lex:Loc Delete}" Click="DeleteColor_OnClick" Margin="0,0,8,4" />
                        <Button x:Name="clearColorsBtn" Style="{StaticResource FoundationButtonStyle}" Content="{lex:Loc Clear}" Click="Clear_OnClick" Margin="0,0,0,4" />
                    </WrapPanel>
                    <ScrollViewer x:Name="lightbarMacroOptionsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="New step" Style="{StaticResource FoundationGroupTitleStyle}" />
                            <TextBlock Text="Color and duration" Style="{StaticResource FoundationColumnHeaderStyle}" Margin="0,12,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource FoundationButtonStyle}" Click="SelectColor_Click" Background="{Binding CurrentColorString}"
                                        Height="28" Width="28" Margin="0,0,8,0"
                                        AutomationProperties.Name="Choose lightbar color"
                                        ToolTip="Choose lightbar color" />
                                <xctk:UIntegerUpDown x:Name="intervalUpDown" Style="{StaticResource FoundationNumericInputStyle}" Value="{Binding CurrentInterval}" Width="80" Increment="10"
                                                   AutomationProperties.Name="Step duration in milliseconds" />
                                <TextBlock Text="ms" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>

                            <TextBlock Text="{lex:Loc Trigger}" Style="{StaticResource FoundationColumnHeaderStyle}" Margin="0,16,0,6" />
                            <ComboBox Style="{StaticResource FoundationComboBoxStyle}" x:Name="TriggerCombo" SelectedItem="{Binding LightbarMacro.Trigger}"
                                      HorizontalAlignment="Stretch" AutomationProperties.Name="Macro trigger" />
                            <CheckBox x:Name="cancelCurrentCk" Style="{StaticResource FoundationCheckBoxStyle}" IsChecked="{Binding LightbarMacro.CancelCurrent}"
                                      AutomationProperties.Name="{lex:Loc CancelCurrentMacro}"
                                      ToolTip="{lex:Loc CancelCurrentMacroTooltip}" Margin="0,12,0,0">
                                <TextBlock Text="{lex:Loc CancelCurrentMacro}" TextWrapping="Wrap" />
                            </CheckBox>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource FoundationDialogActionsStyle}">
            <Button x:Name="saveBtn" Content="{lex:Loc Save}" Click="Save_OnClick"
                    HorizontalAlignment="Right" MinWidth="88"
                    IsDefault="True" Style="{StaticResource FoundationPrimaryButtonStyle}" />
        </Border>
    </Grid>
</Window>
