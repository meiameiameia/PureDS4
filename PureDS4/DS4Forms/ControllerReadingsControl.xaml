<UserControl x:Class="DS4WinWPF.DS4Forms.ControllerReadingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:LocalizeDictionary.DesignCulture=""
             lex:ResxLocalizationProvider.DefaultAssembly="PureDS4"
             lex:ResxLocalizationProvider.DefaultDictionary="Strings"
             xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="520"
             Background="{DynamicResource SurfaceBaseBrush}"
             FontWeight="Normal"
             TextElement.FontWeight="Normal"
             TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <UserControl.Resources>
        <local:ReadingBarFillConverter x:Key="ReadingBarFill" />

        <!-- A panel of readings: same surface and separator as the property rows. -->
        <Style x:Key="ReadingPanelStyle" TargetType="Border" BasedOn="{StaticResource FoundationPropertyGroupStyle}">
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style x:Key="ReadingTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource FoundationGroupTitleStyle}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- Live numbers: regular weight, tabular digits, right-aligned in their column. -->
        <Style x:Key="ReadingValueStyle" TargetType="Label">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource TypeUiFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <!-- Keeps neighbouring value columns apart; the numbers are right-aligned. -->
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <Style x:Key="ReadingValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource FoundationBodyTextStyle}">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <Style x:Key="ReadingRowLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FoundationBodyTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,8,3" />
        </Style>

        <Style x:Key="ReadingColumnHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource FoundationColumnHeaderStyle}">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="ReadingStatusStyle" TargetType="Label">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource TypeUiFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <!-- Round input field shared by the sticks and the tilt view (130 DIP, as the code-behind draws). -->
        <Style x:Key="ReadingFieldStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="130" />
            <Setter Property="Height" Value="130" />
            <Setter Property="Fill" Value="{DynamicResource SurfaceInsetBrush}" />
            <Setter Property="Stroke" Value="{DynamicResource BorderDefaultBrush}" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>
        <Style x:Key="ReadingCrossStyle" TargetType="Line">
            <Setter Property="Stroke" Value="{DynamicResource SurfaceDividerBrush}" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>
        <Style x:Key="ReadingDeadZoneStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource SurfaceSelectedBrush}" />
            <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeDashArray" Value="3 2" />
        </Style>
        <Style x:Key="ReadingDriftStyle" TargetType="Ellipse">
            <Setter Property="Stroke" Value="{DynamicResource StateWarningBrush}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="0" />
        </Style>
        <!-- Input: hollow ring. Output: filled accent dot, drawn on top. -->
        <Style x:Key="ReadingInputDotStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="RadiusX" Value="5" />
            <Setter Property="RadiusY" Value="5" />
            <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Canvas.Left" Value="60" />
            <Setter Property="Canvas.Top" Value="60" />
        </Style>
        <Style x:Key="ReadingOutputDotStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="RadiusX" Value="3" />
            <Setter Property="RadiusY" Value="3" />
            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Canvas.Left" Value="62" />
            <Setter Property="Canvas.Top" Value="62" />
        </Style>

        <!-- Read-only bar. The fill runs from zero to the value: from the left end for
             0..255 triggers, from the centre (Tag="Centered") for signed motion values. -->
        <Style x:Key="ReadingBarStyle" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="12">
                            <Border Height="8" CornerRadius="4" Background="{DynamicResource SurfaceInsetBrush}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" />
                            <Border Height="8" CornerRadius="4" Background="{DynamicResource AccentBrush}">
                                <Border.Margin>
                                    <MultiBinding Converter="{StaticResource ReadingBarFill}">
                                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </Border.Margin>
                            </Border>
                            <Rectangle x:Name="originTick" Width="1" HorizontalAlignment="Center"
                                       Fill="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Centered">
                                <Setter TargetName="originTick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="readingsScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
    <!-- Fills the page up to 760 DIP, left-aligned with the page title. -->
    <Grid Margin="0,4,12,12">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="760" />
        <ColumnDefinition Width="0" />
    </Grid.ColumnDefinitions>
    <StackPanel>

        <!-- Shown until the first report arrives, and whenever the controller goes away. -->
        <Border x:Name="readingsEmptyState" Style="{StaticResource ReadingPanelStyle}" Padding="24,32">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource TypeIconFontFamily}" FontSize="28"
                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock Text="No controller connected" Style="{StaticResource FoundationGroupTitleStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Connect a controller to see live readings." Style="{StaticResource FoundationSecondaryTextStyle}"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <StackPanel x:Name="readingsContent" Visibility="Collapsed">
            <!-- Status strip -->
            <Border Style="{StaticResource ReadingPanelStyle}">
                <WrapPanel VerticalAlignment="Center">
                    <Label x:Name="inputContNum" Content="Controller 1" Style="{StaticResource ReadingStatusStyle}" FontWeight="SemiBold" />
                    <Label x:Name="readingsTransportLb" Content="" Style="{StaticResource ReadingStatusStyle}" />
                    <Label x:Name="inputDelayLb" Content="{lex:Loc ReadingsControl.InputDelayNA}" Style="{StaticResource ReadingStatusStyle}"
                           ToolTip="Average time between recent controller reports, not controller-to-game latency."
                           AutomationProperties.HelpText="Average time between recent controller reports, not controller-to-game latency.">
                        <Label.Background>
                            <SolidColorBrush x:Name="inpuDelayBackBrush" Color="Transparent" />
                        </Label.Background>
                        <Label.Foreground>
                            <SolidColorBrush x:Name="inpuDelayForeBrush" Color="Transparent"/>
                        </Label.Foreground>
                    </Label>
                    <Label x:Name="batteryLvlLb" Content="{lex:Loc ReadingsControl.BatteryZero}" Style="{StaticResource ReadingStatusStyle}" />
                </WrapPanel>
            </Border>

            <!-- Sticks -->
            <DockPanel Margin="0,16,0,6" LastChildFill="False">
                <TextBlock Text="Sticks" Style="{StaticResource FoundationColumnHeaderStyle}" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" VerticalAlignment="Center" />
                    <TextBlock Text="Input" Style="{StaticResource FoundationSecondaryTextStyle}" Margin="5,0,14,0" VerticalAlignment="Center" />
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Output" Style="{StaticResource FoundationSecondaryTextStyle}" Margin="5,0,14,0" VerticalAlignment="Center" />
                    <Ellipse Width="10" Height="10" Style="{StaticResource ReadingDeadZoneStyle}" VerticalAlignment="Center" />
                    <TextBlock Text="Dead zone" Style="{StaticResource FoundationSecondaryTextStyle}" Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ReadingPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc LeftStick}" Style="{StaticResource ReadingTitleStyle}" />
                        <Canvas x:Name="lsCanvas" Width="130" Height="130" HorizontalAlignment="Center" ClipToBounds="True">
                            <Ellipse Style="{StaticResource ReadingFieldStyle}" />
                            <Line X1="65" Y1="6" X2="65" Y2="124" Style="{StaticResource ReadingCrossStyle}" />
                            <Line X1="6" Y1="65" X2="124" Y2="65" Style="{StaticResource ReadingCrossStyle}" />
                            <Ellipse x:Name="lsDeadEllipse" Width="0" Height="0" Style="{StaticResource ReadingDeadZoneStyle}" />
                            <Ellipse x:Name="lsDriftEllipse" Style="{StaticResource ReadingDriftStyle}" />
                            <Rectangle x:Name="lsValRec" Style="{StaticResource ReadingInputDotStyle}" />
                            <Rectangle x:Name="lsMapValRec" Style="{StaticResource ReadingOutputDotStyle}" />
                        </Canvas>
                        <Grid Margin="0,10,0,0" MaxWidth="220">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="1" Text="Input" Style="{StaticResource ReadingColumnHeaderStyle}" />
                            <TextBlock Grid.Column="2" Text="Output" Style="{StaticResource ReadingColumnHeaderStyle}" />
                            <TextBlock Grid.Row="1" Text="X" Style="{StaticResource ReadingRowLabelStyle}" />
                            <Label Grid.Row="1" Grid.Column="1" x:Name="lxInValLb" Style="{StaticResource ReadingValueStyle}" />
                            <Label Grid.Row="1" Grid.Column="2" x:Name="lxOutValLb" Style="{StaticResource ReadingValueStyle}" />
                            <TextBlock Grid.Row="2" Text="Y" Style="{StaticResource ReadingRowLabelStyle}" />
                            <Label Grid.Row="2" Grid.Column="1" x:Name="lyInValLb" Style="{StaticResource ReadingValueStyle}" />
                            <Label Grid.Row="2" Grid.Column="2" x:Name="lyOutValLb" Style="{StaticResource ReadingValueStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ReadingPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc RightStick}" Style="{StaticResource ReadingTitleStyle}" />
                        <Canvas x:Name="rsCanvas" Width="130" Height="130" HorizontalAlignment="Center" ClipToBounds="True">
                            <Ellipse Style="{StaticResource ReadingFieldStyle}" />
                            <Line X1="65" Y1="6" X2="65" Y2="124" Style="{StaticResource ReadingCrossStyle}" />
                            <Line X1="6" Y1="65" X2="124" Y2="65" Style="{StaticResource ReadingCrossStyle}" />
                            <Ellipse x:Name="rsDeadEllipse" Width="0" Height="0" Style="{StaticResource ReadingDeadZoneStyle}" />
                            <Ellipse x:Name="rsDriftEllipse" Style="{StaticResource ReadingDriftStyle}" />
                            <Rectangle x:Name="rsValRec" Style="{StaticResource ReadingInputDotStyle}" />
                            <Rectangle x:Name="rsMapValRec" Style="{StaticResource ReadingOutputDotStyle}" />
                        </Canvas>
                        <Grid Margin="0,10,0,0" MaxWidth="220">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="1" Text="Input" Style="{StaticResource ReadingColumnHeaderStyle}" />
                            <TextBlock Grid.Column="2" Text="Output" Style="{StaticResource ReadingColumnHeaderStyle}" />
                            <TextBlock Grid.Row="1" Text="X" Style="{StaticResource ReadingRowLabelStyle}" />
                            <Label Grid.Row="1" Grid.Column="1" x:Name="rxInValLb" Style="{StaticResource ReadingValueStyle}" />
                            <Label Grid.Row="1" Grid.Column="2" x:Name="rxOutValLb" Style="{StaticResource ReadingValueStyle}" />
                            <TextBlock Grid.Row="2" Text="Y" Style="{StaticResource ReadingRowLabelStyle}" />
                            <Label Grid.Row="2" Grid.Column="1" x:Name="ryInValLb" Style="{StaticResource ReadingValueStyle}" />
                            <Label Grid.Row="2" Grid.Column="2" x:Name="ryOutValLb" Style="{StaticResource ReadingValueStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Triggers and touchpad -->
            <TextBlock Text="Triggers and touchpad" Style="{StaticResource FoundationSectionHeadingStyle}" />
            <Border Style="{StaticResource ReadingPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="2" Text="Input" Style="{StaticResource ReadingColumnHeaderStyle}" />
                    <TextBlock Grid.Column="3" Text="Output" Style="{StaticResource ReadingColumnHeaderStyle}" />

                    <Label Grid.Row="1" x:Name="l2ValLb" Content="L2" Style="{StaticResource ReadingValueStyle}" HorizontalContentAlignment="Left" Margin="0,4" />
                    <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="l2DeadColumn" Width="0*" />
                            <ColumnDefinition x:Name="l2LiveColumn" Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="l2Slider" Grid.ColumnSpan="2" Minimum="0" Maximum="255" Value="0" Style="{StaticResource ReadingBarStyle}" />
                        <Border Grid.Column="0" Height="14" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource TextSecondaryBrush}"
                                ToolTip="Dead zone">
                            <Border Height="8" CornerRadius="4,0,0,4" Background="{DynamicResource TextSecondaryBrush}" Opacity="0.35" />
                        </Border>
                        <Border x:Name="l2OutputMarker" Grid.ColumnSpan="2" Width="2" Height="14" HorizontalAlignment="Left" ToolTip="Output">
                            <Border.Background>
                                <SolidColorBrush x:Name="l2ValLbBrush" Color="Transparent" />
                            </Border.Background>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="l2ValLbTrans" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <Label Grid.Row="1" Grid.Column="2" x:Name="l2InValLb" Style="{StaticResource ReadingValueStyle}" />
                    <Label Grid.Row="1" Grid.Column="3" x:Name="l2OutValLb" Style="{StaticResource ReadingValueStyle}" />

                    <Label Grid.Row="2" x:Name="r2ValLb" Content="R2" Style="{StaticResource ReadingValueStyle}" HorizontalContentAlignment="Left" Margin="0,4" />
                    <Grid Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="r2DeadColumn" Width="0*" />
                            <ColumnDefinition x:Name="r2LiveColumn" Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="r2Slider" Grid.ColumnSpan="2" Minimum="0" Maximum="255" Value="0" Style="{StaticResource ReadingBarStyle}" />
                        <Border Grid.Column="0" Height="14" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource TextSecondaryBrush}"
                                ToolTip="Dead zone">
                            <Border Height="8" CornerRadius="4,0,0,4" Background="{DynamicResource TextSecondaryBrush}" Opacity="0.35" />
                        </Border>
                        <Border x:Name="r2OutputMarker" Grid.ColumnSpan="2" Width="2" Height="14" HorizontalAlignment="Left" ToolTip="Output">
                            <Border.Background>
                                <SolidColorBrush x:Name="r2ValLbBrush" Color="Transparent" />
                            </Border.Background>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="r2ValLbTrans" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <Label Grid.Row="2" Grid.Column="2" x:Name="r2InValLb" Style="{StaticResource ReadingValueStyle}" />
                    <Label Grid.Row="2" Grid.Column="3" x:Name="r2OutValLb" Style="{StaticResource ReadingValueStyle}" />

                    <TextBlock Grid.Row="3" Text="Touchpad" Style="{StaticResource ReadingRowLabelStyle}" Margin="0,8,8,0" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <TextBlock Text="X" Style="{StaticResource FoundationSecondaryTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Label x:Name="touchXValLb" Width="48" Style="{StaticResource ReadingValueStyle}" />
                        <TextBlock Text="Y" Style="{StaticResource FoundationSecondaryTextStyle}" VerticalAlignment="Center" Margin="24,0,8,0" />
                        <Label x:Name="touchYValLb" Width="48" Style="{StaticResource ReadingValueStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Motion -->
            <TextBlock Text="Motion" Style="{StaticResource FoundationSectionHeadingStyle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource ReadingPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Text="{lex:Loc Gyro}" Style="{StaticResource ReadingTitleStyle}" Margin="0,0,0,2" />
                        <TextBlock Grid.Column="2" Text="Raw" Style="{StaticResource ReadingColumnHeaderStyle}" VerticalAlignment="Bottom" />
                        <TextBlock Grid.Row="1" Text="{lex:Loc Yaw}" Style="{StaticResource ReadingRowLabelStyle}" />
                        <Slider Grid.Row="1" Grid.Column="1" x:Name="gyroYawSlider" Minimum="-9000" Maximum="9000" Value="0" Tag="Centered" Style="{StaticResource ReadingBarStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="gyroYawValueText" Style="{StaticResource ReadingValueTextStyle}" />
                        <TextBlock Grid.Row="2" Text="{lex:Loc Pitch}" Style="{StaticResource ReadingRowLabelStyle}" />
                        <Slider Grid.Row="2" Grid.Column="1" x:Name="gyroPitchSlider" Minimum="-9000" Maximum="9000" Value="0" Tag="Centered" Style="{StaticResource ReadingBarStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="gyroPitchValueText" Style="{StaticResource ReadingValueTextStyle}" />
                        <TextBlock Grid.Row="3" Text="{lex:Loc Roll}" Style="{StaticResource ReadingRowLabelStyle}" />
                        <Slider Grid.Row="3" Grid.Column="1" x:Name="gyroRollSlider" Minimum="-9000" Maximum="9000" Value="0" Tag="Centered" Style="{StaticResource ReadingBarStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" x:Name="gyroRollValueText" Style="{StaticResource ReadingValueTextStyle}" />

                        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="Accelerometer" Style="{StaticResource ReadingTitleStyle}" Margin="0,10,0,2" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Raw" Style="{StaticResource ReadingColumnHeaderStyle}" VerticalAlignment="Bottom" />
                        <TextBlock Grid.Row="5" Text="X" Style="{StaticResource ReadingRowLabelStyle}" />
                        <Slider Grid.Row="5" Grid.Column="1" x:Name="accelXSlider" Minimum="-128" Maximum="128" Value="0" Tag="Centered" Style="{StaticResource ReadingBarStyle}" />
                        <TextBlock Grid.Row="5" Grid.Column="2" x:Name="accelXValueText" Style="{StaticResource ReadingValueTextStyle}" />
                        <TextBlock Grid.Row="6" Text="Y" Style="{StaticResource ReadingRowLabelStyle}" />
                        <Slider Grid.Row="6" Grid.Column="1" x:Name="accelYSlider" Minimum="-128" Maximum="128" Value="0" Tag="Centered" Style="{StaticResource ReadingBarStyle}" />
                        <TextBlock Grid.Row="6" Grid.Column="2" x:Name="accelYValueText" Style="{StaticResource ReadingValueTextStyle}" />
                        <TextBlock Grid.Row="7" Text="Z" Style="{StaticResource ReadingRowLabelStyle}" />
                        <Slider Grid.Row="7" Grid.Column="1" x:Name="accelZSlider" Minimum="-128" Maximum="128" Value="0" Tag="Centered" Style="{StaticResource ReadingBarStyle}" />
                        <TextBlock Grid.Row="7" Grid.Column="2" x:Name="accelZValueText" Style="{StaticResource ReadingValueTextStyle}" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ReadingPanelStyle}">
                    <StackPanel Width="160">
                        <TextBlock Text="Tilt" Style="{StaticResource ReadingTitleStyle}" ToolTip="{lex:Loc ReadingsControl.SixAxisXText}" />
                        <Canvas x:Name="sixaxisCanvas" Width="130" Height="130" HorizontalAlignment="Center" ClipToBounds="True">
                            <Ellipse Style="{StaticResource ReadingFieldStyle}" />
                            <Line X1="65" Y1="6" X2="65" Y2="124" Style="{StaticResource ReadingCrossStyle}" />
                            <Line X1="6" Y1="65" X2="124" Y2="65" Style="{StaticResource ReadingCrossStyle}" />
                            <Ellipse x:Name="sixAxisDeadEllipse" Width="0" Height="0" Style="{StaticResource ReadingDeadZoneStyle}" />
                            <Rectangle x:Name="sixAxisValRec" Style="{StaticResource ReadingInputDotStyle}" />
                            <Rectangle x:Name="sixAxisMapValRec" Style="{StaticResource ReadingOutputDotStyle}" />
                        </Canvas>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="1" Text="Input" Style="{StaticResource ReadingColumnHeaderStyle}" />
                            <TextBlock Grid.Column="2" Text="Output" Style="{StaticResource ReadingColumnHeaderStyle}" />
                            <TextBlock Grid.Row="1" Text="X" Style="{StaticResource ReadingRowLabelStyle}" />
                            <Label Grid.Row="1" Grid.Column="1" x:Name="sixAxisXInValLb" Style="{StaticResource ReadingValueStyle}" />
                            <Label Grid.Row="1" Grid.Column="2" x:Name="sixAxisXOutValLb" Style="{StaticResource ReadingValueStyle}" />
                            <TextBlock Grid.Row="2" Text="Z" Style="{StaticResource ReadingRowLabelStyle}" />
                            <Label Grid.Row="2" Grid.Column="1" x:Name="sixAxisZInValLb" Style="{StaticResource ReadingValueStyle}" />
                            <Label Grid.Row="2" Grid.Column="2" x:Name="sixAxisZOutValLb" Style="{StaticResource ReadingValueStyle}" />
                        </Grid>
                        <!-- Blinks while the gyro calibrates; the text says so, not only the color. -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                    Visibility="{Binding Visibility, ElementName=gyroCalEllipse}">
                            <Ellipse x:Name="gyroCalEllipse" Width="8" Height="8" Fill="{DynamicResource StateSuccessBrush}"
                                     VerticalAlignment="Center" Visibility="Hidden" />
                            <TextBlock Text="Calibrating gyro" Style="{StaticResource FoundationSecondaryTextStyle}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
