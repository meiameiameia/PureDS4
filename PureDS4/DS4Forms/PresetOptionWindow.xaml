<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
        x:Class="DS4WinWPF.DS4Forms.PresetOptionWindow"
        lex:LocalizeDictionary.DesignCulture=""
        lex:ResxLocalizationProvider.DefaultAssembly="PureDS4"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        mc:Ignorable="d"
        Title="Select Preset" Height="360" Width="600" MinHeight="300" MinWidth="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Padding="0"
        Style="{DynamicResource WindowStyle}" Closed="Window_Closed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <DockPanel Margin="16">
        <TabControl x:Name="screensTabControl" Style="{StaticResource FoundationContentTabsStyle}" BorderBrush="{x:Null}">
            <TabItem x:Name="IntroTab" Header="{lex:Loc Intro}">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource FoundationDialogActionsStyle}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource FoundationButtonStyle}" x:Name="noPresetBtn" Content="No" MinWidth="80" Margin="0,0,8,0" TabIndex="0" Click="NoPresetBtn_Click" />
                            <Button Style="{StaticResource FoundationPrimaryButtonStyle}" x:Name="yesPresetBtn" Content="Yes" MinWidth="80" TabIndex="1" Click="YesPresetBtn_Click" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer x:Name="presetIntroScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc Presets}" Style="{StaticResource FoundationPageTitleStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <TextBlock Text="{lex:Loc PresetIntrotext}" Style="{StaticResource FoundationBodyTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="PresetListTab" Header="{lex:Loc PresetOptWin.PresetMenu}">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource FoundationDialogActionsStyle}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource FoundationButtonStyle}" x:Name="presetCancelBtn" Content="{lex:Loc Cancel}" MinWidth="80" Margin="0,0,8,0" Click="PresetCancelBtn_Click" />
                            <Button Style="{StaticResource FoundationPrimaryButtonStyle}" x:Name="presetApplyBtn" Content="{lex:Loc Apply}" MinWidth="80" Click="PresetApplyBtn_Click" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer x:Name="presetPropertiesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc PresetOptWin.PresetMenu}" Style="{StaticResource FoundationPageTitleStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <Border Style="{StaticResource FoundationPropertyRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Content="{lex:Loc Presets}" Target="{Binding ElementName=presetComboBox}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource FoundationComboBoxStyle}" x:Name="presetComboBox" ItemsSource="{Binding PresetsList, Mode=OneTime}" SelectedIndex="{Binding PresetIndex, FallbackValue=0}" MinWidth="200" Margin="8,0,0,0" AutomationProperties.Name="Preset" ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="outputContStackPanel" Visibility="{Binding PresetDisplayOutputCont, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                <Border Style="{StaticResource FoundationPropertyRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Content="{lex:Loc PresetOptWin.OutputController}" ContentStringFormat="{}{0}:" />
                                        <ComboBox Grid.Column="1" Style="{StaticResource FoundationComboBoxStyle}" ItemsSource="{Binding OutputChoices}" DisplayMemberPath="DisplayName" SelectedValuePath="ChoiceValue" SelectedValue="{Binding ControllerChoice}" Margin="8,0,0,0" Width="160" AutomationProperties.Name="Game output" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <Label Style="{StaticResource FoundationWrappedPropertyLabelStyle}" Content="{lex:Loc Description}" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,4" />
                            <Border Style="{StaticResource FoundationPropertyGroupStyle}" Padding="12">
                                <TextBlock Text="{Binding PresetDescription, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource FoundationBodyTextStyle}" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
