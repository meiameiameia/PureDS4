<UserControl x:Class="DS4WinWPF.DS4Forms.StatusBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
             x:Name="root"
             Focusable="False"
             AutomationProperties.LiveSetting="Polite"
             AutomationProperties.Name="{Binding Title, ElementName=root}">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOpen, ElementName=root}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Border x:Name="BannerBorder"
            Margin="8,8,8,4"
            Background="{DynamicResource SurfaceRaisedBrush}"
            BorderThickness="3,1,1,1"
            CornerRadius="{StaticResource RadiusSmall}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="BorderBrush" Value="{DynamicResource StateNeutralBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompact, ElementName=root}" Value="True">
                        <Setter Property="Padding" Value="10,4" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State, ElementName=root}" Value="{x:Static local:StatusVisualState.Success}">
                        <Setter Property="BorderBrush" Value="{DynamicResource StateSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State, ElementName=root}" Value="{x:Static local:StatusVisualState.Warning}">
                        <Setter Property="BorderBrush" Value="{DynamicResource StateWarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State, ElementName=root}" Value="{x:Static local:StatusVisualState.Error}">
                        <Setter Property="BorderBrush" Value="{DynamicResource StateErrorBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State, ElementName=root}" Value="{x:Static local:StatusVisualState.Recovery}">
                        <Setter Property="BorderBrush" Value="{DynamicResource StateRecoveryBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StateGlyph"
                       Width="20"
                       Margin="0,0,8,0"
                       TextAlignment="Center"
                       FontFamily="{StaticResource TypeUiFontFamily}"
                       FontSize="{StaticResource TypeGroupTitleSize}"
                       FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Top" />
                        <Setter Property="Text" Value="ℹ" />
                        <Setter Property="Foreground" Value="{DynamicResource StateNeutralBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompact, ElementName=root}" Value="True">
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State, ElementName=root}" Value="{x:Static local:StatusVisualState.Success}">
                                <Setter Property="Text" Value="✓" />
                                <Setter Property="Foreground" Value="{DynamicResource StateSuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State, ElementName=root}" Value="{x:Static local:StatusVisualState.Warning}">
                                <Setter Property="Text" Value="⚠" />
                                <Setter Property="Foreground" Value="{DynamicResource StateWarningBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State, ElementName=root}" Value="{x:Static local:StatusVisualState.Error}">
                                <Setter Property="Text" Value="✕" />
                                <Setter Property="Foreground" Value="{DynamicResource StateErrorBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State, ElementName=root}" Value="{x:Static local:StatusVisualState.Recovery}">
                                <Setter Property="Text" Value="↺" />
                                <Setter Property="Foreground" Value="{DynamicResource StateRecoveryBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title, ElementName=root}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource FoundationGroupTitleStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact, ElementName=root}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Message, ElementName=root}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource FoundationSecondaryTextStyle}">
                            <Setter Property="Margin" Value="0,2,8,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact, ElementName=root}" Value="True">
                                    <Setter Property="Margin" Value="0,0,8,0" />
                                    <Setter Property="RenderTransform">
                                        <Setter.Value><TranslateTransform Y="-1" /></Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Content="{Binding ActionLabel, ElementName=root}"
                    Click="ActionButton_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource FoundationButtonStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowAction, ElementName=root}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Column="3"
                    Width="28" Height="28"
                    Margin="6,0,0,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    Content="×"
                    ToolTip="Dismiss"
                    AutomationProperties.Name="Dismiss message"
                    Style="{StaticResource FoundationButtonStyle}"
                    Click="DismissButton_Click" />
        </Grid>
    </Border>
</UserControl>
