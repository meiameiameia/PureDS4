<Window x:Class="DS4WinWPF.DS4Forms.StickCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:LocalizeDictionary.DesignCulture=""
        lex:ResxLocalizationProvider.DefaultAssembly="PureDS4"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Stick calibration" Height="316" Width="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{DynamicResource WindowStyle}">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="headingText" Text="Measure where this stick rests"
                       Style="{StaticResource FoundationPageTitleStyle}" />
            <TextBlock Text="Let go of the stick and put the controller down. PureDS4 watches where the stick settles over many readings, instead of trusting one instant."
                       Margin="0,4,0,0" TextWrapping="Wrap"
                       Style="{StaticResource FoundationSecondaryTextStyle}" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,14,0,0" Padding="12,10"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="RESTING AT" Style="{StaticResource FoundationColumnHeaderStyle}" />
                    <TextBlock x:Name="restingText" Text="—" Margin="0,2,0,0"
                               Style="{StaticResource FoundationBodyTextStyle}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="STEADINESS" Style="{StaticResource FoundationColumnHeaderStyle}" />
                    <TextBlock x:Name="steadinessText" Text="—" Margin="0,2,0,0"
                               Style="{StaticResource FoundationBodyTextStyle}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="READINGS" Style="{StaticResource FoundationColumnHeaderStyle}" />
                    <TextBlock x:Name="readingsText" Text="0" Margin="0,2,0,0"
                               Style="{StaticResource FoundationBodyTextStyle}" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" x:Name="statusText" Margin="0,12,0,0" VerticalAlignment="Top"
                   TextWrapping="Wrap" Style="{StaticResource FoundationBodyTextStyle}"
                   Text="Measuring. Let go of the stick and keep the controller still." />

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Button x:Name="restartButton" Content="Measure again" HorizontalAlignment="Left"
                    MinWidth="110" Click="RestartButton_OnClick"
                    Style="{StaticResource FoundationButtonStyle}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" MinWidth="88" Click="CloseButton_OnClick"
                        Style="{StaticResource FoundationButtonStyle}" />
                <Button x:Name="saveButton" Content="Save" MinWidth="88" Margin="8,0,0,0"
                        IsEnabled="False" Click="SaveButton_OnClick"
                        Style="{StaticResource FoundationPrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
